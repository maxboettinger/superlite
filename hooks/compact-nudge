#!/usr/bin/env bash
# UserPromptSubmit hint: when the main conversation of a session with a run grew past 500k tokens, no auto-compact
# window is active (with one, Claude Code would have compacted already), so emit an additionalContext line asking the
# agent to tell the user how to set one (`/autocompact 400k` or `sl setup`). compact_due.py reads the size from the
# transcript's tail and marks the session, so the hint shows once per session.
# Silent when SUPERLITE_NO_AUTOCOMPACT=1, for a fleet worker or lead (no user reads there), without a run, or when not
# due. Exit 0 always (fail open).

if [ "${SUPERLITE_NO_AUTOCOMPACT:-}" = "1" ]; then
  exit 0
fi
if [ -n "${SUPERLITE_FLEET_WORKER:-}" ]; then
  exit 0
fi

input=""
IFS= read -r -d '' input || true

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
superlite_has_run || exit 0
superlite_tools

line="$(printf '%s' "$input" | "$SL_PY" "$SL_ROOT/skills/subagent-driven-development/scripts/compact_due.py" "$SL_SD" 2>/dev/null)" || exit 0
[ -n "$line" ] || exit 0

esc="$line"
esc="${esc//\\/\\\\}"
esc="${esc//\"/\\\"}"
esc="${esc//$'\r'/}"
esc="${esc//$'\n'/\\n}"
esc="${esc//$'\t'/\\t}"

# Same host test as hooks/session-start.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$esc"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$esc"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$esc"
else
  printf '{"additionalContext":"%s"}\n' "$esc"
fi
exit 0
