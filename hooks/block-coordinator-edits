#!/usr/bin/env bash
# PreToolUse hook (Edit, Write, NotebookEdit, Bash, PowerShell, Agent): guards the COORDINATOR, i.e.
# the main session, whose calls carry no agent_id. Subagent calls always pass. Three rules, in order:
#  1. Protected files, in every state: .superlite/orchestrator.json (changed only by `sl orchestrator`)
#     and .superlite/human-replies.jsonl (written only by hooks/record-human-reply) are never written
#     by the model.
#  2. HUMAN-UNAPPROVED (.superlite/orchestrator.json has mode human and approved false): nothing
#     builds until the human approves the plan. Allowed writes: docs/plans/*.review.md, docs/*/plans/*.review.md and
#     .superlite/** (minus the protected files); Agent calls of superlite:* and general-purpose and
#     sl dispatch/assign/wave0/commit_task/finish/build_prime/run_tests are denied.
#  3. Active run (.superlite/stable.json, prime.md or pool.json exists): project code is not written
#     by the coordinator; allowed targets are docs/plans/**, docs/*/plans/**, SPEC*.md, docs/**/*.md and
#     .superlite/**. `sl orchestrator end` closes the run.
# The .superlite folder is the session's own (hooks/superlite-state.sh): its binding, else the launch
# directory's unless another session owns that one. Interpreter writes are judged by each writer call's own
# target (a literal, Path('...'), a name assigned one, or sys.argv[N] read off the interpreter's command line, directly
# or through one VAR=literal); a writer whose target is unknown blocks. cp/mv/tee into a directory (trailing /, .,
# or an existing one) are judged by <dir>/<basename of the first source>; mv also judges every source.
# Bash/PowerShell write detection is best-effort; when unsure, allow. Sessions without a .superlite
# directory are never touched. Bash builtins only (no external process is spawned: each spawn costs
# ~250 ms on Windows), cheap exits first. Exit 2 blocks (message on stderr); anything else,
# including malformed input, exits 0 (fail open).

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

re_agent='"agent_id"[[:space:]]*:[[:space:]]*"'
[[ $input =~ $re_agent ]] && exit 0   # subagent call
re_tool='"tool_name"[[:space:]]*:[[:space:]]*"([A-Za-z]+)"'
[[ $input =~ $re_tool ]] || exit 0
tool="${BASH_REMATCH[1]}"
case "$tool" in Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell|Agent|Task) ;; *) exit 0 ;; esac

# jstr KEY: first JSON string value for KEY, still JSON-escaped, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  REPLY=""
  [[ $input =~ $re ]] && REPLY="${BASH_REMATCH[1]}"
}

# norm PATH: forward slashes, no duplicate or trailing slashes, C:/x -> /c/x, into NORM.
norm() {
  local p="${1//\\//}" re='^([A-Za-z]):/(.*)$'
  while [[ $p == *//* ]]; do p="${p//\/\//\/}"; done
  [[ $p =~ $re ]] && p="/${BASH_REMATCH[1],,}/${BASH_REMATCH[2]}"
  while [[ $p == */ && $p != / ]]; do p="${p%/}"; done
  NORM="$p"
}

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"; proj="$SL_PROJ"
[ -d "$sd" ] || exit 0

active=0
{ [ -f "$sd/stable.json" ] || [ -f "$sd/prime.md" ] || [ -f "$sd/pool.json" ]; } && active=1
human=0
if [ -f "$sd/orchestrator.json" ]; then
  IFS= read -r -d '' oj < "$sd/orchestrator.json"
  re_human='"mode"[[:space:]]*:[[:space:]]*"human"'
  re_unappr='"approved"[[:space:]]*:[[:space:]]*false'
  [[ $oj =~ $re_human && $oj =~ $re_unappr ]] && human=1
fi
enforce=0
{ [ "$active" = 1 ] || [ "$human" = 1 ]; } && enforce=1

if [ "$tool" = Agent ] || [ "$tool" = Task ]; then
  [ "$human" = 1 ] || exit 0
  jstr subagent_type
  case "$REPLY" in Explore|Plan|claude-code-guide) exit 0 ;; esac
  hit="Agent ${REPLY:-general-purpose}"
fi

norm "$proj"; projn="$NORM"; projl="${projn,,}"

prot=0
# project_code PATH: succeeds when writing PATH is denied (sets prot=1 for protected files).
project_code() {
  local p rel pl
  norm "$1"; p="$NORM"; p="${p%\"}"; p="${p#\"}"; p="${p%\'}"; p="${p#\'}"
  case "$p" in ''|*'$'*|'~'*|/dev/*|-*) return 1 ;; esac
  case "$p" in
    /*) pl="${p,,}"
        case "$pl" in "$projl"/*) rel="${p:$((${#projn}+1))}" ;; *) return 1 ;; esac ;;
    *) rel="${p#./}" ;;
  esac
  case "$rel" in ''|.|..|../*) return 1 ;; esac
  pl="${rel,,}"
  case "$pl" in .superlite/human-replies.jsonl|.superlite/orchestrator.json) prot=1; return 0 ;; esac
  { [ "$human" = 1 ] || [ "$active" = 1 ]; } || return 1
  case "/$rel/" in */../*|*/./*) return 0 ;; esac   # docs/../src/a.py is not under docs/
  if [ "$human" = 1 ]; then
    case "$rel" in docs/plans/*.review.md|docs/*/plans/*.review.md|.superlite/*) return 1 ;; esac
    return 0
  fi
  [ "$active" = 1 ] || return 1
  case "$rel" in
    docs/plans/*|docs/*/plans/*|docs/*.md|SPEC*.md|*/SPEC*.md|.superlite/*) return 1 ;;
  esac
  return 0
}

# writer_target EXPR: the literal path an interpreter writer's target expression names, into TGT (empty if unknown):
# 'p' or "p", Path('p'), or a name assigned only such literals in the command (the first denied one when several;
# unknown when any assignment of the name, or a `for name in`, is not a literal).
writer_target() {
  local e="$1" re rest t a n=0 lit=0 sq="'" dq='"'
  e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
  TGT=""
  re="^(Path\\([[:space:]]*)?[$sq$dq]([^$sq$dq]+)[$sq$dq][[:space:]]*\\)?\$"
  if [[ $e =~ $re ]]; then TGT="${BASH_REMATCH[2]}"; return 0; fi
  re='^(sys\.)?argv\[([0-9]+)\]$'
  if [[ $e =~ $re ]]; then argv_arg "${BASH_REMATCH[2]}"; return 0; fi
  re='^[A-Za-z_][A-Za-z_0-9]*$'
  [[ $e =~ $re ]] || return 0
  re="(^|[^A-Za-z_0-9])for[[:space:]]+$e[[:space:]]+in([^A-Za-z_0-9]|\$)"
  [[ $cmd =~ $re ]] && return 0
  re="(^|[^A-Za-z_0-9.])$e[[:space:]]*=[^=]"
  rest="$cmd"
  while [[ $rest =~ $re ]]; do n=$((n + 1)); rest="${rest#*"${BASH_REMATCH[0]}"}"; done
  re="(^|[^A-Za-z_0-9.])$e[[:space:]]*=[[:space:]]*(Path\\([[:space:]]*)?[$sq$dq]([^$sq$dq]+)[$sq$dq]"
  rest="$cmd"
  while [[ $rest =~ $re ]]; do
    lit=$((lit + 1)); t="${BASH_REMATCH[3]}"; rest="${rest#*"${BASH_REMATCH[0]}"}"
    if [ -z "$TGT" ]; then TGT="$t"; elif project_code "$t"; then TGT="$t"; fi
  done
  re="(^|[^A-Za-z_0-9.])$e[[:space:]]*=[[:space:]]*(sys\\.)?argv\\[([0-9]+)\\]"
  rest="$cmd"
  while [[ $rest =~ $re ]]; do
    t="${BASH_REMATCH[3]}"; rest="${rest#*"${BASH_REMATCH[0]}"}"; a="$TGT"; argv_arg "$t"; t="$TGT"; TGT="$a"
    if [ -z "$t" ]; then n=$((n + 100)); continue; fi
    lit=$((lit + 1))
    if [ -z "$TGT" ]; then TGT="$t"; elif project_code "$t"; then TGT="$t"; fi
  done
  [ "$n" = "$lit" ] || TGT=""
  return 0
}

# argv_arg N: the N-th positional argument (1-based) after the script spec of the first interpreter command, into TGT
# (empty if unknown): flags are dropped, `-c CODE` takes CODE as the spec, a $VAR/"$VAR" token resolves through
# exactly one VAR=literal assignment in the command.
argv_arg() {
  local n="$1" rest tok re v cnt i=0 spec=0 sq="'" dq='"'
  TGT=""
  re='(^|[^[:alnum:]_])(python[0-9.]*|node|ruby|php)[[:space:]]+([^'$'\n'']*)'
  [[ $cmd =~ $re ]] || return 0
  rest="${BASH_REMATCH[3]}"
  [ "$n" -ge 1 ] 2>/dev/null || return 0
  re="^[[:space:]]*($dq[^$dq]*$dq|$sq[^$sq]*$sq|[^[:space:]]+)(.*)\$"
  while [[ $rest =~ $re ]]; do
    tok="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
    case "$tok" in '<'*|'>'*|';'*|'|'*|'&'*) break ;; esac
    if [ "$spec" = 0 ]; then
      case "$tok" in
        -c) [[ $rest =~ $re ]] || return 0; rest="${BASH_REMATCH[2]}"; spec=1 ;;
        -) spec=1 ;;
        -W|-X|-Q) return 0 ;;   # takes a value: the positions would shift
        -*) ;;
        *) spec=1 ;;
      esac
      continue
    fi
    i=$((i + 1))
    if [ "$i" = "$n" ]; then
      tok="${tok%\;}"; tok="${tok#\"}"; tok="${tok%\"}"; tok="${tok#$sq}"; tok="${tok%$sq}"
      re='^\$\{?([A-Za-z_][A-Za-z_0-9]*)\}?$'
      if [[ $tok =~ $re ]]; then
        v="${BASH_REMATCH[1]}"; cnt=0
        re="(^|[^A-Za-z_0-9.])$v[[:space:]]*=[^=]"; rest="$cmd"
        while [[ $rest =~ $re ]]; do cnt=$((cnt + 1)); rest="${rest#*"${BASH_REMATCH[0]}"}"; done
        re="(^|[^A-Za-z_0-9.])$v=($dq[^$dq]+$dq|$sq[^$sq]+$sq|[^[:space:];&|<>$dq$sq]+)"
        if [ "$cnt" = 1 ] && [[ $cmd =~ $re ]]; then
          tok="${BASH_REMATCH[2]}"; tok="${tok#\"}"; tok="${tok%\"}"; tok="${tok#$sq}"; tok="${tok%$sq}"
          case "$tok" in *'$'*) return 0 ;; esac
          TGT="$tok"
        fi
        return 0
      fi
      case "$tok" in *'$'*|'') return 0 ;; esac
      TGT="$tok"; return 0
    fi
  done
  return 0
}

# dir_target TARGET FIRST: into DT, the path judged for a cp/mv/tee target: TARGET/<basename FIRST> when TARGET
# ends with /, is . or is an existing directory, else TARGET itself.
dir_target() {
  local t="$1" b="${2%/}"
  b="${b##*/}"; DT="$t"
  if [[ $t == */ || $t == . || $t == */. || -d $t || ( $t != /* && $t != [A-Za-z]:* && -d "$proj/$t" ) ]]; then DT="${t%/}/${b:-x}"; fi
}

if [ -z "$hit" ] && [ "$tool" != Bash ] && [ "$tool" != PowerShell ]; then
  jstr file_path; f="$REPLY"
  if [ -z "$f" ]; then jstr notebook_path; f="$REPLY"; fi
  [ -n "$f" ] || exit 0
  project_code "$f" && hit="$f"
elif [ -z "$hit" ]; then
  jstr command; cmd="$REPLY"
  [ -n "$cmd" ] || exit 0
  cmd="${cmd//\\\"/\"}"; cmd="${cmd//\\t/ }"; cmd="${cmd//\\r/}"; cmd="${cmd//\\n/$'\n'}"
  lc="${cmd,,}"
  mentions=0
  [[ $lc == *human-replies.jsonl* || $lc == *orchestrator.json* ]] && mentions=1
  # sl tools that start a build are denied until the plan is approved.
  re_sl='(sl|\$SL|\$\{SL\}|scripts/sl)"?[[:space:]]+(dispatch|assign|wave0|commit_task|finish|build_prime|run_tests)([[:space:]]|$)'
  if [ "$human" = 1 ] && [[ $cmd =~ $re_sl ]]; then hit="sl ${BASH_REMATCH[2]}"; fi
  # Inline interpreter writers (checked on the full text, heredoc bodies included), judged by target: the
  # path-like quoted literals in the command are classified like any write; any denied one blocks, and a
  # writer with no path literal at all (a variable target) blocks while the guard is enforcing.
  re_interp='(^|[^[:alnum:]_])(python[0-9.]*|node|ruby|php)([[:space:]]|$)'
  re_writer="open\([^)]*,[[:space:]]*['\"][wax]b?\+?['\"]|\.(write_text|write_bytes)\(|writeFileSync|writeFile\(|appendFile(Sync)?\(|fs\.write"
  if [ -z "$hit" ] && { [ "$enforce" = 1 ] || [ "$mentions" = 1 ]; } && [[ $lc =~ $re_interp && $cmd =~ $re_writer ]]; then
    if [ "$mentions" = 1 ]; then
      hit="${cmd:0:120}"; hit="${hit//$'\n'/ }"; prot=1
    else
      # Each writer call's own target: a literal, Path('...'), or a name assigned one of those in the command.
      # Every open( must read as a plain read or a parsed write; every other writer call must be parsed.
      sq="'"; dq='"'; q="[$sq$dq]"; arg="([^,()]*|Path\([^()]*\))"
      re_open='(^|[^A-Za-z0-9_])open\('
      re_ow="^$arg,[[:space:]]*(mode=)?$q[wax]"
      re_or="^$arg(,[[:space:]]*((mode=)?${q}r[bt]?$q|(encoding|errors|newline|buffering)=[^,()]*))*\)"
      re_mr="^[[:space:]]*(\)|(mode=)?${q}r)"
      re_mw="^[[:space:]]*(mode=)?$q[wax]"
      re_w2="(Path\([^()]*\)|[A-Za-z_][A-Za-z_0-9]*)\.(write_text|write_bytes)\("
      re_w3="(Path\([^()]*\)|[A-Za-z_][A-Za-z_0-9]*)\.open\([[:space:]]*(mode=)?$q[wax]"
      re_w4="(writeFileSync|writeFile|appendFileSync|appendFile)\(([^,()]*),"
      re_other='\.(write_text|write_bytes)\(|writeFileSync\(|writeFile\(|appendFileSync\(|appendFile\(|fs\.write(Sync)?\('
      unknown=0; want=0; got=0
      rest="$cmd"
      while [ -z "$hit" ] && [ "$unknown" = 0 ] && [[ $rest =~ $re_open ]]; do
        prev="${BASH_REMATCH[1]}"; rest="${rest#*"${BASH_REMATCH[0]}"}"
        if [ "$prev" = . ]; then                         # obj.open(...): Path.open, os.open, ...
          if [[ $rest =~ $re_mr ]]; then :; elif [[ $rest =~ $re_mw ]]; then want=$((want + 1)); else unknown=1; fi
        elif [[ $rest =~ $re_ow ]]; then
          writer_target "${BASH_REMATCH[1]}"
          if [ -z "$TGT" ]; then unknown=1; elif project_code "$TGT"; then hit="$TGT"; fi
        elif ! [[ $rest =~ $re_or ]]; then unknown=1
        fi
      done
      rest="$cmd"
      while [[ $rest =~ $re_other ]]; do want=$((want + 1)); rest="${rest#*"${BASH_REMATCH[0]}"}"; done
      for re_w in "$re_w2" "$re_w3" "$re_w4"; do
        rest="$cmd"
        while [ -z "$hit" ] && [ "$unknown" = 0 ] && [[ $rest =~ $re_w ]]; do
          m="${BASH_REMATCH[0]}"
          if [ "$re_w" = "$re_w4" ]; then e="${BASH_REMATCH[2]}"; else e="${BASH_REMATCH[1]}"; fi
          rest="${rest#*"$m"}"; got=$((got + 1))
          writer_target "$e"
          if [ -z "$TGT" ]; then unknown=1; elif project_code "$TGT"; then hit="$TGT"; fi
        done
      done
      # A writer whose target is unknown (a variable, an f-string, a method chain, fs.write on a descriptor) blocks.
      # Out of reach: file APIs without a writer call (os.replace, shutil.copy, ...).
      if [ -z "$hit" ] && { [ "$unknown" = 1 ] || [ "$got" -lt "$want" ]; }; then hit="${cmd:0:120}"; hit="${hit//$'\n'/ }"; fi
    fi
  fi
  if [ -z "$hit" ]; then
    # Drop heredoc bodies and quoted strings, then split into simple commands.
    sq="'"; dq='"'
    re_here="<<-?[[:space:]]*[$sq$dq]?([A-Za-z_][A-Za-z_0-9]*)"
    re_quote="^([^$dq$sq]*)($dq[^$dq]*$dq|$sq[^$sq]*$sq)(.*)\$"
    stripped=""; skip=0; tag=""
    while IFS= read -r line; do
      if [ "$skip" = 1 ]; then
        t="${line#"${line%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
        [ "$t" = "$tag" ] && skip=0
        continue
      fi
      if [[ $line =~ $re_here ]]; then tag="${BASH_REMATCH[1]}"; skip=1; fi
      while [[ $line =~ $re_quote ]]; do line="${BASH_REMATCH[1]}Q${BASH_REMATCH[3]}"; done
      line="${line//&&/$'\n'}"; line="${line//||/$'\n'}"; line="${line//;/$'\n'}"; line="${line//|/$'\n'}"
      stripped="$stripped$line"$'\n'
    done <<< "$cmd"
    re_redir='[0-9]?>>?[[:space:]]*([^[:space:]<>&|;()]+)(.*)$'
    while IFS= read -r seg; do
      case "$seg" in *'$SL'*|*'${SL}'*|*subagent-driven-development/scripts*) continue ;; esac
      rest="$seg"
      while [[ $rest =~ $re_redir ]]; do
        t="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
        project_code "$t" && { hit="> $t"; break; }
      done
      [ -n "$hit" ] && break
      set -f; set -- $seg; set +f
      while [ $# -gt 0 ]; do case "$1" in *=*|sudo|command|env|time) shift ;; *) break ;; esac; done
      [ $# -gt 0 ] || continue
      c="${1##*/}"; c="${c%.exe}"; shift
      args=(); for a in "$@"; do case "$a" in -*) ;; *) args+=("$a") ;; esac; done
      n=${#args[@]}; last=""; [ "$n" -gt 0 ] && last="${args[n-1]}"
      case "$c" in
        patch) [ "$enforce" = 1 ] && hit="patch" ;;
        git) [ "$1" = apply ] && [ "$enforce" = 1 ] && hit="git apply" ;;
        sed) case " $* " in *' -i'*|*' --in-place'*) [ -n "$last" ] && project_code "$last" && hit="sed -i $last" ;; esac ;;
        perl) case " $* " in *' -pi'*|*' -i'*|*' -ni'*) [ -n "$last" ] && project_code "$last" && hit="perl -i $last" ;; esac ;;
        tee) for a in "${args[@]}"; do dir_target "$a" "$a"; project_code "$DT" && { hit="tee $a"; break; }; done ;;
        rm) for a in "${args[@]}"; do project_code "$a" && { hit="$c $a"; break; }; done ;;
        mv) dir_target "$last" "${args[0]}"
            for a in "${args[@]:0:n-1}"; do project_code "$a" && { hit="$c $a"; break; }; done
            [ -z "$hit" ] && project_code "$DT" && hit="mv $last" ;;
        cp) if [ "$n" -gt 1 ]; then dir_target "$last" "${args[0]}"; project_code "$DT" && hit="cp $last"; fi ;;
      esac
      [ -n "$hit" ] && break
    done <<< "$stripped"
  fi
fi

[ -n "$hit" ] || exit 0

hit="${hit:0:120}"; hit="${hit//[\"\\$'\n\r\t']/}"
printf '{"kind":"rule-block","agent":"coordinator","tool":"%s","target":"%s"}\n' "$tool" "$hit" \
  >> "$sd/incidents.jsonl" 2>/dev/null

if [ "$prot" = 1 ]; then
  printf '%s\n' \
    'Blocked: .superlite/orchestrator.json and .superlite/human-replies.jsonl are never written directly. Change the orchestrator state only with `sl orchestrator ...` (for example `sl orchestrator approve --review <path>`); human-replies.jsonl is written only by the hook that records the human'"'"'s replies.' >&2
elif [ "$human" = 1 ]; then
  printf '%s\n' \
    'Human orchestrator: no build starts until the human approves the plan. Write the review plan docs/plans/<date>-<topic>.review.md (see skills/writing-plans/review-plan.md), show its path with a five-line summary, ask the human to reply approve, end your turn, then run sl orchestrator approve --review <path>.' >&2
else
  printf '%s\n' \
    'Blocked: the superlite coordinator must not write project code. Dispatch it instead:' \
    '- Fix: give a fixer a finding id F-<Tn>-<n> and the note path .superlite/fixes/<id>.md, tiered per skills/subagent-driven-development/fixing.md: known cause, one module -> fixer-sonnet; cross-module -> fixer-sonnet-high; unknown cause -> fixer-opus.' \
    '- Wave 0 skeleton/stub/config files belong to an implementer-haiku task.' \
    '- New code belongs to an implementer task. You may write only docs/plans/**, docs/*/plans/**, SPEC*.md, docs/**/*.md and .superlite/**.' \
    '- After the run, `sl orchestrator end` archives the run markers and the guard stops; never delete .superlite by hand.' >&2
fi
exit 2
