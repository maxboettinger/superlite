#!/usr/bin/env bash
# PreToolUse hook (Edit, Write, NotebookEdit, Bash, PowerShell, Agent): guards the COORDINATOR, i.e.
# the main session, whose calls carry no agent_id. Subagent calls always pass. Three rules, in order:
#  1. Protected files, in every state: .superlite/orchestrator.json (changed only by `sl orchestrator`)
#     and .superlite/human-replies.jsonl (written only by hooks/record-human-reply) are never written
#     by the model. An interpreter writer in a command that names one is judged by its targets in every state: a
#     protected or unknown target blocks, and so does a move, copy or link API next to the name when the command also
#     holds a writer call (#122).
#  2. HUMAN-UNAPPROVED (.superlite/orchestrator.json has mode human and approved false): nothing
#     builds until the human approves the plan. Allowed writes: docs/plans/*.review.md, docs/*/plans/*.review.md and
#     .superlite/** (minus the protected files), also inside a linked worktree in the project (judged from its root, whose
#     .git file points into .../worktrees/); Agent calls of superlite:* and general-purpose and
#     sl dispatch/assign/wave0/commit_task/finish/build_prime/run_tests are denied.
#  3. Active run (.superlite/stable.json, prime.md or pool.json exists): project code is not written
#     by the coordinator; allowed targets are docs/plans/**, docs/*/plans/**, SPEC*.md, docs/**/*.md, any docs.md and
#     .superlite/**, in the project or a linked worktree in it. `sl orchestrator end` closes the run.
# The .superlite folder is the session's own (hooks/superlite-state.sh): its binding, else the launch
# directory's unless another session owns that one. Interpreter writes are judged by each writer call's own
# target (a literal, Path('...'), a name assigned one, or sys.argv[N] read off the interpreter's command line, directly
# or through one VAR=literal); a writer whose target is unknown blocks. cp/mv/tee into a directory (trailing /, .,
# or an existing one) are judged by <dir>/<basename of the first source>; mv also judges every source.
# The interpreter scan runs only when the command, with quoted strings and heredoc bodies removed, still runs an
# interpreter, a shell -c or eval wrapper, or a $(interpreter ...) substitution: text that only quotes code is not a call.
# Relative targets are judged from the shell's directory: the JSON cwd when the text holds no cd at all; at each cd when
# every cd is a plain command into the project and the command is one && chain or one leading cd (interpreter writer
# targets then from every directory it visits); for lines of && chains with plain cds into the project, at each command's
# place (case D, d_walk: a sure cd, or `mkdir -p X && cd X`, moves the later lines too; the JSON cwd is the shell's own
# directory, as Claude Code's hooks reference states); else the JSON cwd plus each target when every cd is a readable absolute
# one into the project, or a leading `cd <absolute>` that is the only cd outside quotes, or the project root when that is
# void, plus the cwd and each cd target. Outside the project relative targets are
# not project code (absolute paths into it still are). A body that changes directory is judged from the project root;
# env -C and sudo -D count as a directory change; while the directory is unknown a relative path with .. blocks.
# A writer whose target is unknown but whose root is an absolute path outside the project passes.
# Accepted limits (#64): run time grows quadratically with the number of quoted words (about 1000 of them reach the hook
# timeout, which fails open), and nested quotes inside a $(...) within double quotes are not judged.
# A stdin shell's program (the heredoc body or here-string of a shell with no -c and no script operand, or -s, or
# /dev/stdin; also source /dev/stdin and sudo -s/-i with no command; every heredoc on a line, in order) is judged like a
# -c body, one level deep, and so is env -S STRING; a program piped into a shell (cat <<EOF | sh) or given by process
# substitution (bash <(...)) is out of reach. While the guard enforces, git rewrites of project files block (git_hit:
# apply, am, stash pop|apply|branch, reset --hard|--merge|--keep and forced discards in the project; checkout, restore, rm,
# mv, clean on a project path), and so do tar -x and unzip into project code (archive_hit); branch moves and other
# archivers pass. nohup, timeout, nice and exec are skipped like sudo and env, with their own options.
# Bash/PowerShell write detection is best-effort; when unsure, allow. Sessions without a .superlite
# directory are never touched. Bash builtins only (no external process is spawned: each spawn costs
# ~250 ms on Windows), cheap exits first. Exit 2 blocks (message on stderr); anything else,
# including malformed input, exits 0 (fail open).

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

re_agent='"agent_id"[[:space:]]*:[[:space:]]*"'
[[ $input =~ $re_agent ]] && exit 0   # subagent call
[ -n "${SUPERLITE_FLEET_WORKER:-}" ] && exit 0   # fleet worker session
re_tool='"tool_name"[[:space:]]*:[[:space:]]*"([A-Za-z]+)"'
[[ $input =~ $re_tool ]] || exit 0
tool="${BASH_REMATCH[1]}"
case "$tool" in Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell|Agent|Task) ;; *) exit 0 ;; esac

# jstr KEY: first JSON string value for KEY, still JSON-escaped, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  REPLY=""
  [[ $input =~ $re ]] && REPLY="${BASH_REMATCH[1]}"
}

# norm PATH: forward slashes, no duplicate or trailing slashes, C:/x -> /c/x, into NORM.
norm() {
  local p="${1//\\//}" re='^([A-Za-z]):/(.*)$'
  while [[ $p == *//* ]]; do p="${p//\/\//\/}"; done
  [[ $p =~ $re ]] && { lower "${BASH_REMATCH[1]}"; p="/$LOWER/${BASH_REMATCH[2]}"; }
  while [[ $p == */ && $p != / ]]; do p="${p%/}"; done
  NORM="$p"
}

# lower S: S in lower case (ASCII), into LOWER. bash 3.2 (stock macOS) has no ${var,,}, and a `tr` spawn costs ~250 ms
# on Windows: a string without capitals is returned as is, else one builtin substitution per letter.
lower() {
  local s="$1"
  if [[ $s == *[[:upper:]]* ]]; then
    s="${s//A/a}"; s="${s//B/b}"; s="${s//C/c}"; s="${s//D/d}"; s="${s//E/e}"; s="${s//F/f}"; s="${s//G/g}"
    s="${s//H/h}"; s="${s//I/i}"; s="${s//J/j}"; s="${s//K/k}"; s="${s//L/l}"; s="${s//M/m}"; s="${s//N/n}"
    s="${s//O/o}"; s="${s//P/p}"; s="${s//Q/q}"; s="${s//R/r}"; s="${s//S/s}"; s="${s//T/t}"; s="${s//U/u}"
    s="${s//V/v}"; s="${s//W/w}"; s="${s//X/x}"; s="${s//Y/y}"; s="${s//Z/z}"
  fi
  LOWER="$s"
}

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"; proj="$SL_PROJ"
[ -d "$sd" ] || exit 0

active=0
{ [ -f "$sd/stable.json" ] || [ -f "$sd/prime.md" ] || [ -f "$sd/pool.json" ]; } && active=1
human=0
if [ -f "$sd/orchestrator.json" ]; then
  IFS= read -r -d '' oj < "$sd/orchestrator.json"
  re_human='"mode"[[:space:]]*:[[:space:]]*"human"'
  re_unappr='"approved"[[:space:]]*:[[:space:]]*false'
  [[ $oj =~ $re_human && $oj =~ $re_unappr ]] && human=1
fi
enforce=0
{ [ "$active" = 1 ] || [ "$human" = 1 ]; } && enforce=1

if [ "$tool" = Agent ] || [ "$tool" = Task ]; then
  [ "$human" = 1 ] || exit 0
  jstr subagent_type
  case "$REPLY" in Explore|Plan|claude-code-guide) exit 0 ;; esac
  hit="Agent ${REPLY:-general-purpose}"
fi

norm "$proj"; projn="$NORM"; lower "$projn"; projl="$LOWER"

prot=0
eff_out=0; effn=""; basen=""; basea=""; base_void=0
# dotres PATH: absolute PATH with . and .. segments resolved lexically, into RES.
dotres() {
  local -a st=(); local s n IFS=/
  set -f
  for s in $1; do
    case "$s" in ''|.) ;; ..) n=${#st[@]}; [ "$n" -gt 0 ] && unset "st[$((n - 1))]" ;; *) st[${#st[@]}]="$s" ;; esac
  done
  set +f
  RES="/${st[*]}"
}
# project_code PATH: succeeds when writing PATH is denied (sets prot=1 for protected files). alt_list holds more
# directories the shell may sit in, one per line: PATH is denied when it is denied from the base or from any of them.
alt_list=""
project_code() {
  project_code1 "$1" && return 0
  [ -n "$alt_list" ] || return 1
  local sa="$basea" sb="$basen" so="$eff_out" d r=1
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    basea="$d"; basen=""; eff_out=0
    project_code1 "$1" && { r=0; break; }
  done <<< "$alt_list"
  basea="$sa"; basen="$sb"; eff_out="$so"
  return $r
}
project_code1() {
  local p rel pl v1='$CLAUDE_PROJECT_DIR' v2='${CLAUDE_PROJECT_DIR}'
  norm "${1//$'\x05'/Q}"; p="$NORM"; p="${p%\"}"; p="${p#\"}"; p="${p%\'}"; p="${p#\'}"
  p="${p//$'\x03'/ }"
  case "$p" in *$'\x06'*) [ "$enforce" = 1 ] && return 0; return 1 ;; esac   # an unreadable quoted word: unknown
  p="${p//"$v2"/$projn}"; p="${p//"$v1"/$projn}"
  case "$p" in ''|*'$'*|'~'*|/dev/*|-*) return 1 ;; esac
  if [ "$eff_out" = 1 ]; then   # the shell sits outside the project: a relative path is judged from there
    case "$p" in /*) ;; *) p="$effn/${p#./}" ;; esac
  elif [ -n "$basea" ]; then   # inside, known: judged from the shell's directory
    case "$p" in /*|[A-Za-z]:[/\\]*) ;; *) p="$basea/${p#./}" ;; esac
  elif [ -n "$basen" ]; then   # inside: a path with dots is judged from the directory the cd steps reached
    case "$p" in /*|[A-Za-z]:[/\\]*) ;; *) case "/$p/" in */../*|*/./*) p="$basen/${p#./}" ;; esac ;; esac
  else
    case "$p" in /*|[A-Za-z]:[/\\]*) ;; *)
      # the shell's directory is unknown: a relative path with .. may climb from anywhere into the project
      case "/$p/" in */../*) [ "$base_void" = 1 ] && [ "$enforce" = 1 ] && return 0 ;; esac
      case "/$p/" in */../*|*/./*) p="$projn/${p#./}" ;; esac ;;
    esac
  fi
  case "$p" in   # any absolute path with . or .. segments is judged resolved
    /*) case "$p/" in */../*|*/./*) dotres "$p"; p="$RES" ;; esac ;;
  esac
  case "$p" in
    /*) lower "$p"; pl="$LOWER"
        case "$pl" in "$projl"/*) rel="${p:$((${#projn}+1))}" ;; *) return 1 ;; esac ;;
    *) rel="${p#./}" ;;
  esac
  case "$rel" in ''|.|..|../*) return 1 ;; esac
  lower "$rel"; pl="$LOWER"
  case "$pl" in .superlite/human-replies.jsonl|.superlite/orchestrator.json) prot=1; return 0 ;; esac
  { [ "$human" = 1 ] || [ "$active" = 1 ]; } || return 1
  case "/$rel/" in */../*|*/./*) return 0 ;; esac   # docs/../src/a.py is not under docs/
  allowed_rel "$rel" && return 1
  if wt_rel "$rel"; then   # a linked worktree inside the project: judged from its root
    lower "$WREL"
    case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json) prot=1; return 0 ;; esac
    allowed_rel "$WREL" && return 1
  fi
  return 0
}

# allowed_rel REL: succeeds when the coordinator may write the project-relative REL in the guard's state.
allowed_rel() {
  if [ "$human" = 1 ]; then
    case "$1" in docs/plans/*.review.md|docs/*/plans/*.review.md|.superlite/*) return 0 ;; esac
    return 1
  fi
  case "$1" in docs/plans/*|docs/*/plans/*|docs/*.md|SPEC*.md|*/SPEC*.md|docs.md|*/docs.md|.superlite/*) return 0 ;; esac
  return 1
}

# wt_rel REL: REL below the deepest linked worktree root it lies in (a folder whose .git file points into a
# .../worktrees/<name> folder; a submodule's points into .../modules/...) into WREL; fails when it lies in none.
wt_rel() {
  local r="$1" pre="" line ok=1
  WREL=""
  while [[ $r == */* ]]; do
    pre="${pre:+$pre/}${r%%/*}"; r="${r#*/}"
    [ -f "$projn/$pre/.git" ] || continue
    line=""; IFS= read -r line < "$projn/$pre/.git" || true
    line="${line//\\//}"; line="${line%/}"
    case "$line" in gitdir:*/worktrees/*/*) ;; gitdir:*/worktrees/*) WREL="$r"; ok=0 ;; esac
  done
  return $ok
}

# writer_target EXPR: the literal path an interpreter writer's target expression names, into TGT (empty if unknown):
# 'p' or "p", Path('p'), or a name assigned only such literals in the command (the first denied one when several;
# unknown when any assignment of the name, or a `for name in`, is not a literal).
writer_target() {
  local e="$1" re rest t a n=0 lit=0 sq="'" dq='"' nl=$'\n'
  e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
  TGT=""
  re="^(Path\\([[:space:]]*)?[$sq$dq]([^$sq$dq]+)[$sq$dq][[:space:]]*\\)?\$"
  if [[ $e =~ $re ]]; then TGT="${BASH_REMATCH[2]}"; return 0; fi
  re='^(sys\.)?argv\[([0-9]+)\]$'
  if [[ $e =~ $re ]]; then argv_arg "${BASH_REMATCH[2]}"; return 0; fi
  re='^[A-Za-z_][A-Za-z_0-9]*$'
  [[ $e =~ $re ]] || return 0
  re="(^|[^A-Za-z_0-9])for[[:space:]]+$e[[:space:]]+in([^A-Za-z_0-9]|\$)"
  [[ $cmd =~ $re ]] && return 0
  re="(^|[^A-Za-z_0-9.])$e[[:space:]]*=[^=]"
  rest="$cmd"
  while [[ $rest =~ $re ]]; do n=$((n + 1)); rest="${rest#*"${BASH_REMATCH[0]}"}"; done
  re="(^|[^A-Za-z_0-9.])$e[[:space:]]*=[[:space:]]*(Path\\([[:space:]]*)?[$sq$dq]([^$sq$dq]+)[$sq$dq]\\)?[ "$'\t'"]*([;#]|$nl|\$)"
  rest="$cmd"
  while [[ $rest =~ $re ]]; do
    lit=$((lit + 1)); t="${BASH_REMATCH[3]}"; rest="${rest#*"${BASH_REMATCH[0]}"}"
    if [ -z "$TGT" ]; then TGT="$t"; elif project_code "$t"; then TGT="$t"; fi
  done
  re="(^|[^A-Za-z_0-9.])$e[[:space:]]*=[[:space:]]*(Path\\([[:space:]]*)?(sys\\.)?argv\\[([0-9]+)\\]\\)?[ "$'\t'"]*([;#]|$nl|\$)"
  rest="$cmd"
  while [[ $rest =~ $re ]]; do
    t="${BASH_REMATCH[4]}"; rest="${rest#*"${BASH_REMATCH[0]}"}"; a="$TGT"; argv_arg "$t"; t="$TGT"; TGT="$a"
    if [ -z "$t" ]; then n=$((n + 100)); continue; fi
    lit=$((lit + 1))
    if [ -z "$TGT" ]; then TGT="$t"; elif project_code "$t"; then TGT="$t"; fi
  done
  [ "$n" = "$lit" ] || TGT=""
  return 0
}

# abs_outside PATH: succeeds when PATH is absolute, has no . or .. segment and lies outside the project; NORM is it.
abs_outside() {
  norm "$1"
  case "$NORM" in /*) ;; *) return 1 ;; esac
  case "$NORM/" in */../*|*/./*) return 1 ;; esac
  lower "$NORM"
  case "$LOWER" in "$projl"|"$projl"/*) return 1 ;; esac
  return 0
}

# writer_root EXPR: the root of a writer target expression that writer_target could not read, into TGT (empty if
# unknown): the first string literal or identifier after dropping f, Path(, os.path.join(, ( and {; an identifier
# resolves through writer_target's literal-assignment logic.
writer_root() {
  local e="$1" t re sq="'" dq='"'
  TGT=""
  e="${e#"${e%%[![:space:]]*}"}"
  while :; do
    case "$e" in
      Path\(*) e="${e#Path(}" ;;
      os.path.join\(*) e="${e#os.path.join(}" ;;
      [fF]"$dq"*|[fF]"$sq"*|\(*|\{*|[[:space:]]*) e="${e#?}" ;;
      "$dq"*|"$sq"*)
        t="${e:1}"; t="${t%%[$sq$dq]*}"
        case "$t" in \{*) e="${t:1}"; continue ;; esac
        case "$t" in *\{*) t="${t%%\{*}"; t="${t%/*}/" ;; esac   # a `{` ends the known root, at the last / before it
        TGT="$t"; WR_LIT=1; return 0 ;;
      *) break ;;
    esac
  done
  re='^([A-Za-z_][A-Za-z_0-9]*)([[:space:]/)}+,]|$)'
  [[ $e =~ $re ]] && { WR_ID="${BASH_REMATCH[1]}"; writer_target "$WR_ID"; }
  return 0
}

# rt_parts_ok EXPR: succeeds when no part of a writer target expression after its known root can leave that root: no
# later string literal is absolute, has .. or { or $, and no later part is a name other than the root's own.
rt_parts_ok() {
  local e="$1" first="$WR_LIT" left="" pre q lit sq="'" dq='"' re
  re="^([^$sq$dq]*)([$sq$dq])(.*)\$"
  while [[ $e =~ $re ]]; do
    pre="${BASH_REMATCH[1]}"; q="${BASH_REMATCH[2]}"; e="${BASH_REMATCH[3]}"
    [[ $e == *"$q"* ]] || return 1
    lit="${e%%"$q"*}"; e="${e#*"$q"}"
    pre="${pre%[fFrRbBuU]}"; left="$left$pre"
    if [ "$first" = 1 ]; then first=0; continue; fi
    case "$lit" in /*|[A-Za-z]:*|\\*|*..*|*'{'*|*'$'*) return 1 ;; esac
  done
  left="$left$e"; left="${left//os.path.join/}"; left="${left//Path/}"
  [ -n "$WR_ID" ] && left="${left//"$WR_ID"/}"
  re='[A-Za-z0-9_]'
  [[ $left =~ $re ]] && return 1
  return 0
}

# resolve_target EXPR: writer_target, else writer_root; TGT is the path, or empty with RT_OUT=1 when only the root is
# known and it is an absolute path outside the project with no later part that could leave it.
resolve_target() {
  RT_OUT=0
  writer_target "$1"
  if [ -z "$TGT" ]; then
    WR_LIT=0; WR_ID=""
    writer_root "$1"
    if [ -n "$TGT" ] && abs_outside "$TGT"; then
      case "$projl/" in "${LOWER%/}"/*) ;; *) RT_OUT=1 ;; esac   # an ancestor of the project may hold it: unknown
    fi
    TGT=""
    [ "$RT_OUT" = 1 ] && { rt_parts_ok "$1" || RT_OUT=0; }   # a later absolute or .. part may leave the root
  fi
}

# argv_arg N: the N-th positional argument (1-based) after the script spec of the first interpreter command, into TGT
# (empty if unknown): flags are dropped, `-c CODE` takes CODE as the spec, a $VAR/"$VAR" token resolves through
# exactly one VAR=literal assignment in the command.
argv_arg() {
  local n="$1" rest tok re v cnt i=0 spec=0 sq="'" dq='"'
  TGT=""
  re='(^|[^[:alnum:]_])(python[0-9.]*|node|ruby|php)[[:space:]]+([^'$'\n'']*)'
  [[ $cmd =~ $re ]] || return 0
  rest="${BASH_REMATCH[3]}"
  [ "$n" -ge 1 ] 2>/dev/null || return 0
  re="^[[:space:]]*($dq[^$dq]*$dq|$sq[^$sq]*$sq|[^[:space:]]+)(.*)\$"
  while [[ $rest =~ $re ]]; do
    tok="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
    case "$tok" in '<'*|'>'*|';'*|'|'*|'&'*) break ;; esac
    if [ "$spec" = 0 ]; then
      case "$tok" in
        -c) [[ $rest =~ $re ]] || return 0; rest="${BASH_REMATCH[2]}"; spec=1 ;;
        -) spec=1 ;;
        -W|-X|-Q) return 0 ;;   # takes a value: the positions would shift
        -*) ;;
        *) spec=1 ;;
      esac
      continue
    fi
    i=$((i + 1))
    if [ "$i" = "$n" ]; then
      tok="${tok%\;}"; tok="${tok#\"}"; tok="${tok%\"}"; tok="${tok#$sq}"; tok="${tok%$sq}"
      re='^\$\{?([A-Za-z_][A-Za-z_0-9]*)\}?$'
      if [[ $tok =~ $re ]]; then
        v="${BASH_REMATCH[1]}"; cnt=0
        re="(^|[^A-Za-z_0-9.])$v[[:space:]]*=[^=]"; rest="$cmd"
        while [[ $rest =~ $re ]]; do cnt=$((cnt + 1)); rest="${rest#*"${BASH_REMATCH[0]}"}"; done
        re="(^|[^A-Za-z_0-9.])$v=($dq[^$dq]+$dq|$sq[^$sq]+$sq|[^[:space:];&|<>$dq$sq]+)"
        if [ "$cnt" = 1 ] && [[ $cmd =~ $re ]]; then
          tok="${BASH_REMATCH[2]}"; tok="${tok#\"}"; tok="${tok%\"}"; tok="${tok#$sq}"; tok="${tok%$sq}"
          case "$tok" in *'$'*) return 0 ;; esac
          TGT="$tok"
        fi
        return 0
      fi
      case "$tok" in *'$'*|'') return 0 ;; esac
      TGT="$tok"; return 0
    fi
  done
  return 0
}

# strip_cmd: into `stripped`, $cmd without heredoc bodies and quoted strings, split into simple commands (one per
# line). A double quote opened before a heredoc (body "$(cat <<'EOF' ... EOF)") closes at the first " after the
# heredoc's tag line; the text after it stays.
stripped=""; stripped_done=0
# qflush: the quoted texts found right-to-left in lqn join lq in left-to-right order.
qflush() {
  local i
  if [ "$qltr" = 1 ]; then   # this regex engine matched the leftmost quoted text first: already in order
    for ((i = 0; i < ${#lqn[@]}; i++)); do lq[${#lq[@]}]="${lqn[i]}"; done
  else
    for ((i = ${#lqn[@]} - 1; i >= 0; i--)); do lq[${#lq[@]}]="${lqn[i]}"; done
  fi
  lqn=()
}
# qdecode SEG: SEG with each Q mark replaced by the quoted text it stood for, into QSEG (qi counts marks used): spaces and
# shell operators inside become \x03, a text holding $ (other than $CLAUDE_PROJECT_DIR), a backtick or a newline, and any
# mark without a reliable text, become \x06 (unknown).
qi=0; QRAW=()   # QRAW: the quoted texts of the last qdecode, quotes kept
qdecode() {
  local rest="$1" out="" t tt v1='$CLAUDE_PROJECT_DIR' v2='${CLAUDE_PROJECT_DIR}' sp=$'\x03' c
  while [[ $rest == *Q* ]]; do
    out="$out${rest%%Q*}"; rest="${rest#*Q}"
    t=$'\x06'
    if [ "$qs_ok" = 1 ] && [ "$qi" -lt "${#qs[@]}" ]; then
      t="${qs[qi]}"
      if [ "${#t}" -ge 2 ]; then
        t="${t:1:${#t}-2}"; tt="${t//"$v1"/}"; tt="${tt//"$v2"/}"
        case "$tt" in ''|*'$'*|*'`'*|*$'\n'*|*$'\x06'*) t=$'\x06' ;; esac
      else t=$'\x06'
      fi
    fi
    QRAW[${#QRAW[@]}]=$'\x06'; [ "$qs_ok" = 1 ] && [ "$qi" -lt "${#qs[@]}" ] && QRAW[${#QRAW[@]}-1]="${qs[qi]}"
    qi=$((qi + 1))
    t="${t//[[:space:]]/$sp}"
    for c in '<' '>' '&' '|' ';' '(' ')'; do t="${t//"$c"/$sp}"; done
    out="$out$t"
  done
  QSEG="$out$rest"
}
# emit_line LINE: LINE (quotes already marked) split into simple commands, one per line, onto `stripped`; `>|` is a plain
# redirect, so its | does not split.
emit_line() {
  local line="$1" nl=$'\n' bar=$'\x08'
  line="${line//>|/>$bar}"
  line="${line//&&/$nl}"; line="${line//||/$nl}"; line="${line//;/$nl}"; line="${line//|/$nl}"
  flat="$flat$1$nl"
  stripped="$stripped${line//>$bar/>}$nl"
  qs+=("${lq[@]}"); lq=()
}
strip_cmd() {
  local sq="'" dq='"' line t skip=0 tag="" open="" hq=0 cut=0 re_here re_here2 re_quote atoms text="$cmd" pass=0 hbody="" nl=$'\n'
  local hd_i=0 hm=$'\x0f' hd_k=0 m0 pre after tg fd rest re_fd='(^|[[:space:]])([0-9]+)$'
  local -a hd_tags=() hd_ids=()
  stripped_done=1; stripped=""; flat=""   # judge_body strips its body alone, not appended to the outer command
  hdocs=()   # each heredoc body, by the index its << carries in `stripped` (<<\x0fN\x0f), for stdin_prog
  # a heredoc starts at a << outside quotes that is not part of <<<; a double quote opened before it counts only inside a
  # "$(cat <<'EOF' substitution. re_here's prefix cannot hold a heredoc << (a << inside (( )) or $(( )) is a shift), so
  # it matches the first one on the line; its delimiter is the whole word after it, quotes and backslashes removed.
  atoms="(\\\\.|[^$dq$sq\\\\]|$dq([^$dq\\\\]|\\\\.)*$dq|$sq[^$sq]*$sq)*"
  t="($dq([^$dq\\\\]|\\\\.)*$dq|$sq[^$sq]*$sq)"
  re_here="^((\\\\.|[^$dq$sq\\\\<(]|<<<|<([^<$dq$sq]|$t)|\\(([^($dq$sq<]|$t)|\\(\\(([^()]|\\([^()]*\\))*\\)\\)|$t)*)<<-?[[:space:]]*"
  re_here="$re_here($sq[^$sq]*$sq|$dq[^$dq]*$dq|\\\\.|[^[:space:]$sq$dq\\\\;&|<>()])+"
  re_here2="^($atoms)$dq[^$dq]*\\\$\\([^$dq]*[^<$dq]<<-?[[:space:]]*[$sq$dq]?([A-Za-z_][A-Za-z_0-9]*)"
  re_quote="^((\\\\.|[^$dq$sq\\\\])*)($dq([^$dq\\\\]|\\\\.)*$dq|$sq[^$sq]*$sq)(.*)\$"
  stripped_unsure=0; qs=(); lq=(); lqn=(); qs_ok=0
  # the engine may match the leftmost (macOS) or the rightmost (glibc) quoted text first; probe which
  qltr=0; line='"1" "2"'
  [[ $line =~ $re_quote ]] && [ "${BASH_REMATCH[3]}" = '"1"' ] && qltr=1
  while :; do
  while IFS= read -r line; do
    # A quote left open on the previous line continues on this one.
    # the Q marks of the earlier lines are real; only this line's own Q is a literal (\x0e carries them past the escape)
    [ -n "$open" ] && { line="${open//Q/$'\x0e'} $line"; open=""; }
    if [ "$skip" = 1 ]; then
      t="${line#"${line%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
      if [ "$t" = "$tag" ]; then   # this body ends; the line's next heredoc, if any, starts
        [ -n "${hd_ids[hd_k]}" ] && hdocs[${hd_ids[hd_k]}]="$hbody"
        hbody=""; hd_k=$((hd_k + 1))
        if [ "$hd_k" -lt "${#hd_tags[@]}" ]; then tag="${hd_tags[hd_k]}"; else skip=0; fi
      else hbody="$hbody$line$nl"
      fi
      continue
    fi
    if [ "$hq" = 1 ]; then
      case "$line" in *"$dq"*) line="${line#*"$dq"}"; hq=0 ;; *) continue ;; esac
    fi
    here=0
    if [[ $line =~ $re_here ]]; then
      # mark each << on the line, in order, with the index its body gets (bash reads the bodies in that order); the
      # space splits `bash<<EOF` into its words, an fd prefix (0<<) stays on the operator
      skip=1; here=1; rest="$line"; t=""; hd_tags=(); hd_ids=(); hd_k=0
      while [[ $rest =~ $re_here ]]; do
        m0="${BASH_REMATCH[0]}"; pre="${m0%<<*}"; after="${m0:${#pre}+2}"
        tg="${after#-}"; tg="${tg#"${tg%%[![:space:]]*}"}"; tg="${tg//[$sq$dq\\]/}"
        fd=""; [[ $pre =~ $re_fd ]] && { fd="${BASH_REMATCH[2]}"; pre="${pre%"$fd"}"; }
        hd_i=${#hdocs[@]}; hdocs[hd_i]=""; hd_tags[${#hd_tags[@]}]="$tg"; hd_ids[${#hd_ids[@]}]="$hd_i"
        t="$t$pre $fd<<$hm$hd_i$hm$after"; rest="${rest:${#m0}}"
      done
      line="$t$rest"; tag="${hd_tags[0]}"
    elif [[ $line =~ $re_here2 ]]; then tag="${BASH_REMATCH[4]}"; skip=1; here=1; hd_tags=("$tag"); hd_ids=(""); hd_k=0
    fi
    line="${line//Q/$'\x05'}"; line="${line//$'\x0e'/Q}"   # a literal Q must not read as a quoted-word mark
    if [ "$here" = 1 ]; then
      while [[ $line =~ $re_quote ]]; do lqn[${#lqn[@]}]="${BASH_REMATCH[3]}"; line="${BASH_REMATCH[1]}Q${BASH_REMATCH[5]}"; done
      qflush
      case "$line" in *"$dq"*) hq=1; line="${line%%"$dq"*}Q"; lq[${#lq[@]}]=$'\x06' ;; esac
    fi
    while [[ $line =~ $re_quote ]]; do lqn[${#lqn[@]}]="${BASH_REMATCH[3]}"; line="${BASH_REMATCH[1]}Q${BASH_REMATCH[5]}"; done
    qflush
    # a comment runs from an unquoted # at a word start; a # after a stray quote may still sit inside a string
    # (the quoted texts that sat in the dropped comment leave lq with it)
    cut=0
    case "$line" in
      '#'*) line=""; cut=1 ;;
      *[[:space:]]'#'*) t="${line%%[[:space:]]#*}"; case "$t" in *[$dq$sq]*) ;; *) line="$t"; cut=1 ;; esac ;;
    esac
    if [ "$cut" = 1 ]; then
      here="$line"; t=0
      while [[ $here == *Q* ]]; do t=$((t + 1)); here="${here#*Q}"; done
      while [ "${#lq[@]}" -gt "$t" ]; do unset "lq[${#lq[@]}-1]"; done
    fi
    line="${line//\\\\/B}"; line="${line//\\$sq/E}"; line="${line//\\$dq/E}"   # escaped backslash and quotes are plain text
    case "$line" in *[$dq$sq]*) open="$line"; continue ;; esac
    emit_line "$line"
  done <<< "$text"
  # a quote still open at the end: the line is still judged, as it stands
  if [ -n "$open" ]; then stripped_unsure=1; emit_line "$open"; open=""; fi
  # a heredoc with no terminator: its body may be commands, and is judged as such
  if [ "$skip" = 1 ]; then
    stripped_unsure=1
    if [ "$pass" = 0 ] && [ -n "$hbody" ]; then text="$hbody"; skip=0; pass=1; hq=0; continue; fi
  fi
  break
  done
  here="$stripped"; line=0   # the quoted texts line up with the Q marks only when both counts agree
  while [[ $here == *Q* ]]; do line=$((line + 1)); here="${here#*Q}"; done
  [ "$line" = "${#qs[@]}" ] && qs_ok=1
  [ "$hq" = 1 ] && stripped_unsure=1
}

# scan_gate: succeeds when the stripped command (quotes and heredoc bodies gone) still runs an interpreter, a
# shell -c or eval wrapper, or when the raw text substitutes $(interpreter ...).
scan_gate() {
  local l seg re_shc re_eval re_sub re_qint re_stdin wrap nl=$'\n'
  [ "$stripped_done" = 1 ] || strip_cmd
  [ "$stripped_unsure" = 1 ] && return 0
  lower "$stripped"; l="$LOWER"
  # Same-line wrappers that may sit between a command position and the interpreter.
  wrap='((sudo|env|command|exec|time|nohup|timeout|nice|uv[[:space:]]+run|[A-Za-z_][A-Za-z_0-9]*=[^[:space:]]*|-[^[:space:]]*|[0-9.]+[smhd]?)[[:space:]]+)*'
  # a quoted interpreter name still runs, but only at a command position (not inside a quoted argument)
  re_qint='(^|[;&|(`'"$nl"']|\$\()[[:space:]]*'"$wrap"'["'"'"'](.*/)?(python[0-9.]*|node|ruby|php)["'"'"']'
  re_shc='(^|[^[:alnum:]_])(bash|sh|zsh|ksh|dash)[[:space:]]+(-[-[:alnum:]]+[[:space:]]+([[:alnum:]_]+[[:space:]]+)?)*-[[:alnum:]]*c'
  re_eval='(^|[^[:alnum:]_])eval([[:space:]]|$)'
  re_sub='\$\(([^)]*[;&|])?[[:space:]]*'"$wrap"'([^[:space:])]*/)?(python[0-9.]*|node|ruby|php)([[:space:]]|\))'
  # a shell with no script argument reads its program from stdin (a heredoc, a here-string, a pipe)
  re_stdin='^[[:space:]]*'"$wrap"'([^[:space:]]*/)?(bash|sh|zsh|ksh|dash)([[:space:]]+[-+][-[:alnum:]]*o[[:space:]]+[[:alnum:]_]+|[[:space:]]+[-+][-[:alnum:]]+)*([[:space:]]+[0-9]?[<>]+&?-?[[:space:]]*[^[:space:]]*)*[[:space:]]*$'
  [[ $l =~ $re_interp || $l =~ $re_shc || $l =~ $re_eval || $lc =~ $re_sub || $lc =~ $re_qint ]] && return 0
  while IFS= read -r seg; do
    [[ $seg =~ $re_stdin ]] && return 0
  done <<< "$l"
  return 1
}

aip_base=""
# args_in_proj ARGS...: succeeds when an argument (or the value of -d/-C/--directory=) is a path in the project: an
# absolute one, or a relative one resolved from $aip_base (the outside directory the command runs in; none: skipped).
args_in_proj() {
  local a
  for a in "$@"; do
    a="${a#--directory=}"; a="${a#-d}"; a="${a#-C}"; a="${a%\"}"; a="${a#\"}"
    case "$a" in
      Q|*$'\x06'*) return 0 ;;   # a quoted path, unreadable here
      /*|[A-Za-z]:[/\\]*) ;;
      '') continue ;;
      *) [ -n "$aip_base" ] || continue; a="$aip_base/${a#./}" ;;
    esac
    norm "$a"; a="$NORM"
    case "/$a/" in */../*|*/./*) dotres "$a"; a="$RES" ;; esac
    lower "$a"
    case "$LOWER" in "$projl"|"$projl"/*) return 0 ;; esac
  done
  return 1
}

# dir_target TARGET FIRST: into DT, the path judged for a cp/mv/tee target: TARGET/<basename FIRST> when TARGET
# ends with /, is . or is an existing directory, else TARGET itself.
dir_target() {
  local t="$1" b="${2%/}"
  b="${b##*/}"; DT="$t"
  if [[ $t == */ || $t == . || $t == */. || -d $t || ( $t != /* && $t != [A-Za-z]:* && -d "$proj/$t" ) ]]; then DT="${t%/}/${b:-x}"; fi
}

# and_chain: succeeds when the command, quoted text and heredoc bodies aside, is one line of commands joined only by &&
# (no ; | || &, no !, no second line): a cd in it that fails stops every command after it.
and_chain() {
  local f="${flat%$'\n'}" re='(^|[^>&])&([^&>]|$)'
  case "$f" in *$'\n'*|*';'*|*'|'*|*'!'*) return 1 ;; esac
  [[ $f =~ $re ]] && return 1
  return 0
}

# Case D (#122): the command is lines of && chains (no | || & ! ( ) or backticks, no control words, no source, ., eval,
# alias, enable or trap, also after builtin/command, no line ending in && or \, no CDPATH), every cd the plain command
# word of its own command (cd DIR, redirects aside) into the project. d_walk walks them: the commands after a cd in its
# chain run in its target; after the chain the target is sure only when every command before the cd is read-only (an
# allowlist, plus cd and mkdir -p, none redirected into a file), the cd starts its chain or follows only `mkdir -p`
# calls (no -m) that can succeed, and the folder exists and can be entered or one of them makes it; else the directory
# before the chain stays possible too. d_sets[i] holds the directories (@: the input cwd) the i-th
# simple command (one line of `stripped`) may run in; D_ALL every directory any command may run in.
d_sets=(); D_ALL=""; dmode=0; d_k=0; d0_out=0; d0_a=""
# d_res SET WORD [any]: WORD resolved from each directory of SET (a relative one from @ starts at the input cwd), into
# RS; fails when one lands outside the project, unless `any` is given.
d_res() {
  local c b t out="" nl=$'\n'
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    case "$2" in
      /*|[A-Za-z]:[/\\]*) t="$2" ;;
      *) if [ "$c" != @ ]; then b="$c"; elif [ "$eff_out" = 1 ]; then b="$effn"; else b="${cwd_in:-$projn}"; fi
         t="$b/${2#./}" ;;
    esac
    norm "$t"; t="$NORM"
    case "/$t/" in */../*|*/./*) dotres "$t"; t="$RES" ;; esac
    lower "$t"
    case "$LOWER" in "$projl"|"$projl"/*) ;; *) [ "$3" = any ] || return 1 ;; esac
    out="$out$t$nl"
  done <<< "$1"
  RS="$out"
}
# d_can_mk DIR: succeeds when `mkdir -p DIR` can succeed: DIR is a folder, or nothing is in its way and its nearest
# existing ancestor is a writable folder.
d_can_mk() {
  local a="$1"
  if [ -e "$a" ] || [ -L "$a" ]; then [ -d "$a" ]; return; fi
  while [ -n "$a" ] && ! { [ -e "$a" ] || [ -L "$a" ]; }; do a="${a%/*}"; done
  [ -n "$a" ] || a=/
  [ -d "$a" ] && [ -w "$a" ] && [ -x "$a" ]
}
# d_rdfile TARGET: succeeds when an output redirect to TARGET (the word after > or >&) creates or truncates a file: not
# a descriptor (2>&1, >&-) and not /dev/*.
d_rdfile() {
  local t="${1#&}"
  case "$t" in ''|-|/dev/*) return 1 ;; *[!0-9]*) return 0 ;; esac
  return 1
}
# d_mkdir WORDS...: the words after mkdir; succeeds when they hold -p (or --parents) and only -v besides (no -m: a
# folder without u+x cannot be entered), with the operands in D_OPS.
d_mkdir() {
  local w c opt=1 p=0
  D_OPS=()
  for w in "$@"; do
    if [ "$opt" = 1 ]; then
      case "$w" in
        --) opt=0; continue ;;
        --parents) p=1; continue ;;
        --verbose) continue ;;
        --*) return 1 ;;   # --mode too: a folder without u+x cannot be entered
        -?*) c="${w#-}"
             while [ -n "$c" ]; do
               case "${c:0:1}" in p) p=1 ;; v) ;; *) return 1 ;; esac
               c="${c:1}"
             done
             continue ;;
      esac
    fi
    D_OPS[${#D_OPS[@]}]="$w"
  done
  [ "$p" = 1 ] && [ "${#D_OPS[@]}" -gt 0 ]
}
d_walk() {
  local f="${flat%$'\n'}" t line piece w i n ck=0 ok sure made S A C nl=$'\n' am=$'\x11' all="" prior=1 rd op mk
  local re_op='^[0-9]*(>>?|<<?<?|<>|>&|<&|&>(>)?)$'
  local -a pieces=() seps=() kw=() words=()
  d_sets=(); D_ALL=""
  t="${f//>&/}"; t="${t//&>/}"; t="${t//<&/}"; t="${t//&&/}"
  case "$t" in *'&'*|*'|'*|*'!'*) return 1 ;; esac
  case "$stripped" in *[\(\)\`]*) return 1 ;; esac
  case "$lc" in *cdpath*) return 1 ;; esac   # CDPATH sends a relative cd elsewhere
  if [ -n "${CDPATH:-}" ]; then
    for w in "${cd_words[@]}"; do case "$w" in /*|[A-Za-z]:[/\\]*|./*) ;; *) return 1 ;; esac; done
  fi
  t="$lc"; n=0   # a cd hidden in quoted text or a heredoc body may move the shell anywhere
  while [[ $t =~ $re_cdw ]]; do n=$((n + 1)); t="${BASH_REMATCH[5]}"; done
  [ "$n" = "$cd_n" ] || return 1
  while IFS= read -r line; do
    t="${line%"${line##*[![:space:]]}"}"
    case "$t" in *\\|*'&&') return 1 ;; esac   # the next line joins this chain
    t="${line//;/$nl;}"; t=";${t//&&/$nl$am}"   # \x11, not &: bash 5.2 reads & in a replacement as the match
    while IFS= read -r piece; do seps[${#seps[@]}]="${piece:0:1}"; pieces[${#pieces[@]}]="${piece:1}"; done <<< "$t"
  done <<< "$f"
  t="${stripped//[!$nl]/}"
  [ "${#t}" = "${#pieces[@]}" ] || return 1   # one entry per simple command, as judge_segs reads them
  S="@$nl"; A="$S"; C="$S"; sure=1; made="$nl"
  for ((i = 0; i < ${#pieces[@]}; i++)); do
    if [ "${seps[i]}" = ";" ]; then S="$A"; C="$S"; sure=1; made="$nl"; fi   # a new chain
    d_sets[i]="$C"; all="$all$C"
    set -f; words=(${pieces[i]}); set +f
    kw=(); n=0; rd=0; op=""
    for w in "${words[@]}"; do   # redirects aside; rd: one creates or truncates a file
      if [ "$n" = 1 ]; then n=0; case "$op" in *'>'*) d_rdfile "$w" && rd=1 ;; esac; continue; fi
      if [[ $w =~ $re_op ]]; then n=1; op="$w"; continue; fi
      case "$w" in [0-9\<\>\&]*) ;; *[\<\>]*) return 1 ;; esac   # a word glued to a redirect (rmdir>f) is a command
      case "$w" in
        *'>'*) d_rdfile "${w##*>}" && rd=1; continue ;;
        *'<'*) continue ;;
      esac
      kw[${#kw[@]}]="$w"
    done
    while [ "${#kw[@]}" -gt 0 ]; do   # builtin and command run the word after them (command's own options aside)
      case "${kw[0]}" in
        builtin) kw=("${kw[@]:1}") ;;
        command) kw=("${kw[@]:1}"); while [ "${#kw[@]}" -gt 0 ] && [[ ${kw[0]} == -* ]]; do kw=("${kw[@]:1}"); done ;;
        *) break ;;
      esac
    done
    if [ "${#kw[@]}" = 0 ]; then [ "$rd" = 1 ] && prior=0; continue; fi
    case "${kw[0]}" in   # control flow, and commands that may redefine cd or move the shell unseen
      if|then|else|elif|fi|case|esac|for|select|while|until|do|done|function|'{'|'}') return 1 ;;
      source|.|eval|alias|enable|trap) return 1 ;;
    esac
    if [ "${kw[0]}" = cd ]; then
      [ "${#kw[@]}" = 2 ] || return 1   # cd A B fails
      w="${cd_words[ck]}"; ck=$((ck + 1))
      [ -n "$w" ] || return 1
      d_res "$C" "$w" || return 1
      # sure: the chain reaches it, nothing before it can have removed, locked or blocked the folder, and it can be
      # entered (or a mkdir -p of this chain makes it)
      ok="$sure"; [ "$prior" = 1 ] && [ "$rd" = 0 ] || ok=0
      if [ "$ok" = 1 ]; then
        while IFS= read -r t; do
          [ -n "$t" ] || continue
          [ -d "$t" ] && [ -x "$t" ] && continue
          case "$made" in *"$nl$t$nl"*|*"$nl$t/"*) continue ;; esac
          ok=0; break
        done <<< "$RS"
      fi
      if [ "$ok" = 1 ]; then A="$RS"; else A="$A$RS"; sure=0; fi
      C="$RS"
    elif [ "${kw[0]}" = mkdir ]; then
      mk=1; d_mkdir "${kw[@]:1}" && [ "$rd" = 0 ] || mk=0
      [ "$mk" = 1 ] || prior=0   # mkdir -m, or a redirect, may leave a folder that cannot be entered
      for w in "${D_OPS[@]}"; do   # each operand readable, made from every directory the chain may be in
        [ "$mk" = 1 ] && [ "$sure" = 1 ] || break
        case "$w" in ''|*Q*|*$'\x05'*|*$'\x06'*|*'$'*|*'`'*|'~'*|*[\*\?\[\{]*) mk=0; break ;; esac
        d_res "$C" "$w" any
        while IFS= read -r t; do
          [ -n "$t" ] || continue
          d_can_mk "$t" || { mk=0; break; }
          made="$made$t$nl"
        done <<< "$RS"
      done
      [ "$mk" = 1 ] || sure=0
    else
      sure=0   # a command that may fail stops its chain; only a read-only one leaves later folders as they are
      case "${kw[0]}" in echo|printf|ls|pwd|true|:|cat|head|tail|wc|grep|test|'['|date) ;; *) prior=0 ;; esac
    fi
    [ "$rd" = 1 ] && prior=0   # the file it creates may stand where a later cd or mkdir -p needs a folder
  done
  [ "$ck" = "$cd_n" ] || return 1
  while IFS= read -r t; do
    [ -n "$t" ] && [ "$t" != @ ] && case "$nl$D_ALL" in *"$nl$t$nl"*) ;; *) D_ALL="$D_ALL$t$nl" ;; esac
  done <<< "$all"
  return 0
}
# d_apply SET: the shell's directory for one simple command of case D: @ (the input cwd) first, the others as alt_list.
d_apply() {
  local t first="" rest="" nl=$'\n'
  case "$nl$1" in *"$nl@$nl"*) first=@ ;; esac
  while IFS= read -r t; do
    [ -n "$t" ] && [ "$t" != @ ] || continue
    if [ -z "$first" ]; then first="$t"; else rest="$rest$t$nl"; fi
  done <<< "$1"
  if [ "$first" = @ ]; then eff_out="$d0_out"; basea="$d0_a"; else eff_out=0; basea="$first"; fi
  basen=""; base_void=0; alt_list="$rest"
}

# git_hit ARGS...: ARGS follow the git command word; sets `hit` when they write project files. The subcommand is the
# first word that is not a global option, and the last -C / --work-tree names the directory git runs in (a relative one
# is taken from the outside directory or the shell's known one, else stays in the project). In the project (or when
# that directory is unreadable), while the guard enforces: `git apply`, stash pop|apply|branch and reset
# --hard|--merge|--keep block. checkout, restore, rm, mv and clean block on a project path, judged like any write
# target from that directory (`.`, and clean with no path, stand for the directory itself); index-only and dry-run
# forms (restore --staged, rm --cached, -n) pass. Branch moves (switch, checkout <branch>, merge, rebase, pull) pass.
git_hit() {
  local a gd="" sub="" gd_unknown=0 gd_set=0 inproj=1 dd=0 skipn=0 i n p h wt="" isw
  local -a ops=() paths=()
  [ "$eff_out" = 1 ] && [ -z "$alt_list" ] && gd="$effn"   # a candidate directory in the project: judged as inside
  while [ $# -gt 0 ]; do
    a="$1"; shift; isw=0
    case "$a" in
      -C) [ $# -gt 0 ] || return 1; a="$1"; shift ;;
      --work-tree) [ $# -gt 0 ] || return 1; a="$1"; shift; isw=1 ;;
      -C?*) a="${a#-C}" ;;
      --work-tree=*) a="${a#--work-tree=}"; isw=1 ;;
      -c|--git-dir|--namespace|--super-prefix|--config-env|--exec-path) shift; continue ;;
      -*) continue ;;
      *) sub="$a"; break ;;
    esac
    gd_set=1
    case "$a" in   # -C DIR / --work-tree=DIR
      /*|[A-Za-z]:[/\\]*) gd="$a"; [ "$isw" = 1 ] && wt="$a" ;;
      Q|*$'\x06'*|*'$'*|'~'*|'') gd=""; gd_unknown=1 ;;
      *) if [ -n "$gd" ]; then gd="$gd/${a#./}"
         elif [ -z "$alt_list" ] && [ -n "$basea" ]; then gd="$basea/${a#./}"
         fi ;;
    esac
  done
  [ -n "$sub" ] || return 1
  [ -n "$wt" ] && { gd="$wt"; gd_set=1; gd_unknown=0; }   # an absolute --work-tree wins over any -C
  GW=("$@")
  case "$sub" in clean) GV=e ;; restore) GV=s ;; checkout) GV=bB ;; switch) GV=cC ;; *) GV="" ;; esac
  if [ "$gd_unknown" = 0 ] && [ -n "$gd" ]; then
    if [ "$gd" = "$effn" ]; then inproj=0
    else
      norm "$gd"; gd="$NORM"
      case "/$gd/" in */../*|*/./*) dotres "$gd"; gd="$RES" ;; esac
      abs_outside "$gd" && inproj=0
    fi
  fi
  [ "$gd_unknown" = 1 ] && inproj=1
  for a in "$@"; do   # the operands after the subcommand; -- ends the options
    if [ "$skipn" -gt 0 ]; then skipn=$((skipn - 1)); continue; fi
    if [ "$dd" = 1 ]; then paths[${#paths[@]}]="$a"; continue; fi
    case "$a" in
      --) dd=1 ;;
      -s|--source|-b|-B|--orphan|-e|--exclude|*'<'|*'>'|*'>&'|*'<&') skipn=1 ;;   # an option or redirect and its word
      -*|*'<'*|*'>'*) ;;
      *) ops[${#ops[@]}]="$a" ;;
    esac
  done
  n=${#ops[@]}
  case "$sub" in
    apply|am)
      [ "$enforce" = 1 ] || return 1
      [ "$inproj" = 1 ] && { hit="git $sub"; return 0; }
      [ "$sub" = apply ] || return 0
      aip_base="$gd"; args_in_proj "$@" && hit="git apply"
      return 0 ;;
    stash|reset|switch|checkout-index|read-tree)   # no path: the whole worktree is rewritten
      [ "$enforce" = 1 ] && [ "$inproj" = 1 ] || return 1
      case "$sub" in
        stash) case "${ops[0]}" in pop|apply|branch) hit="git stash ${ops[0]}" ;; esac ;;
        reset) for a in "$@"; do case "$a" in --hard|--merge|--keep) hit="git reset $a"; break ;; esac; done ;;
        switch) { git_flag f force || git_flag '' discard-changes; } && hit="git switch --discard-changes" ;;
        checkout-index) { git_flag f force || git_flag a all; } && hit="git checkout-index" ;;
        read-tree) git_flag u '' && hit="git read-tree -u" ;;
      esac
      return 0 ;;
    checkout|restore|rm|mv|clean) ;;
    *) return 1 ;;
  esac
  git_flag n dry-run && [ "$sub" != restore ] && [ "$sub" != checkout ] && return 1
  case "$sub" in
    restore) git_flag S staged && ! git_flag W worktree && return 1
             paths=("${ops[@]}" "${paths[@]}") ;;
    rm) git_flag '' cached && return 1
        paths=("${ops[@]}" "${paths[@]}") ;;
    mv) paths=("${ops[@]}" "${paths[@]}") ;;
    clean) paths=("${ops[@]}" "${paths[@]}"); [ "${#paths[@]}" = 0 ] && paths=(.) ;;
    checkout)   # without --: <tree-ish> <path>..., or one operand that names an existing path
      git_flag f force && [ "$enforce" = 1 ] && [ "$inproj" = 1 ] && { hit="git checkout -f"; return 0; }
      if [ "$dd" = 0 ]; then
        [ "$n" -ge 2 ] && paths=("${ops[@]:1}")
        [ "$n" -ge 1 ] && git_exists "${ops[0]}" && paths[${#paths[@]}]="${ops[0]}"
      fi
      git_flag p patch && [ "${#paths[@]}" = 0 ] && paths=(.) ;;
  esac
  for a in "$@"; do
    case "$a" in --pathspec-from-file*) [ "$enforce" = 1 ] && hit="git $sub $a"; return 0 ;; esac
  done
  for p in "${paths[@]}"; do
    case "$p" in :*) [ "$enforce" = 1 ] && { hit="git $sub $p"; return 0; }; continue ;; esac   # pathspec magic
    h="$p"   # a folder stands for what lies in it
    case "$p" in .|*/.) p="$p/x" ;; */) p="${p%/}/x" ;; *) git_exists "$p" -d && p="$p/x" ;; esac
    git_path "$p" && { hit="git $sub $h"; return 0; }
  done
  return 0
}

# git_flag SHORT LONG: the git subcommand's words (git_hit's "$@" after the subcommand, in GW) hold --LONG, or -SHORT in
# a cluster of single-letter options, read up to the subcommand's first value letter (GV: clean e, restore s, checkout b
# B, switch c C), whose value is the cluster's rest.
git_flag() {
  local a i ch
  for a in "${GW[@]}"; do
    case "$a" in
      --) return 1 ;;
      "--$2") return 0 ;;
      --*) ;;
      -*) [ -n "$1" ] || continue
          for ((i = 1; i < ${#a}; i++)); do
            ch="${a:i:1}"
            [ "$ch" = "$1" ] && return 0
            case "$GV" in *"$ch"*) break ;; esac
          done ;;
    esac
  done
  return 1
}

# git_exists P [-d]: P (relative to git's directory, or to any directory the shell may be in) names an existing file or
# folder (with -d: a folder), or is `.`.
git_exists() {
  local d o="${2:--e}"
  case "$1" in .|./) return 0 ;; *$'\x06'*|'') return 1 ;; esac
  case "$1" in /*) [ "$o" "$1" ]; return ;; esac
  if [ "$gd_set" = 1 ] && [ -n "$gd" ]; then [ "$o" "$gd/$1" ]; return; fi
  # the shell's directory may be any candidate: the outside base, the known ones, the project root, alt_list
  for d in "$effn" "$basea" "$basen" "$projn"; do [ -n "$d" ] && [ "$o" "$d/$1" ] && return 0; done
  while IFS= read -r d; do [ -n "$d" ] && [ "$o" "$d/$1" ] && return 0; done <<< "$alt_list"
  return 1
}

# git_path P: project_code P, judged from git's directory when -C / --work-tree named a readable one.
git_path() {
  local r sa="$basea" sb="$basen" so="$eff_out" se="$effn" sl="$alt_list"
  { [ "$gd_set" = 1 ] && [ "$gd_unknown" = 0 ] && [ -n "$gd" ]; } || { project_code "$1"; return; }
  if [ "$inproj" = 0 ]; then eff_out=1; effn="$gd"; else eff_out=0; basea="$gd"; fi
  basen=""; alt_list=""
  project_code "$1"; r=$?
  basea="$sa"; basen="$sb"; eff_out="$so"; effn="$se"; alt_list="$sl"
  return $r
}

# archive_hit KIND ARGS...: sets `hit` when tar (-x, --extract, --get, or an old-style first word holding x; not -O,
# --to-stdout) or unzip (not listing, testing or piping: -l -t -v -Z -z -p -c) extracts into project code: the last -C /
# --directory / -d, else the shell's directory, is judged as a write target. Option letters are read like getopt: in a
# dash cluster the first letter that takes a value takes the cluster's rest or the next word; in old-style tar (xCf) each
# takes the next word in turn. Absolute member names (tar -P, unzip -:) block while enforcing.
archive_hit() {
  local k="$1" a x=0 dir="." abs=0 first=1 oq="" ch r i
  shift
  for a in "$@"; do
    if [ -n "$oq" ]; then ch="${oq:0:1}"; oq="${oq:1}"; [ "$ch" = C ] && dir="$a"; first=0; continue; fi   # a value
    r=""
    if [ "$k" = tar ]; then
      case "$a" in
        --extract|--get) x=1 ;;
        --to-stdout) return 1 ;;
        --directory=*|--cd=*) dir="${a#*=}" ;;
        --directory|--cd) oq=C ;;   # --cd: bsdtar's name for -C
        --absolute-names) abs=1 ;;
        --*) ;;
        -?*) r="${a:1}" ;;
        *) [ "$first" = 1 ] && [[ $a != *[!A-Za-z]* ]] && r="$a" ;;   # old style: tar xf
      esac
      for ((i = 0; i < ${#r}; i++)); do
        ch="${r:i:1}"
        case "$ch" in
          x) x=1 ;;
          P) abs=1 ;;
          O) return 1 ;;   # members go to stdout
          [CfTXbKNgVHLF])
            if [ "${a:0:1}" = - ]; then
              if [ $((i + 1)) -lt ${#r} ]; then [ "$ch" = C ] && dir="${r:i+1}"; else oq="$ch"; fi
              break
            fi
            oq="$oq$ch" ;;
        esac
      done
    else
      x=1
      case "$a" in --*) ;; -?*) r="${a:1}" ;; esac
      for ((i = 0; i < ${#r}; i++)); do
        ch="${r:i:1}"
        case "$ch" in
          [ltvZzpc]) return 1 ;;
          :) abs=1 ;;
          d) if [ $((i + 1)) -lt ${#r} ]; then dir="${r:i+1}"; else oq=C; fi; break ;;
          P) [ $((i + 1)) -ge ${#r} ] && oq=P; break ;;   # -P PASSWORD
          x) break ;;   # -x: the member names to leave out follow
        esac
      done
    fi
    first=0
  done
  [ "$x" = 1 ] || return 1
  [ "$abs" = 1 ] && [ "$enforce" = 1 ] && { hit="$k (absolute member names)"; return 0; }
  case "$dir" in */) dir="${dir%/}" ;; esac
  project_code "$dir/x" && hit="$k into $dir"
  return 0
}

# wrap_opt WRAPPER WORD: reads WORD, an option of env or sudo, like getopt (a cluster's first value letter takes the
# cluster's rest or the next word): WO_NEXT=1 when the next word is its value, WO_S=1/2 for env -S with the string in
# this word / the next one, WO_SH=1 for sudo -s / -i (a shell). Value letters: env C u P a; sudo C D g p r t T U u.
wrap_opt() {
  local w="$2" vl i ch
  WO_NEXT=0; WO_S=0; WO_SH=0
  case "$w" in
    --split-string=*) [ "$1" = env ] && WO_S=1; return 0 ;;
    --split-string) [ "$1" = env ] && WO_S=2; return 0 ;;
    --*=*) return 0 ;;
    --chdir|--unset|--argv0|--user|--group|--host|--prompt|--role|--type|--close-from|--other-user|--command-timeout)
      WO_NEXT=1; return 0 ;;
    --shell|--login) [ "$1" = sudo ] && WO_SH=1; return 0 ;;
    --*) return 0 ;;
  esac
  if [ "$1" = env ]; then vl=CuPa; else vl=CDgprtTUu; fi
  for ((i = 1; i < ${#w}; i++)); do
    ch="${w:i:1}"
    if [ "$1" = env ] && [ "$ch" = S ]; then
      if [ $((i + 1)) -lt ${#w} ]; then WO_S=1; else WO_S=2; fi
      return 0
    fi
    [ "$1" = sudo ] && case "$ch" in s|i) WO_SH=1 ;; esac
    case "$vl" in *"$ch"*) [ $((i + 1)) -ge ${#w} ] && WO_NEXT=1; return 0 ;; esac
  done
  return 0
}

# judge_segs: judges each simple command of `stripped` (set by strip_cmd) for writes into project code, setting `hit`.
# `&` ends a command (not in && or a redirect), ( ) and backticks split commands, and a leading keyword is dropped. The
# body of a shell -c and of a $( ) or backtick substitution in double quotes is judged by judge_body, one level deep.
jdepth=0
judge_segs() {
  local seg seg0 rest t c args a n last segs raw b1 b2 inpl skip i nw0 ci w0 tdur envs envatt sush rdr re_redir='[0-9]?>>?[[:space:]]*([^[:space:]<>&|;()]+)(.*)$'
  local -a qr
  local amp=$'\x07' nl=$'\n' and='&'
  segs="${stripped//>&/>$amp}"; segs="${segs//&>/$amp>}"; segs="${segs//<&/<$amp}"
  segs="${segs//&/$nl}"; segs="${segs//$amp/"$and"}"; segs="${segs//[()]/$nl}"; segs="${segs//\`/$nl}"
  while IFS= read -r seg; do
    if [ "$dmode" = 1 ] && [ "$jdepth" = 0 ]; then   # case D: this command's own directories
      if [ "$d_k" -lt "${#d_sets[@]}" ]; then d_apply "${d_sets[d_k]}"
      else eff_out=0; basea=""; basen=""; base_void=1; alt_list="$D_ALL"   # past the walk: unknown, fail closed
      fi
      d_k=$((d_k + 1))
    fi
    seg0="$seg"; QRAW=()
    if [[ $seg == *Q* ]]; then qdecode "$seg"; seg="$QSEG"; fi
    if [ "$jdepth" = 0 ] && [ "${#QRAW[@]}" -gt 0 ]; then   # $( ) and backticks inside double quotes run
      qr=("${QRAW[@]}")
      for raw in "${qr[@]}"; do
        case "$raw" in \"*) ;; *) continue ;; esac
        b1="${raw%\"}"; b1="${b1#\"}"
        b1="${b1//\\\\/B}"; b1="${b1//\\\$/}"; b1="${b1//\\\`/}"; b2="$b1"   # an escaped \` or \$ is text, not a substitution
        while [[ $b1 == *'$('* ]]; do b1="${b1#*'$('}"; judge_body "${b1%%)*}"; [ -n "$hit" ] && return 0; done
        while [[ $b2 == *'`'* ]]; do
          b2="${b2#*'`'}"; judge_body "${b2%%'`'*}"; [ -n "$hit" ] && return 0
          [[ $b2 == *'`'* ]] || break
          b2="${b2#*'`'}"
        done
      done
      QRAW=("${qr[@]}")
    fi
    case "$seg0" in *'$SL'*|*'${SL}'*|*subagent-driven-development/scripts*) continue ;; esac   # the raw segment: a quoted text is no sl call
    rest="$seg"
    while [[ $rest =~ $re_redir ]]; do
      t="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"
      project_code "$t" && { hit="> $t"; break; }
    done
    [ -n "$hit" ] && break
    set -f; set -- $seg; set +f
    nw0=$#
    # a wrapper's own options (env -i, env -C DIR, sudo -u USER, --user=X, nice -n N) are not the command it runs; env -S
    # STRING is the command line it runs, and sudo -s / -i with no command run a shell reading stdin
    w0=""; tdur=0; envs=-1; sush=0
    while [ $# -gt 0 ]; do
      case "$1" in
        -*) case "$w0" in
              env|sudo)
                wrap_opt "$w0" "$1"
                [ "$WO_SH" = 1 ] && sush=1
                if [ "$WO_S" = 1 ]; then envs=$((nw0 - $#)); envatt=1
                elif [ "$WO_S" = 2 ]; then envs=$((nw0 - $# + 1)); envatt=0
                fi
                [ "$WO_NEXT" = 1 ] && shift
                [ $# -gt 0 ] && shift ;;
              nice|exec|timeout) case "$1" in -[nask]|--adjustment|--signal|--kill-after) shift ;; esac
                                 [ $# -gt 0 ] && shift ;;
              command|time|nohup) shift ;;
              *) break ;;
            esac ;;
        *=*|sudo|command|env|time|nohup|nice|exec|then|do|else|elif|if|while|until|'!'|'{') w0="$1"; shift ;;
        timeout) w0="$1"; shift; tdur=1 ;;
        *) [ "$tdur" = 1 ] || break
           tdur=0; shift ;;   # timeout's DURATION
      esac
      [ "$envs" -ge 0 ] && break
    done
    if [ "$envs" -ge 0 ]; then split_body "$seg0" "$envs" "$envatt"; [ -n "$hit" ] && break; continue; fi
    rdr=0; case "$1" in '<'*|'>'*|[0-9]'<'*|[0-9]'>'*) rdr=1 ;; esac   # sudo -s <<EOF: a redirect, no command
    if [ $# = 0 ] || { [ "$sush" = 1 ] && [ "$rdr" = 1 ]; }; then
      [ "$sush" = 1 ] && stdin_prog "$seg0" 0 src
      [ -n "$hit" ] && break
      continue
    fi
    ci=$((nw0 - $#))   # the command word's index among the segment's words
    c="${1##*/}"; c="${c%.exe}"; shift
    args=(); for a in "$@"; do case "$a" in -*|*'>'*|*'<'*) ;; *) args+=("$a") ;; esac; done   # redirects are not operands
    n=${#args[@]}; last=""; [ "$n" -gt 0 ] && last="${args[n-1]}"
    case "$c" in
      sh|bash|zsh|ksh|dash) shell_body "$seg0"; [ -z "$hit" ] && stdin_prog "$seg0" "$ci" ;;
      source|.) case "${args[0]}" in /dev/stdin|/dev/fd/0) stdin_prog "$seg0" "$ci" src ;; esac ;;
      eval) for raw in "${QRAW[@]}"; do   # each quoted word is shell text
              case "$raw" in \"*|\'*) judge_body "${raw:1:${#raw}-2}"; [ -n "$hit" ] && break ;; esac
            done
            [ -z "$hit" ] && eval_body "$seg0" ;;
      patch) aip_base="$effn"; [ "$enforce" = 1 ] && { [ "$eff_out" = 0 ] || [ -n "$alt_list" ] || args_in_proj "$@"; } \
               && hit="patch" ;;
      git) git_hit "$@" ;;
      tar|bsdtar|gtar) archive_hit tar "$@" ;;
      unzip) archive_hit unzip "$@" ;;
      sed|perl) inpl=0; skip=0; hasscr=0   # -i anywhere in a flag cluster; every operand after the script is a file
          for a in "$@"; do
            case "$a" in
              --in-place*) inpl=1 ;;
              --expression=*|--file=*) hasscr=1 ;;
              --expression|--file) skip=$((skip + 1)); hasscr=1 ;;
              --*|-[MmIdDxXwW]*) ;;
              -*) # scan the cluster: i takes the rest as a suffix; e/f (perl: E too) take the rest, or the next word, as the script
                  for ((i = 1; i < ${#a}; i++)); do
                    case "${a:i:1}" in
                      i) inpl=1; break ;;
                      e|f) hasscr=1; [ $((i + 1)) -ge ${#a} ] && skip=$((skip + 1)); break ;;
                      E) [ "$c" = perl ] || continue; hasscr=1; [ $((i + 1)) -ge ${#a} ] && skip=$((skip + 1)); break ;;
                    esac
                  done ;;
            esac
          done
          [ "$hasscr" = 1 ] || skip=1
          [ "$c" = sed ] && [ "$inpl" = 1 ] && sed_empty_suffix "$seg0" && skip=$((skip + 1))   # BSD: -i '' is not an operand
          if [ "$inpl" = 1 ]; then
            for ((i = skip; i < n; i++)); do project_code "${args[i]}" && { hit="$c -i ${args[i]}"; break; }; done
          fi ;;
      tee) for a in "${args[@]}"; do dir_target "$a" "$a"; project_code "$DT" && { hit="tee $a"; break; }; done ;;
      rm) for a in "${args[@]}"; do project_code "$a" && { hit="$c $a"; break; }; done ;;
      mv) dir_target "$last" "${args[0]}"
          for a in "${args[@]:0:n-1}"; do project_code "$a" && { hit="$c $a"; break; }; done
          [ -z "$hit" ] && project_code "$DT" && hit="mv $last" ;;
      cp) if [ "$n" -gt 1 ]; then dir_target "$last" "${args[0]}"; project_code "$DT" && hit="cp $last"; fi ;;
      cd) if [ "$jdepth" = 0 ] && [ "$chain" = 1 ]; then   # case B: the shell moves here
            basea="${chain_dirs[chain_k]}"; basen=""; eff_out=0; chain_k=$((chain_k + 1))
          fi ;;
    esac
    [ -n "$hit" ] && break
  done <<< "$segs"
}

# judge_body TEXT: judges TEXT as a command line of its own (a shell -c body, a substitution), one level deep; a TEXT
# that changes directory is judged from the project root.
judge_body() {
  [ "$jdepth" = 0 ] || return 0
  local sv_cmd="$cmd" sv_str="$stripped" sv_flat="$flat" sv_uns="$stripped_unsure" sv_ok="$qs_ok" sv_qi="$qi"
  local sv_a="$basea" sv_n="$basen" sv_o="$eff_out" sv_v="$base_void" re='(^|[^[:alnum:]_./-])(cd|pushd|popd)([[:space:]]|$)|chdir'
  local -a sv_qs=("${qs[@]}") sv_raw=("${QRAW[@]}") sv_hd=("${hdocs[@]}")
  lower "$1"; [[ $LOWER =~ $re ]] && { basea=""; basen=""; eff_out=0; base_void=1; }   # it moves: judged from the project root
  jdepth=1; cmd="$1"; strip_cmd; qi=0
  judge_segs
  jdepth=0; cmd="$sv_cmd"; stripped="$sv_str"; flat="$sv_flat"; stripped_unsure="$sv_uns"; qs_ok="$sv_ok"; qi="$sv_qi"
  basea="$sv_a"; basen="$sv_n"; eff_out="$sv_o"; base_void="$sv_v"
  qs=("${sv_qs[@]}"); QRAW=("${sv_raw[@]}"); hdocs=("${sv_hd[@]}")
}

# stdin_prog SEG0 CI [src]: the shell at word CI of SEG0 (before qdecode) reads its program from stdin when it has no -c,
# and -s, no script operand, or the script /dev/stdin (with src: `source`/`.` of /dev/stdin): each heredoc body and
# here-string on SEG0 is then judged like a -c body. QRAW holds SEG0's quoted texts.
stdin_prog() {
  local -a w wr; local i k n a m t raw out sflag=0 opt=1 hm=$'\x0f' sv_q
  set -f; wr=($1); set +f
  w=(); for a in "${wr[@]}"; do   # after the shell, a word ending in \ continues with the next (an escaped space)
    k=${#w[@]}
    if [ "$k" -gt $(($2 + 1)) ] && [[ ${w[k-1]} == *\\ ]]; then w[k-1]="${w[k-1]} $a"; else w[k]="$a"; fi
  done
  n=${#w[@]}
  if [ "$3" != src ]; then
    for ((i = $2 + 1; i < n; i++)); do
      a="${w[i]}"
      case "$a" in
        *'<'|*'>'|*'>&'|*'<&'|*"$hm"|*"$hm-") i=$((i + 1)); continue ;;   # an operator alone: its word is the next one
        *'<'*|*'>'*) continue ;;
      esac
      if [ "$opt" = 1 ]; then
        case "$a" in
          --|-) opt=0; continue ;;
          --rcfile|--init-file) i=$((i + 1)); continue ;;
          --*) continue ;;
          -*c*) return 0 ;;   # shell_body judges a -c body
          [-+]*) case "$a" in -*s*) sflag=1 ;; esac
                 case "$a" in [-+]*[oO]) i=$((i + 1)) ;; esac   # -o NAME, +O NAME
                 continue ;;
        esac
      fi
      [ "$sflag" = 1 ] && break   # with -s every operand is an argument
      case "$a" in /dev/stdin|/dev/fd/0) break ;; esac
      return 0   # a script file: stdin is its data
    done
  fi
  t="$1"   # heredoc bodies
  while [[ $t == *"<<$hm"* ]]; do
    t="${t#*"<<$hm"}"; m="${t%%"$hm"*}"; t="${t#*"$hm"}"
    case "$m" in ''|*[!0-9]*) continue ;; esac
    [ "$m" -lt "${#hdocs[@]}" ] && [ -n "${hdocs[m]}" ] && judge_body "${hdocs[m]}"
    [ -n "$hit" ] && return 0
  done
  m=0   # here-strings: the word after <<<, its Q marks read off QRAW
  for ((i = 0; i < n; i++)); do
    a="${w[i]}"
    if [[ $a == *'<<<'* ]]; then
      t="${a%%'<<<'*}"; t="${t//[!Q]/}"; m=$((m + ${#t}))
      a="${a#*'<<<'}"
      if [ -z "$a" ] && [ $((i + 1)) -lt "$n" ]; then i=$((i + 1)); a="${w[i]}"; fi
      WM=$m
      if ! wdecode "$a"; then [ "$enforce" = 1 ] && [ "$jdepth" = 0 ] && hit="<<< (unreadable body)"; return 0; fi
      m=$WM
      [ -n "$WD" ] && judge_body "$WD"
      [ -n "$hit" ] && return 0
      continue
    fi
    t="${a//[!Q]/}"; m=$((m + ${#t}))
  done
}

# sed_empty_suffix SEG0: succeeds when a sed flag cluster ending in i is followed by an empty quoted word (-i ''), the
# macOS spelling of "no backup suffix". QRAW holds SEG0's quoted texts.
sed_empty_suffix() {
  local -a w; local i x t m=0
  set -f; w=($1); set +f
  for ((i = 0; i < ${#w[@]} - 1; i++)); do
    case "${w[i]}" in
      -i|-[nEr]*i) [ "${w[i+1]}" = Q ] || continue
        m=0; for ((x = 0; x <= i; x++)); do t="${w[x]//[!Q]/}"; m=$((m + ${#t})); done
        case "${QRAW[m]}" in "''"|'""') return 0 ;; esac ;;
    esac
  done
  return 1
}

# unesc TEXT: TEXT with each backslash escape undone (\x -> x), into UE.
unesc() {
  local p="$1"
  UE=""
  while [[ $p == *\\* ]]; do UE="$UE${p%%\\*}"; p="${p#*\\}"; UE="$UE${p:0:1}"; p="${p:1}"; done
  UE="$UE$p"
}

# wdecode WORD: WORD (Q marks for quoted texts, read off QRAW from index WM on, which advances) as the shell reads it, into
# WD: quotes removed, the $ of $'...' dropped, backslash escapes in unquoted text undone. Fails on an unreadable quoted text.
wdecode() {
  local w="$1" p raw
  WD=""
  while [[ $w == *Q* ]]; do
    p="${w%%Q*}"; w="${w#*Q}"; raw="${QRAW[WM]}"; WM=$((WM + 1))
    unesc "${p%\$}"; WD="$WD$UE"
    case "$raw" in \"*|\'*) WD="$WD${raw:1:${#raw}-2}" ;; *) return 1 ;; esac
  done
  unesc "$w"; WD="$WD$UE"; WD="${WD//$'\x05'/Q}"
  return 0
}

# split_body SEG0 I ATT: env -S: the words of SEG0 from word I on form the command line env runs (the -S string first;
# with ATT the word still holds its option: -S, a cluster ending in S, or --split-string=), judged like a -c body. QRAW
# holds SEG0's quoted texts.
split_body() {
  local -a w; local i t word body=""
  set -f; w=($1); set +f
  WM=0; for ((i = 0; i < $2 && i < ${#w[@]}; i++)); do t="${w[i]//[!Q]/}"; WM=$((WM + ${#t})); done
  for ((i = $2; i < ${#w[@]}; i++)); do
    word="${w[i]}"
    if [ "$i" = "$2" ] && [ "$3" = 1 ]; then
      case "$word" in --split-string=*) word="${word#--split-string=}" ;; -*) word="${word#*S}" ;; esac
    fi
    if ! wdecode "$word"; then [ "$enforce" = 1 ] && [ "$jdepth" = 0 ] && hit="env -S (unreadable string)"; return 0; fi
    body="$body $WD"
  done
  judge_body "$body"
}

# eval_body SEG0: eval joins its words into one command line: the words after eval (a quoted one without its quotes)
# are judged as such, so unquoted words (eval rm src/a.py) are read too. QRAW holds SEG0's quoted texts.
eval_body() {
  local -a w; local i m=0 x body="" word out raw found=0
  set -f; w=($1); set +f
  for ((i = 0; i < ${#w[@]}; i++)); do
    word="${w[i]}"; out=""
    while [[ $word == *Q* ]]; do
      x="${word%%Q*}"; out="$out${x%\$}"; word="${word#*Q}"; raw="${QRAW[m]}"; m=$((m + 1))   # $'...': the $ goes
      case "$raw" in \"*|\'*) out="$out${raw:1:${#raw}-2}" ;; *) out="$out$raw" ;; esac
    done
    if [ "$found" = 1 ]; then body="$body $out$word"
    else case "${word##*/}" in eval) found=1 ;; esac
    fi
  done
  [ -n "$body" ] && judge_body "$body"
}

# shell_body SEG0: SEG0 (before qdecode) runs a shell with -c: the quoted word after the flag is judged. QRAW holds
# SEG0's quoted texts.
shell_body() {
  local -a w; local i m=0 x raw t
  set -f; w=($1); set +f
  for ((i = 0; i < ${#w[@]} - 1; i++)); do
    case "${w[i]}" in
      -[a-z]*c*|-c) [ "${w[i+1]}" = Q ] || [ "${w[i+1]}" = '$Q' ] || return 0
        for ((x = 0; x <= i; x++)); do t="${w[x]//[!Q]/}"; m=$((m + ${#t})); done
        raw="${QRAW[m]}"
        case "$raw" in
          \"*|\'*) raw="${raw:1:${#raw}-2}"; judge_body "$raw" ;;
          *) [ "$enforce" = 1 ] && [ "$jdepth" = 0 ] && hit="${w[i]} (unreadable body)" ;;   # the quoted texts do not line up: deny
        esac
        return 0 ;;
    esac
  done
}

if [ -z "$hit" ] && [ "$tool" != Bash ] && [ "$tool" != PowerShell ]; then
  jstr file_path; f="$REPLY"
  if [ -z "$f" ]; then jstr notebook_path; f="$REPLY"; fi
  [ -n "$f" ] || exit 0
  project_code "$f" && hit="$f"
elif [ -z "$hit" ]; then
  jstr command; cmd="$REPLY"
  [ -n "$cmd" ] || exit 0
  cmd="${cmd//\\\\/$'\x01'}"   # JSON \\ first, so \\" and \\n keep their shell meaning
  cmd="${cmd//\\\"/\"}"; cmd="${cmd//\\t/ }"; cmd="${cmd//\\r/}"; cmd="${cmd//\\n/$'\n'}"
  cmd="${cmd//$'\x01'/\\}"
  cmd="${cmd//pathlib.Path(/Path(}"   # a module-qualified pathlib.Path( names its target like Path(
  lower "$cmd"; lc="$LOWER"
  # Effective directory, where relative targets are judged from:
  #  A. no cd, pushd, popd or chdir anywhere in the text: the JSON cwd (outside the project: the outside base).
  #  B. every cd is the command word of its own command, reads to a target in the project, and has no twin hidden in
  #     quoted text, with no ( ) or backticks, and the command is one && chain (a failed cd stops it) or one leading cd
  #     to an existing folder: the base moves at each cd (judge_segs walks chain_dirs); interpreter writer targets are
  #     judged from every directory the shell can be in.
  #  D. otherwise, lines of && chains whose every cd is plain and into the project: each command from the directories it
  #     may run in (d_walk, d_apply).
  #  C. anything else: the JSON cwd, overridden by a leading `cd <absolute>` to an existing folder when it is the only cd
  #     outside quotes, moved by plain relative `cd sub` steps for paths with . or .. segments; any other directory
  #     change (a second cd, cd .. / - / ~ / $VAR / -P, pushd, popd, chdir, a cd in a pipe or sent to the background)
  #     voids the base to the project root. Inside the project, the cwd and every absolute cd target are judged too.
  jstr cwd; cwd_in=""; walked_in=0; chain=0; chain_dirs=(); chain_k=0; scan_alt=""; segs_alt=""; nl=$'\n'
  if [ -n "$REPLY" ]; then
    if abs_outside "$REPLY"; then eff_out=1; effn="$NORM"
    else norm "$REPLY"; case "$NORM" in /*) case "/$NORM/" in */../*|*/./*) ;; *) [ -d "$NORM" ] && cwd_in="$NORM" ;; esac ;; esac
    fi
  fi
  sq="'"; dq='"'
  re_cd="^[[:space:]]*cd[[:space:]]+($dq([^$dq]+)$dq|$sq([^$sq]+)$sq|([^[:space:];&|<>()$dq$sq]+))"
  cd_n=0; cd_abs=0; cd_bad=0; cd_rels=(); cd_pos=1; cd_words=()
  if [[ $lc == *cd* || $lc == *pushd* || $lc == *popd* || $lc == *chdir* ]]; then
    [ "$stripped_done" = 1 ] || strip_cmd
    [[ $lc == *chdir* ]] && cd_bad=1
    re_cdw='(^|[^[:alnum:]_./-])(cd|pushd|popd)([[:space:]]+([^[:space:]]*))?(.*)$'
    qn=0; v1='$CLAUDE_PROJECT_DIR'; v2='${CLAUDE_PROJECT_DIR}'   # qn: Q marks before the current one (qs index)
    while IFS= read -r seg; do
      first=1
      while [[ $seg =~ $re_cdw ]]; do
        t="${seg%"${BASH_REMATCH[0]}"}${BASH_REMATCH[1]}"
        { [ "$first" = 1 ] && [ -z "${t//[[:space:]]/}" ]; } || cd_pos=0   # not the command word of its command
        first=0; t="${t//[!Q]/}"; qn=$((qn + ${#t}))
        seg="${BASH_REMATCH[5]}"; t="${BASH_REMATCH[4]}"; cd_n=$((cd_n + 1)); w=""
        t="${t//"$v2"/$projn}"; t="${t//"$v1"/$projn}"
        if [ "${BASH_REMATCH[2]}" != cd ] || [ -z "$t" ] || [ "$t" = - ]; then cd_bad=1
        else
          case "$t" in *'$'*|*'~'*|*'`'*|-*) cd_bad=1 ;; esac
          case "/$t/" in */../*) cd_bad=1 ;; esac
          case "$t" in
            Q) cd_abs=$((cd_abs + 1))   # a quoted target: read off its quoted text
               if [ "$qs_ok" = 1 ] && [ "$qn" -lt "${#qs[@]}" ] && [ "${#qs[qn]}" -ge 2 ]; then
                 w="${qs[qn]}"; w="${w:1:${#w}-2}"; w="${w//"$v2"/$projn}"; w="${w//"$v1"/$projn}"
                 case "$w" in ''|*'$'*|*'`'*|*\\*|*$'\n'*|*$'\x06'*) w="" ;; esac
                 case "/$w/" in */../*) w="" ;; esac
               fi ;;
            *Q*) cd_bad=1 ;;   # part quoted, part not
            /*|[A-Za-z]:[/\\]*) cd_abs=$((cd_abs + 1)); w="${t//$'\x05'/Q}" ;;
            *) cd_rels[${#cd_rels[@]}]="$t"; w="${t//$'\x05'/Q}" ;;
          esac
        fi
        cd_words[${#cd_words[@]}]="$w"
        case "${BASH_REMATCH[4]}" in *Q*) t="${BASH_REMATCH[4]//[!Q]/}"; qn=$((qn + ${#t})) ;; esac
      done
      t="${seg//[!Q]/}"; qn=$((qn + ${#t}))
    done <<< "$stripped"
  fi
  # a cd in a pipeline or sent to the background (`cd dir &`) runs in a subshell and moves nothing the later commands see
  re_cdpipe='(^|[^|])[|][[:space:]]*(cd|pushd)([[:space:]]|$)|(^|[;&|(])[[:space:]]*(cd|pushd)[[:space:]]+[^;&|]*[|]([^|]|$)'
  re_cdpipe="$re_cdpipe"'|(^|[;&|(])[[:space:]]*(cd|pushd)[[:space:]]+[^;&|]*[^>;&|][[:space:]]*&([^&>]|$)'
  [[ $lc =~ $re_cdpipe ]] && cd_bad=1
  # env -C DIR and sudo -D DIR run their command in DIR: a directory change too
  # (read case-sensitively off env's and sudo's own words: VAR=value, options and their values, before the command)
  t='([[:space:]]+(-[^[:space:]]*([[:space:]]+[^-[:space:]][^[:space:]]*)?))*[[:space:]]+'
  re_envc='(^|[^[:alnum:]_])env([[:space:]]+([A-Za-z_][A-Za-z_0-9]*=[^[:space:]]*|-[^[:space:]]*([[:space:]]+[^-[:space:]][^[:space:]]*)?))*'
  re_envc="$re_envc"'[[:space:]]+(-[A-Za-z]*C|--chdir)|(^|[^[:alnum:]_])sudo'"$t"'(-[A-Za-z]*D|--chdir)'
  envc=0; [[ $cmd =~ $re_envc ]] && { cd_bad=1; envc=1; }
  lead=0; [[ $cmd =~ $re_cd ]] && lead=1
  # Case B: walk the cd targets from the start directory; each must land in the project.
  if [ "$cd_n" -gt 0 ] && [ "$cd_bad" = 0 ] && [ "$cd_pos" = 1 ] && [ "$stripped_unsure" = 0 ]; then
    case "$stripped" in *[\(\)\`]*) ;; *)
      t="$lc"; n=0   # no cd hidden in quoted text or heredoc bodies: the raw text holds no more cd words
      while [[ $t =~ $re_cdw ]]; do n=$((n + 1)); t="${BASH_REMATCH[5]}"; done
      if [ "$n" = "$cd_n" ]; then
        if [ "$eff_out" = 1 ]; then cur="$effn"; else cur="${cwd_in:-$projn}"; fi
        ok=1; dirs=()
        for w in "${cd_words[@]}"; do
          [ -n "$w" ] || { ok=0; break; }
          case "$w" in /*|[A-Za-z]:[/\\]*) t="$w" ;; *) t="$cur/${w#./}" ;; esac
          norm "$t"; t="$NORM"
          case "/$t/" in */./*) dotres "$t"; t="$RES" ;; esac
          lower "$t"; case "$LOWER" in "$projl"|"$projl"/*) ;; *) ok=0; break ;; esac
          dirs[${#dirs[@]}]="$t"; cur="$t"
        done
        if [ "$ok" = 1 ]; then
          if and_chain; then chain=1
          elif [ "$lead" = 1 ] && [ "$cd_n" = 1 ] && [ -d "${dirs[0]}" ]; then chain=1   # a leading cd that succeeds
          fi
        fi
        if [ "$chain" = 1 ]; then
          chain_dirs=("${dirs[@]}")
          for t in "${dirs[@]}"; do scan_alt="$scan_alt$t$nl"; done
          if [ "$lead" = 1 ]; then eff_out=0; basea="${dirs[0]}"   # nothing runs before it
          elif [ "$eff_out" = 0 ]; then basea="$cwd_in"
          fi
        fi
      fi ;;
    esac
  fi
  # Case D: lines of && chains, each cd judged at its place (d_walk); interpreter writer targets from every directory.
  if [ "$chain" = 0 ] && [ "$cd_n" -gt 0 ] && [ "$cd_bad" = 0 ] && [ "$cd_pos" = 1 ] && [ "$stripped_unsure" = 0 ] \
     && d_walk; then
    dmode=1; d_k=0; scan_alt="$D_ALL"; segs_alt=""
    [ "$eff_out" = 0 ] && basea="$cwd_in"
  fi
  if [ "$chain" = 0 ] && [ "$dmode" = 0 ]; then
    [ "$cd_n" = 0 ] && [ "$envc" = 0 ] && [ -n "$cwd_in" ] && ! [[ $lc == *cd* || $lc == *pushd* || $lc == *popd* || $lc == *chdir* ]] \
      && basea="$cwd_in"   # case A
    lead_done=0
    if [ "$cd_n" -gt 0 ] && [ "$lead" = 1 ]; then   # case C: a leading cd
      [[ $cmd =~ $re_cd ]]; cdt="${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}"
      case "$cdt" in
        *'$'*|*'`'*|'') ;;
        /*|[A-Za-z]:[/\\]*)
          if [ "$cd_n" = 1 ] && [ "$cd_bad" = 0 ] && [ -d "$cdt" ]; then   # a cd to a missing folder moves nowhere
            if abs_outside "$cdt"; then eff_out=1; effn="$NORM"; else eff_out=0; fi
            cd_abs=0; lead_done=1
          fi ;;
      esac
    fi
    # a cd hidden in quoted text (eval, a body, a sourced string) may move the shell anywhere
    hidden=0
    if [ "$cd_n" -gt 0 ] || [[ $lc == *cd* ]]; then
      t="$lc"; n=0
      while [[ $t =~ $re_cdw ]]; do n=$((n + 1)); t="${BASH_REMATCH[5]}"; done
      [ "$n" -gt "$cd_n" ] && hidden=1
    fi
    # every cd a readable absolute target in the project: the start base stays, each target is judged as well
    known=0
    if [ "$lead_done" = 0 ] && [ "$cd_n" -gt 0 ] && [ "$cd_bad" = 0 ] && [ "$hidden" = 0 ] \
       && [ "$stripped_unsure" = 0 ] && [ "${#cd_rels[@]}" = 0 ]; then
      known=1; t=""
      for w in "${cd_words[@]}"; do
        case "$w" in /*|[A-Za-z]:[/\\]*) ;; *) known=0; break ;; esac
        norm "$w"; lower "$NORM"
        case "/$NORM/" in */../*|*/./*) known=0; break ;; esac
        case "$LOWER" in "$projl"|"$projl"/*) t="$t$NORM$nl" ;; *) known=0; break ;; esac
      done
      if [ "$known" = 1 ]; then
        segs_alt="$t"; scan_alt="$t"
        [ "$eff_out" = 0 ] && basea="$cwd_in"
      fi
    fi
    # What is left is a cwd base plus relative plain `cd sub` steps; an absolute or unreadable cd left over voids it.
    [ "$known" = 0 ] && { [ "$cd_bad" = 1 ] || [ "$cd_abs" -gt 0 ] || [ "$stripped_unsure" = 1 ] || [ "$hidden" = 1 ]; } \
      && { eff_out=0; base_void=1; }
    # Each relative cd moves the outside base; one that lands in the project (or on it) ends the outside base.
    if [ "$eff_out" = 1 ] && [ "${#cd_rels[@]}" -gt 0 ]; then
      for t in "${cd_rels[@]}"; do
        t="${t#./}"
        if [ -z "$t" ] || [ "$t" = . ]; then continue; fi
        if abs_outside "$effn/$t"; then   # a cd to a missing folder moves nowhere
          [ -d "$effn/$t" ] && effn="$NORM"
        else eff_out=0; walked_in=1; break   # into the project, or onto it, or not readable: no outside base any more
        fi
      done
    fi
    # Inside the project: the directory the relative cd steps reached from the cwd, for judging paths with . and ..
    # segments. A step into a missing folder (one the command may create first), or a walk that came in from outside,
    # leaves the directory unknown.
    if [ "$eff_out" = 0 ] && [ "$cd_bad" = 0 ] && [ "$cd_abs" = 0 ] && [ "${#cd_rels[@]}" -gt 0 ]; then
      basen="${cwd_in:-$projn}"
      [ "$walked_in" = 1 ] && { basen=""; base_void=1; }
      for t in "${cd_rels[@]}"; do
        [ -n "$basen" ] || break
        t="${t#./}"
        if [ -z "$t" ] || [ "$t" = . ]; then continue; fi
        if [ -d "$basen/$t" ]; then basen="$basen/$t"; else basen=""; base_void=1; break; fi
      done
    fi
    # Inside the project with no known base: the cwd and each absolute cd target are judged as well.
    if [ "$known" = 0 ] && [ "$eff_out" = 0 ] && [ -z "$basea" ] && [ "$lead_done" = 0 ]; then
      [ -n "$cwd_in" ] && segs_alt="$cwd_in$nl"
      for w in "${cd_words[@]}"; do
        case "$w" in /*|[A-Za-z]:[/\\]*) norm "$w"; lower "$NORM"
          case "/$NORM/" in */../*|*/./*) ;; *) case "$LOWER" in "$projl"|"$projl"/*) segs_alt="$segs_alt$NORM$nl" ;; esac ;; esac ;;
        esac
      done
      scan_alt="$segs_alt"
    fi
  fi
  # Outside by spelling only: a symlinked cwd (/tmp vs /private/tmp) is the project's tree, or holds it. Rare, so the
  # subshell `cd -P` (a builtin, no exec) is paid only here.
  if [ "$eff_out" = 1 ]; then
    PHYS="$(CDPATH= cd -P -- "$effn" 2>/dev/null && pwd -P)"; pe="$PHYS"
    PHYS="$(CDPATH= cd -P -- "$projn" 2>/dev/null && pwd -P)"; pp="$PHYS"
    if [ -n "$pe" ] && [ -n "$pp" ]; then
      lower "$pe"; pe="$LOWER"; lower "$pp"; pp="$LOWER"; lower "$effn"; el="$LOWER"
      case "$pe/" in "${pp%/}"/*) eff_out=0 ;; esac                                      # the same tree or inside it
      case "$pp/" in "${pe%/}"/*) case "$projl/" in "${el%/}"/*) ;; *) eff_out=0 ;; esac ;; esac   # holds it, unseen lexically
    fi
  fi
  mentions=0
  [[ $lc == *human-replies.jsonl* || $lc == *orchestrator.json* ]] && mentions=1
  # sl tools that start a build are denied until the plan is approved.
  re_sl='(sl|\$SL|\$\{SL\}|scripts/sl)"?[[:space:]]+(dispatch|assign|wave0|commit_task|finish|build_prime|run_tests)([[:space:]]|$)'
  if [ "$human" = 1 ] && [[ $cmd =~ $re_sl ]]; then hit="sl ${BASH_REMATCH[2]}"; fi
  # Inline interpreter writers (checked on the full text, heredoc bodies included), judged by target: the
  # path-like quoted literals in the command are classified like any write; any denied one blocks, and a
  # writer with no path literal at all (a variable target) blocks while the guard is enforcing.
  re_interp='(^|[^[:alnum:]_])(python[0-9.]*|node|ruby|php)([[:space:]"'"'"']|$)'
  re_writer="open\(([^()]|\(([^()]|\([^()]*\))*\))*,[[:space:]]*(mode=)?['\"]([wax]|r[bt]?\+)|\.open\([[:space:]]*(mode=)?['\"]([wax]|r[bt]?\+)|\.(write_text|write_bytes)\(|writeFileSync|writeFile\(|appendFile(Sync)?\(|fs\.write|File\.(bin)?write\(|file_put_contents\("
  alt_list="$scan_alt"
  # A command that names a protected file runs the scan in every state (#122): without a run only a protected or
  # unknown writer target blocks; an unknown one then counts as the protected file.
  if [ -z "$hit" ] && { [ "$enforce" = 1 ] || [ "$mentions" = 1 ]; } && [[ $lc =~ $re_interp && $cmd =~ $re_writer ]] && scan_gate; then
    # Each writer call's own target: a literal, Path('...'), or a name assigned one of those in the command.
    # Every open( must read as a plain read or a parsed write; every other writer call must be parsed.
    sq="'"; dq='"'; q="[$sq$dq]"; arg="([^,()]*|Path\([^()]*\)|os\.path\.join\([^()]*\))"
    re_open='(^|[^A-Za-z0-9_])open\('
    re_ow="^$arg,[[:space:]]*(mode=)?$q([wax]|r[bt]?\+)"
    re_or="^$arg(,[[:space:]]*((mode=)?${q}r[bt]?$q|(encoding|errors|newline|buffering)=[^,()]*))*\)"
    re_mr="^[[:space:]]*(\)|(mode=)?${q}r)"
    re_mw="^[[:space:]]*(mode=)?$q([wax]|r[bt]?\+)"
    re_w2="(Path\([^()]*\)|\(([^()]|Path\([^()]*\))*\)|[A-Za-z_][A-Za-z_0-9]*)\.(write_text|write_bytes)\("
    re_w3="(Path\([^()]*\)|[A-Za-z_][A-Za-z_0-9]*)\.open\([[:space:]]*(mode=)?$q([wax]|r[bt]?\+)"
    re_w4="(writeFileSync|writeFile|appendFileSync|appendFile|File\.write|File\.binwrite|file_put_contents)\(([^,()]*),"
    re_other='\.(write_text|write_bytes)\(|writeFileSync\(|writeFile\(|appendFileSync\(|appendFile\(|fs\.write(Sync)?\(|File\.(bin)?write\(|file_put_contents\('
    unknown=0; want=0; got=0
    rest="$cmd"
    while [ -z "$hit" ] && [ "$unknown" = 0 ] && [[ $rest =~ $re_open ]]; do
      prev="${BASH_REMATCH[1]}"; rest="${rest#*"${BASH_REMATCH[0]}"}"
      if [ "$prev" = . ]; then                         # obj.open(...): Path.open, os.open, ...
        if [[ $rest =~ $re_mw ]]; then want=$((want + 1)); elif [[ $rest =~ $re_mr ]]; then :; else unknown=1; fi   # 'r+' writes
      elif [[ $rest =~ $re_ow ]]; then
        resolve_target "${BASH_REMATCH[1]}"
        if [ -z "$TGT" ]; then [ "$RT_OUT" = 1 ] || unknown=1; elif project_code "$TGT"; then hit="$TGT"; fi
      elif ! [[ $rest =~ $re_or ]]; then unknown=1
      fi
    done
    rest="$cmd"
    while [[ $rest =~ $re_other ]]; do want=$((want + 1)); rest="${rest#*"${BASH_REMATCH[0]}"}"; done
    for re_w in "$re_w2" "$re_w3" "$re_w4"; do
      rest="$cmd"
      while [ -z "$hit" ] && [ "$unknown" = 0 ] && [[ $rest =~ $re_w ]]; do
        m="${BASH_REMATCH[0]}"
        if [ "$re_w" = "$re_w4" ]; then e="${BASH_REMATCH[2]}"; else e="${BASH_REMATCH[1]}"; fi
        rest="${rest#*"$m"}"; got=$((got + 1))
        resolve_target "$e"
        if [ -z "$TGT" ]; then [ "$RT_OUT" = 1 ] || unknown=1; elif project_code "$TGT"; then hit="$TGT"; fi
      done
    done
    # A writer whose target is unknown (a variable, an f-string, a method chain, fs.write on a descriptor) blocks.
    # Out of reach: file APIs without a writer call (os.replace, shutil.copy, ...).
    if [ -z "$hit" ] && { [ "$unknown" = 1 ] || [ "$got" -lt "$want" ]; }; then
      hit="${cmd:0:120}"; hit="${hit//$'\n'/ }"; [ "$mentions" = 1 ] && prot=1
    fi
    # Next to a protected file's name, a move, copy or link API may put a scratch file in its place.
    re_mv='os\.(replace|renames?|link|symlink)\(|shutil\.|\.(rename|symlink_to|hardlink_to|link_to)\(|\.replace\(([^,()]|\([^()]*\))*\)'
    re_mv="$re_mv"'|fs\.(rename|copyFile|cp|symlink|link)(Sync)?\(|FileUtils|File\.(rename|symlink|link)\(|(^|[^A-Za-z0-9_.])(rename|copy|symlink|link)\('
    if [ -z "$hit" ] && [ "$mentions" = 1 ] && [[ $cmd =~ $re_mv ]]; then
      hit="${cmd:0:120}"; hit="${hit//$'\n'/ }"; prot=1
    fi
  fi
  alt_list="$segs_alt"
  if [ -z "$hit" ]; then
    [ "$stripped_done" = 1 ] || strip_cmd
    qi=0; d0_out="$eff_out"; d0_a="$basea"
    judge_segs
  fi
fi

[ -n "$hit" ] || exit 0

hit="${hit:0:120}"; hit="${hit//[\"\\$'\n\r\t']/}"
printf '{"kind":"rule-block","agent":"coordinator","tool":"%s","target":"%s"}\n' "$tool" "$hit" \
  >> "$sd/incidents.jsonl" 2>/dev/null

if [ "$prot" = 1 ]; then
  printf '%s\n' \
    'Blocked: .superlite/orchestrator.json and .superlite/human-replies.jsonl are never written directly. Change the orchestrator state only with `sl orchestrator ...` (for example `sl orchestrator approve --review <path>`); human-replies.jsonl is written only by the hook that records the human'"'"'s replies.' >&2
elif [ "$human" = 1 ]; then
  printf '%s\n' \
    'Human orchestrator: no build starts until the human approves the plan. Write the review plan docs/plans/<date>-<topic>.review.md (see skills/writing-plans/review-plan.md), show its path with a five-line summary, ask the human to reply approve, end your turn, then run sl orchestrator approve --review <path>.' >&2
else
  printf '%s\n' \
    'Blocked: the superlite coordinator must not write project code. Dispatch it instead:' \
    '- Fix: give a fixer a finding id F-<Tn>-<n> and the note path .superlite/fixes/<id>.md, tiered per skills/subagent-driven-development/fixing.md: known cause, one module -> fixer-sonnet; cross-module -> fixer-sonnet-high; unknown cause -> fixer-opus.' \
    '- Wave 0 skeleton/stub/config files belong to an implementer-haiku task.' \
    '- New code belongs to an implementer task. You may write only docs/plans/**, docs/*/plans/**, SPEC*.md, docs/**/*.md, any docs.md and .superlite/**.' \
    '- After the run, `sl orchestrator end` archives the run markers and the guard stops; never delete .superlite by hand.' >&2
fi
exit 2
