#!/usr/bin/env bash
# PreToolUse hook (Edit, Write, NotebookEdit, Bash, PowerShell, Agent): guards the COORDINATOR, i.e.
# the main session, whose calls carry no agent_id. Subagent calls and fleet worker sessions always pass. Four rules, in order
# (rule 4 is checked first for an Agent call):
#  1. Protected files, in every state: .superlite/orchestrator.json (changed only by `sl orchestrator`)
#     and .superlite/human-replies.jsonl (written only by hooks/record-human-reply) are never written
#     by the model, also inside a linked worktree in the project.
#  2. HUMAN-UNAPPROVED (.superlite/orchestrator.json has mode human and approved false): nothing
#     builds until the human approves the plan. Allowed writes: docs/plans/*.review.md, docs/*/plans/*.review.md,
#     .superlite/** (minus the protected files) and .git/info/exclude, also inside a linked worktree in the project
#     (judged from its root, whose .git file points into .../worktrees/); Agent calls of superlite:* and
#     general-purpose and sl dispatch/assign/wave0/commit_task/finish/build_prime/run_tests are denied.
#  3. Active run (.superlite/stable.json, prime.md or pool.json exists): project code is not written
#     by the coordinator; allowed targets are docs/plans/**, docs/*/plans/**, SPEC*.md, docs/**/*.md, docs/** images (png, jpg,
#     jpeg, gif, svg, webp), any docs.md, .superlite/** and .git/info/exclude (a stray untracked file or folder may also be removed with rm, and a git-ignored path no task Owns may be written or removed), in the project or a linked worktree in it; an Edit/Write of the Owns of an inline build (the run's plan holds exactly one task) passes too, judged by guard_judge.py --owns. `sl orchestrator end` closes the run. <state folder>/scratch/ is the coordinator's throwaway-script folder: a Bash run of a script there is judged with its text inlined as a heredoc (scratch_inline), and the code block names it (scratch_hint).
#  4. Fleet on (.superlite/fleet.json says "on": true): an Agent call of a superlite role (implementer, implementer-haiku,
#     fixer-sonnet, fixer-sonnet-high, fixer-opus, package-reviewer, final-reviewer, researcher, checker, writer) is denied with the
#     `sl fleet spawn --role` hint, as the role is a fleet worker then. The message says the block repeats on every call (no retry);
#     a researcher's message gives the research path (brief under <state folder>/briefs/, spawn, send, `fleet wait Wn`,
#     report under <state folder>/fleet/reports/). A writer's names spawn --role writer --brief; the brief's Output: line names its one file. Other agents (Explore, general-purpose) fall through.
#     Reads the run's own fleet.json: from a linked worktree its .superlite, not a binding's folder in another checkout;
#     a fleet another session turned on (owner_session, owner_pid) is skipped unless that session is still bound there.
#     The message names the state folder as PLAN for a build without a plan.
# The .superlite folder is the session's own (hooks/superlite-state.sh): its binding, else the launch
# directory's unless another session owns that one.
# Who judges what: the path of an Edit, Write or NotebookEdit call is judged here (project_code). A Bash or PowerShell
# command is judged by skills/subagent-driven-development/scripts/guard_judge.py (Python, `python -I`; found like `sl`
# finds it): the hook passes it the mode (idle, active or human), the project and the state folder, and the hook JSON
# unchanged on stdin; the judge prints the block message and exits 2, or prints `guard: ok NONCE` and exits 0 (an exit 0
# without that line re-runs the judge once on a Python found without the cache). The mode is decided here: human when
# orchestrator.json says human and not approved, else active when a run marker exists, else idle. The judge runs only
# when the guard enforces (active or human) or the command may name a protected file (also through quotes, backslashes,
# `$'...'`, or a glob or brace near .superlite); an idle command that does not is never judged, so no Python starts.
# The sl dispatch gate of the human state and the Agent gate stay here.
# The hook fails open: when Python is missing or the judge fails (any exit other than 0 and 2) it appends a guard-error
# incident to <state folder>/incidents.jsonl and exits 0. Sessions without a .superlite directory are never touched.
# Bash builtins only until the judge starts (each spawn costs ~250 ms on Windows), cheap exits first. Exit 2 blocks
# (message on stderr); anything else, including malformed input, exits 0 (fail open).

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# bl_scan CMD: the shell words of the Bash command CMD, quotes and backslashes removed, into BLW (a $'\001'
# between simple commands); the quoted text and heredoc bodies into BLT (text only) or BLS (text that may run:
# an assignment's quoted value, an unquoted-delimiter heredoc body holding $( or a backtick). A $( or backtick
# opens its own words, inside double quotes too. BLLONG=1 when a line is over 4096 characters (the scan stops).
# Per BLT entry j: BLTC[j] the index of its simple command (the number of separators before it), BLTN[j]=1 inside
# $( ) or backticks, BLTK[j] its description for the block line. Per command c: BLO[c]=1 when it redirects its stdout
# to a file, BLF[c] those targets (newline-ended).
# Bash builtins only; one line at a time, so no step copies the whole command.
bl_scan() {
  local LC_ALL=C
  local rest="$1" ln n i c d w="" wt="" wa=0 mt="" stk="" m dl dq ds j seg cmp body k more=1 sc=0 tg=0 fd bn tk
  local -a dep=() pd=() pq=() pt=() pc=() pn=()
  BLW=(); BLT=(); BLS=(); BLLONG=0; BLTC=(); BLTN=(); BLTK=(); BLO=(); BLF=(); BLCN=()
  bl_emit() {
    if [ "$wa" = 1 ]; then
      BLW[${#BLW[@]}]="$w"
      [[ $stk == *[SB]* ]] && BLCN[sc]=1
      if [ "$tg" = 1 ]; then BLF[sc]="${BLF[sc]}$w"$'\n'; tg=0; fi
      if [[ $w =~ ^[A-Za-z_][A-Za-z0-9_]*\+?= ]]; then BLS[${#BLS[@]}]="${w#*=}"   # the whole value, escaped spaces too
      elif [ -n "$wt" ]; then
        j=${#BLT[@]}; BLT[j]="$wt"; BLTC[j]=$sc; bn=0; [[ $stk == *[SB]* ]] && bn=1; BLTN[j]=$bn
        tk="${wt:0:60}"; BLTK[j]="the quoted text \"${tk//$'\n'/ }\""
      fi
    fi
    w=""; wt=""; wa=0
  }
  bl_sep() { bl_emit; BLW[${#BLW[@]}]=$'\001'; sc=$((sc + 1)); tg=0; }
  bl_line() {   # next line of rest into ln; more=0 after the last one
    ln="${rest%%$'\n'*}"
    if [ ${#ln} -gt 4096 ]; then BLLONG=1; more=0; ln=""; rest=""; return; fi
    if [ ${#ln} = ${#rest} ]; then more=0; rest=""; else rest="${rest:${#ln}+1}"; fi
  }
  while [ "$more" = 1 ]; do
    bl_line; n=${#ln}; i=0
    while [ "$i" -lt "$n" ]; do
      c="${ln:i:1}"; m="${stk: -1}"
      case "$m" in
        Q) seg="${ln:i}"; d="${seg%%\'*}"; w+="$d"; wt+="$d"
           if [ ${#d} = ${#seg} ]; then i=$n; else stk="${stk%?}"; i=$((i + ${#d} + 1)); fi
           continue ;;
        A) if [ "$c" = '\' ]; then d="${ln:i+1:1}"; w+="$d"; wt+="$d"; i=$((i + 2))
           elif [ "$c" = "'" ]; then stk="${stk%?}"; i=$((i + 1))
           else w+="$c"; wt+="$c"; i=$((i + 1)); fi
           continue ;;
        M) mt+="$c"   # arithmetic $(( )) or (( )): a << is a shift here, not a heredoc; its text is scanned whole
           case "$c" in
             '(') dep[${#stk}]=$((dep[${#stk}] + 1)) ;;
             ')') dep[${#stk}]=$((dep[${#stk}] - 1))
                  if [ "${dep[${#stk}]}" -le 0 ]; then stk="${stk%?}"; BLS[${#BLS[@]}]="$mt"; mt=""; fi ;;
             '$') if [ "${ln:i+1:1}" = '(' ] && [ "${ln:i+2:1}" != '(' ]; then bl_sep; stk+=S; dep[${#stk}]=0; i=$((i + 1)); fi ;;
             '`') bl_sep; stk+=B ;;
           esac
           i=$((i + 1)); continue ;;
        R) mt+="$c"   # arithmetic $[ ]: like M, with [ ] as the brackets
           case "$c" in
             '[') dep[${#stk}]=$((dep[${#stk}] + 1)) ;;
             ']') dep[${#stk}]=$((dep[${#stk}] - 1))
                  if [ "${dep[${#stk}]}" -le 0 ]; then stk="${stk%?}"; BLS[${#BLS[@]}]="$mt"; mt=""; fi ;;
             '$') if [ "${ln:i+1:1}" = '(' ] && [ "${ln:i+2:1}" != '(' ]; then bl_sep; stk+=S; dep[${#stk}]=0; i=$((i + 1)); fi ;;
             '`') bl_sep; stk+=B ;;
           esac
           i=$((i + 1)); continue ;;
        D) case "$c" in
             '"') stk="${stk%?}"; i=$((i + 1)) ;;
             '\') d="${ln:i+1:1}"
                  case "$d" in '"'|'\'|'$'|'`') w+="$d"; wt+="$d" ;; '') ;; *) w+="\\$d"; wt+="\\$d" ;; esac
                  i=$((i + 2)) ;;
             '$') if [ "${ln:i:3}" = '$((' ]; then stk+=M; dep[${#stk}]=2; mt='(('; i=$((i + 3))
                  elif [ "${ln:i+1:1}" = '(' ]; then bl_sep; stk+=S; dep[${#stk}]=0; i=$((i + 2))
                  elif [ "${ln:i+1:1}" = '[' ]; then stk+=R; dep[${#stk}]=1; mt='['; i=$((i + 2))
                  else w+='$'; wt+='$'; i=$((i + 1)); fi ;;
             '`') bl_sep; stk+=B; i=$((i + 1)) ;;
             *) seg="${ln:i}"; seg="${seg%%[\"\\\$\`]*}"; w+="$seg"; wt+="$seg"; i=$((i + ${#seg})) ;;
           esac
           continue ;;
      esac
      case "$c" in
        ' '|$'\t') bl_emit; i=$((i + 1)) ;;
        '\') if [ $((i + 1)) -lt "$n" ]; then w+="${ln:i+1:1}"; wa=1; fi
             i=$((i + 2)) ;;
        "'") stk+=Q; wa=1; i=$((i + 1)) ;;
        '"') stk+=D; wa=1; i=$((i + 1)) ;;
        '$') case "${ln:i+1:1}" in
               '(') if [ "${ln:i:3}" = '$((' ]; then stk+=M; dep[${#stk}]=2; mt='(('; i=$((i + 3))
                    else bl_sep; stk+=S; dep[${#stk}]=0; i=$((i + 2)); fi ;;
               "'") stk+=A; wa=1; i=$((i + 2)) ;;
               '{') seg="${ln:i}"; d="${seg%%\}*}"; w+="$d}"; wa=1; i=$((i + ${#d} + 1))
                    if [[ $d == *'$('* || $d == *'`'* ]]; then BLS[${#BLS[@]}]="$d}"; fi ;;
               '[') stk+=R; dep[${#stk}]=1; mt='['; wa=1; i=$((i + 2)) ;;
               *) w+='$'; wa=1; i=$((i + 1)) ;;
             esac ;;
        '`') bl_sep; if [ "$m" = B ]; then stk="${stk%?}"; else stk+=B; fi; i=$((i + 1)) ;;
        '(') if [ "$wa" = 0 ] && [ "${ln:i:2}" = '((' ]; then stk+=M; dep[${#stk}]=2; mt='(('; i=$((i + 2)); continue; fi
             bl_sep; [ "$m" = S ] && dep[${#stk}]=$((dep[${#stk}] + 1)); i=$((i + 1)) ;;
        ')') bl_sep
             if [ "$m" = S ]; then
               if [ "${dep[${#stk}]}" = 0 ]; then stk="${stk%?}"; else dep[${#stk}]=$((dep[${#stk}] - 1)); fi
             fi
             i=$((i + 1)) ;;
        ';'|'&'|'|') bl_sep; i=$((i + 1)) ;;
        '<') if [ "${ln:i:3}" = '<<<' ]; then bl_emit; i=$((i + 3))
             elif [ "${ln:i:2}" = '<<' ]; then
               bl_emit; i=$((i + 2)); ds=0; dq=0; dl=""
               [ "${ln:i:1}" = - ] && { ds=1; i=$((i + 1)); }
               while [[ ${ln:i:1} == [' '$'\t'] ]]; do i=$((i + 1)); done
               while [ "$i" -lt "$n" ]; do
                 d="${ln:i:1}"
                 case "$d" in
                   ' '|$'\t'|';'|'&'|'|'|'<'|'>'|'('|')') break ;;
                   "'"|'"') dq=1; seg="${ln:i+1}"; j="${seg%%"$d"*}"; dl+="$j"; i=$((i + ${#j} + 2)) ;;
                   '\') dq=1; dl+="${ln:i+1:1}"; i=$((i + 2)) ;;
                   *) dl+="$d"; i=$((i + 1)) ;;
                 esac
               done
               pd[${#pd[@]}]="$dl"; pq[${#pq[@]}]="$dq"; pt[${#pt[@]}]="$ds"; pc[${#pc[@]}]=$sc
               bn=0; [[ $stk == *[SB]* ]] && bn=1; pn[${#pn[@]}]=$bn
             else bl_emit; i=$((i + 1)); fi ;;
        '>') fd=1; [ "$wa" = 1 ] && [[ $w =~ ^[0-9]+$ ]] && fd="$w"
             bl_emit; i=$((i + 1))
             while [ "${ln:i:1}" = '>' ]; do i=$((i + 1)); done
             while [[ ${ln:i:1} == [' '$'\t'] ]]; do i=$((i + 1)); done
             if [ "$fd" = 1 ]; then case "${ln:i:1}" in '('|'&'|'') ;; *) BLO[sc]=1; tg=1 ;; esac; fi ;;
        '#') if [ "$wa" = 0 ]; then i=$n; else w+='#'; i=$((i + 1)); fi ;;
        *) seg="${ln:i}"; seg="${seg%%[[:space:]\\\'\"\$\`\(\)\;\&\|\<\>]*}"
           [ -z "$seg" ] && seg="$c"
           w+="$seg"; wa=1; i=$((i + ${#seg})) ;;
      esac
    done
    # end of line: a newline inside quotes is text; after a trailing backslash it joins the lines
    m="${stk: -1}"
    case "$m" in
      Q|A|D) w+=$'\n'; wt+=$'\n'; continue ;;
      M|R) mt+=$'\n'; continue ;;
    esac
    [ "$more" = 1 ] && [[ $ln == *'\' ]] && [ "$i" -gt "$n" ] && continue
    bl_sep
    for ((k = 0; k < ${#pd[@]}; k++)); do
      body=""
      while [ "$more" = 1 ]; do
        bl_line
        cmp="$ln"; [ "${pt[k]}" = 1 ] && { while [[ $cmp == $'\t'* ]]; do cmp="${cmp#?}"; done; }
        [ "$cmp" = "${pd[k]}" ] && break
        body+="$ln"$'\n'
      done
      if [ "${pq[k]}" = 0 ] && [[ $body == *'$('* || $body == *'`'* ]]; then BLS[${#BLS[@]}]="$body"
      else j=${#BLT[@]}; BLT[j]="$body"; BLTC[j]=${pc[k]}; BLTN[j]=${pn[k]}; BLTK[j]="the heredoc <<${pd[k]}"; fi
    done
    pd=(); pq=(); pt=(); pc=(); pn=()
  done
  bl_emit
}

# bl_judge CMD: succeeds, the subcommand in BLHIT, when the Bash command CMD runs sl backlog decide|answer|start|plan:
# the two words in a row, or the text of a quote or heredoc that may run (a runner word in the command, an assignment).
# A text that a cat, tee, printf or echo only writes to plain files no other command of the call runs is data and does
# not count (#706). BLWHY: the sentence that says which text matched and why (empty for a two-word hit).
# A line over 4096 characters succeeds without a scan, BLHIT unchanged (the caller's raw match stands).
bl_judge() {
  local k nx v b cp rw run=0 envw=0 envs=0 t re='backlog(\.py)?[[:space:]]+(decide|answer|start|plan)([^[:alnum:]_-]|$)'
  local c=0 cwd=0 cenv=0 cens=0 hasmake=0 frw="" j wd why re_as='^[A-Za-z_][A-Za-z0-9_]*\+?='
  local -a CW=() CA=() CR=() CRW=()
  BLWHY=""
  bl_scan "$1"
  [ "$BLLONG" = 1 ] && return 0
  shopt -s nocasematch
  for ((k = 0; k < ${#BLW[@]}; k++)); do
    v="${BLW[k]}"; nx="${BLW[k+1]}"
    if [[ $v == *backlog || $v == *backlog.py ]] && [[ $nx == decide || $nx == answer || $nx == start || $nx == plan ]]; then
      shopt -u nocasematch; BLHIT="$nx"; return 0
    fi
    if [ "$v" = $'\001' ]; then c=$((c + 1)); cwd=0; cenv=0; cens=0; continue; fi
    b="${v##*/}"; b="${b##*\\}"; b="${b%.exe}"
    cp=0   # command position: first word, or after a separator or a reserved word
    if [ "$k" = 0 ]; then cp=1; else
      case "${BLW[k-1]}" in $'\001'|then|do|else|elif|if|while|until|'{'|'!'|time) cp=1 ;; esac
    fi
    if [ "$cwd" = 0 ]; then   # the command word: after reserved words and NAME=value assignments
      case "$v" in
        then|do|else|elif|if|while|until|'{'|'!'|time) ;;
        *) if [[ ! $v =~ $re_as ]]; then CW[c]="$b"; cwd=1; fi ;;
      esac
    else CA[c]+="$v"$'\n'; fi
    rw=""
    [ "$cp" = 1 ] && [[ $v == \$* && $nx == -*c* ]] && { run=1; rw="$v"; }   # $SHELL -c '...'
    case "$b" in
      sh|bash|zsh|dash|ksh|ash|mksh|yash|fish|csh|tcsh|busybox|eval|trap|xargs|ssh|su|watch|script|tmux|screen|herdr|pwsh|powershell|cmd|iex|invoke-expression|python*|pypy*|node|nodejs|deno|bun|perl|ruby|php|lua|osascript|expect|awk|gawk|mawk|nawk|make) run=1; rw="$b" ;;
      source|.|exec) [ "$cp" = 1 ] && { run=1; rw="$b"; } ;;
      env) envw=1; cenv=1 ;;
      --split-string*|-S*) envs=1; cens=1 ;;
    esac
    [ "$b" = make ] && hasmake=1
    [ -z "$rw" ] && [ "$cenv" = 1 ] && [ "$cens" = 1 ] && rw="env -S"   # env -S in one command
    if [ -n "$rw" ] && [ "${CR[c]}" != 1 ]; then CR[c]=1; CRW[c]="$rw"; [ -z "$frw" ] && frw="$rw"; fi
  done
  BLNC=$c
  [ "$envw" = 1 ] && [ "$envs" = 1 ] && run=1
  [ "$run" = 1 ] && [ -z "$frw" ] && frw="env -S"
  for t in "${BLS[@]}"; do
    t="${t//\\/}"; t="${t//\"/}"; t="${t//\'/}"
    if [[ $t =~ $re ]]; then
      BLHIT="${BASH_REMATCH[2]}"; shopt -u nocasematch
      BLWHY=" Matched: an assigned value or an unquoted heredoc holding \$( or a backtick; the shell runs it."
      return 0
    fi
  done
  if true; then
    for ((j = 0; j < ${#BLT[@]}; j++)); do
      t="${BLT[j]}"; t="${t//\\/}"; t="${t//\"/}"; t="${t//\'/}"
      [[ $t =~ $re ]] || continue
      BLHIT="${BASH_REMATCH[2]}"
      bl_data "$j" "$hasmake"; wd=$?
      [ "$wd" = 0 ] && continue
      [ "$run" = 1 ] || [ "$wd" = 2 ] || continue   # no runner word: only a written file the call runs counts
      shopt -u nocasematch
      c="${BLTC[j]}"
      if [ "${CR[c]}" = 1 ]; then BLWHY=" Matched: ${BLTK[j]}, which ${CRW[c]} in the same command runs."
      elif [ "$wd" = 2 ]; then BLWHY=" Matched: ${BLTK[j]}; it writes $BLDF, which this call then runs ($BLDW)."
      else BLWHY=" Matched: ${BLTK[j]}; the runner word $frw elsewhere in this call makes it runnable. Write the file in one Bash call and run $frw in another: that passes."; fi
      return 0
    done
  fi
  shopt -u nocasematch
  return 1
}

# bl_data J HASMAKE: for BLT entry J, in bl_judge's scope (CW, CA, CR, CRW): 0 when the text is written data (Design:
# not inside $( ), a cat/tee/printf/echo with stdout redirected to plain files, none of them run by another command),
# 2 when only a file run by another command spoils it (BLDF the file, BLDW the command or runner word), else 1.
bl_data() {
  local j="$1" c f bn x w c2 nc="${#CW[@]}" fs; local -a files=()
  c="${BLTC[j]}"
  [ "${BLTN[j]}" = 1 ] && return 1
  case "${CW[c]}" in cat|tee|printf|echo) ;; *) return 1 ;; esac
  [ "${BLO[c]}" = 1 ] || return 1
  fs="${BLF[c]}"
  if [ "${CW[c]}" = tee ]; then
    while IFS= read -r w; do [ -n "$w" ] && [[ $w != -* ]] && fs+="$w"$'\n'; done <<< "${CA[c]}"
  fi
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      *'$'*|*'`'*|*'*'*|*'?'*|*'['*) return 1 ;;
      /dev/null) ;;
      /dev/*|/proc/*) return 1 ;;
    esac
    files[${#files[@]}]="$f"
  done <<< "$fs"
  [ "${#files[@]}" -gt 0 ] || return 1
  for f in "${files[@]}"; do
    bn="${f##*/}"
    [ "$f" = /dev/null ] && continue
    case "$bn" in Makefile|makefile|GNUmakefile|*.mk) [ "$2" = 1 ] && { BLDF="$f"; BLDW=make; return 2; } ;; esac
    for ((c2 = 0; c2 <= BLNC; c2++)); do
      [ "$c2" = "$c" ] && continue
      if [ "${CW[c2]}" = "$bn" ]; then BLDF="$f"; BLDW="${CW[c2]}"; return 2; fi
      if [ "${CR[c2]}" = 1 ] && [[ ${CA[c2]} == *"$bn"* ]]; then BLDF="$f"; BLDW="${CRW[c2]}"; return 2; fi
      # a command inside $( ) or backticks naming the file hands its text to the call's runner (eval "$(cat f)")
      if [ "$run" = 1 ] && [ "${BLCN[c2]}" = 1 ] && [[ ${CA[c2]} == *"$bn"* ]]; then BLDF="$f"; BLDW="$frw"; return 2; fi
    done
  done
  return 0
}

# Fleet session (any role, a lead too; the env is the session's, so a command's `env -u` cannot change it): `sl backlog
# decide|answer|start|plan` is Max's main session only. A raw match on the hook JSON comes first (quotes and backslashes
# dropped, `backlog[.py]` then the subcommand): no match falls through at once. A Bash match is then judged on its
# command alone by bl_judge (#276): the two words run as a command block in any spelling ($SL, an absolute path,
# env -u ... sl, python3 .../backlog.py, $( ) or backticks, quoted words); text that a heredoc or a quoted argument only
# writes passes, unless the command can run it (a shell, eval, an interpreter, xargs, ssh, env -S, a variable). PowerShell,
# a Bash call without a readable command and a line over 4096 characters keep the raw match. Only a fleet session pays
# for it (builtin string work, no spawn); the idle coordinator path is untouched.
if [ -n "${SUPERLITE_FLEET_WORKER:-}" ]; then
  re_bl_tool='"tool_name"[[:space:]]*:[[:space:]]*"(Bash|PowerShell)"'
  if [[ $input =~ $re_bl_tool ]]; then
    bl_tool="${BASH_REMATCH[1]}"
    bl="${input//\\\\/$'\x01'}"; bl="${bl//\\t/ }"; bl="${bl//\\n/ }"; bl="${bl//$'\x01'/}"; bl="${bl//\\/}"; bl="${bl//\"/}"; bl="${bl//\'/}"
    re_bl='backlog(\.py)?[[:space:]]+(decide|answer|start|plan)([^[:alnum:]_-]|$)'
    shopt -s nocasematch
    if [[ $bl =~ $re_bl ]]; then
      shopt -u nocasematch
      BLHIT="${BASH_REMATCH[2]}"; bl_block=1
      re_bl_cmd='"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
      if [ "$bl_tool" = Bash ] && [[ $input =~ $re_bl_cmd ]]; then
        blc="${BASH_REMATCH[1]}"
        blc="${blc//\\\\/$'\x01'}"   # JSON \\ first, so \\" and \\n keep their shell meaning
        blc="${blc//\\\"/\"}"; blc="${blc//\\t/$'\t'}"; blc="${blc//\\r/}"; blc="${blc//\\n/$'\n'}"
        blc="${blc//$'\x01'/\\}"
        bl_judge "$blc" || bl_block=0
      fi
      if [ "$bl_block" = 1 ]; then
        printf '%s\n' "Blocked: sl backlog ${BLHIT} runs only in the main session (Max's session), never in a fleet worker or lead. Use sl backlog status or wait, and report NEEDS_DECISION instead.${BLWHY}" >&2
        exit 2
      fi
    fi
    shopt -u nocasematch
  fi
fi
re_agent='"agent_id"[[:space:]]*:[[:space:]]*"'
[[ $input =~ $re_agent ]] && exit 0   # subagent call
[ -n "${SUPERLITE_FLEET_WORKER:-}" ] && [ "${SUPERLITE_FLEET_ROLE:-}" != lead ] && exit 0   # fleet worker session; a lead is guarded like a coordinator
re_tool='"tool_name"[[:space:]]*:[[:space:]]*"([A-Za-z]+)"'
[[ $input =~ $re_tool ]] || exit 0
tool="${BASH_REMATCH[1]}"
case "$tool" in Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell|Agent|Task) ;; *) exit 0 ;; esac

# jstr KEY: first JSON string value for KEY, still JSON-escaped, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  REPLY=""
  [[ $input =~ $re ]] && REPLY="${BASH_REMATCH[1]}"
}

# Working directory of the call (the payload's cwd), once, for the incident rows: no quote, backslash or control character, 300 characters at most.
jstr cwd
cwdv="${REPLY//[[:cntrl:]]/}"; cwdv="${cwdv//[\"\\]/}"; cwdv="${cwdv:0:300}"

# norm PATH: forward slashes, no duplicate or trailing slashes, C:/x -> /c/x, into NORM.
norm() {
  local p="${1//\\//}" re='^([A-Za-z]):/(.*)$'
  while [[ $p == *//* ]]; do p="${p//\/\//\/}"; done
  [[ $p =~ $re ]] && { lower "${BASH_REMATCH[1]}"; p="/$LOWER/${BASH_REMATCH[2]}"; }
  while [[ $p == */ && $p != / ]]; do p="${p%/}"; done
  NORM="$p"
}

# lower S: S in lower case (ASCII), into LOWER. bash 3.2 (stock macOS) has no ${var,,}, and a `tr` spawn costs ~250 ms
# on Windows: a string without capitals is returned as is, else one builtin substitution per letter.
lower() {
  local s="$1"
  if [[ $s == *[[:upper:]]* ]]; then
    s="${s//A/a}"; s="${s//B/b}"; s="${s//C/c}"; s="${s//D/d}"; s="${s//E/e}"; s="${s//F/f}"; s="${s//G/g}"
    s="${s//H/h}"; s="${s//I/i}"; s="${s//J/j}"; s="${s//K/k}"; s="${s//L/l}"; s="${s//M/m}"; s="${s//N/n}"
    s="${s//O/o}"; s="${s//P/p}"; s="${s//Q/q}"; s="${s//R/r}"; s="${s//S/s}"; s="${s//T/t}"; s="${s//U/u}"
    s="${s//V/v}"; s="${s//W/w}"; s="${s//X/x}"; s="${s//Y/y}"; s="${s//Z/z}"
  fi
  LOWER="$s"
}

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"; proj="$SL_PROJ"
[ -d "$sd" ] || exit 0

active=0
{ [ -f "$sd/stable.json" ] || [ -f "$sd/prime.md" ] || [ -f "$sd/pool.json" ]; } && active=1
human=0
if [ -f "$sd/orchestrator.json" ]; then
  IFS= read -r -d '' oj < "$sd/orchestrator.json"
  re_human='"mode"[[:space:]]*:[[:space:]]*"human"'
  re_unappr='"approved"[[:space:]]*:[[:space:]]*false'
  [[ $oj =~ $re_human && $oj =~ $re_unappr ]] && human=1
fi
enforce=0
{ [ "$active" = 1 ] || [ "$human" = 1 ]; } && enforce=1

if [ "$tool" = Agent ] || [ "$tool" = Task ]; then
  # FSD: the folder whose fleet.json rule 4 reads. $SUPERLITE_STATE_DIR wins; else the linked worktree the call's cwd is in
  # (nearest `.git` above it is a file `gitdir: .../worktrees/<name>`) gives its own .superlite when $sd lies outside it
  # (a binding to the main checkout) and is no private folder under sessions/.
  FSD="$sd"
  if [ -z "${SUPERLITE_STATE_DIR:-}" ]; then
    jstr cwd; norm "${REPLY//\\\\//}"; fd="$NORM"; fw=""
    case "$fd" in
      /*)
        while :; do
          [ -e "$fd/.git" ] && { [ -f "$fd/.git" ] && fw="$fd"; break; }
          [ -n "$fd" ] && [ "$fd" != / ] && [ "${fd%/*}" != "$fd" ] || break
          fd="${fd%/*}"
        done ;;
    esac
    if [ -n "$fw" ]; then
      IFS= read -r fg < "$fw/.git" || true
      fg="${fg%$'\r'}"; re_gd='^gitdir:[[:space:]]*(.*)$'
      fw2=""
      if [[ $fg =~ $re_gd ]]; then
        norm "${BASH_REMATCH[1]}"; fg="$NORM"; fg="${fg%/*}"
        [[ $fg == */worktrees ]] && fw2="$fw"
      fi
      if [ -n "$fw2" ]; then
        norm "$sd"; fsn="$NORM"; norm "${SUPERLITE_HOME:-$HOME/.superlite}/sessions"; fss="$NORM"
        case "$fsn" in
          "$fw2/.superlite"|"$fw2"/*|"$fss"/*) ;;
          *) FSD="$fw2/.superlite" ;;
        esac
      fi
    fi
  fi
  jstr subagent_type
  fstale=0
  # a fleet that moved ("moved_to": absolute folder, fleet off here) is read at its target, up to 5 moves (#580)
  FSD0="$FSD"; re_mv='"moved_to"[[:space:]]*:[[:space:]]*"([^"]*)"'; re_fon0='"on"[[:space:]]*:[[:space:]]*true'
  for _mv in 1 2 3 4 5; do
    [ -f "$FSD/fleet.json" ] || break
    IFS= read -r -d '' fj < "$FSD/fleet.json"
    [[ $fj =~ $re_fon0 ]] && break
    [[ $fj =~ $re_mv ]] || break
    mvt="${BASH_REMATCH[1]//\\\\//}"
    case "$mvt" in /*|[A-Za-z]:/*) FSD="${mvt%/}" ;; *) break ;; esac
  done
  if [ -f "$FSD/fleet.json" ]; then   # rule 4: fleet on, so a superlite role is a worker, never an in-process Agent
    IFS= read -r -d '' fj < "$FSD/fleet.json"
    re_fon='"on"[[:space:]]*:[[:space:]]*true'
    if [[ $fj =~ $re_fon ]]; then
      # a fleet another session turned on (owner_session) is stale unless that session is still bound to FSD or runs in this Claude process
      re_os='"owner_session"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]{1,128})"'
      if [ -z "${SUPERLITE_STATE_DIR:-}" ] && [[ $fj =~ $re_os ]]; then
        fo="${BASH_REMATCH[1]}"; fp=""
        re_op='"owner_pid"[[:space:]]*:[[:space:]]*([0-9]+)'
        [[ $fj =~ $re_op ]] && fp="${BASH_REMATCH[1]}"
        re_sid='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]{1,128})"'
        fsid=""; [[ $input =~ $re_sid ]] && fsid="${BASH_REMATCH[1]}"
        if [ "$fo" != "$fsid" ] && { [ -z "$fp" ] || [ "$fp" != "${CLAUDE_PID:-}" ]; }; then
          _sl_line "${SUPERLITE_HOME:-$HOME/.superlite}/sessions/$fo"
          fb=""
          if [ -n "$SL_LINE" ]; then norm "$SL_LINE"; fb="$NORM"; fi
          norm "$FSD"
          [ "$fb" = "$NORM" ] || fstale=1
        fi
      fi
    fi
    if [ "$fstale" = 0 ] && [[ $fj =~ $re_fon ]]; then
      frole=""
      lower "$REPLY"; fname="${LOWER#superlite:}"   # `fixer-opus` and `Superlite:Fixer-Opus` name the same role
      case "$fname" in
        implementer) frole="implementer" ;;
        implementer-haiku) frole="implementer --tier haiku" ;;
        fixer-sonnet|fixer-sonnet-high|fixer-opus) frole="fixer --tier ${fname#fixer-}" ;;
        package-reviewer|final-reviewer) frole="$fname" ;;
        researcher) frole="research" ;;
        checker) frole="checker" ;;
        writer) frole="writer" ;;
      esac
      if [ -n "$frole" ]; then
        printf '{"kind":"rule-block","agent":"coordinator","tool":"%s","target":"%s (fleet on)","rule":"fleet","cwd":"%s"}\n' "$tool" "$REPLY" "$cwdv" \
          >> "$FSD/incidents.jsonl" 2>/dev/null
        again="It is blocked on every call while fleet is on: do not retry it."
        fread=" Fleet state read: $FSD0/fleet.json."
        [ "$FSD" = "$FSD0" ] || fread=" Fleet state read: $FSD0/fleet.json, moved to $FSD/fleet.json."
        if [ "$frole" = research ]; then
          printf '%s\n' "Blocked: fleet is on, so $REPLY runs as a fleet worker, not an in-process Agent call. $again Research path (fleet.md), one worker per prompt: write the prompt to $FSD/briefs/<name>.md; sl fleet spawn --role research --plan PLAN prints Wn; sl fleet send Wn --brief $FSD/briefs/<name>.md --plan PLAN; sl fleet wait Wn --plan PLAN (up to 9 min: Bash timeout 600000); the answer is in $FSD/fleet/reports/<name>.md. PLAN is the plan file, or $FSD before a plan exists. sl fleet off goes back to in-process agents.$fread" >&2
        elif [ "$frole" = writer ]; then
          printf '%s\n' "Blocked: fleet is on, so $REPLY runs as a fleet worker, not an in-process Agent call. $again Use: sl fleet spawn --role writer --brief <abs brief file> --plan PLAN (fleet.md); the brief's Output: line names the one file the writer may write. PLAN is the plan file, or $FSD for a build without a plan. sl fleet off goes back to in-process agents.$fread" >&2
        else
          printf '%s\n' "Blocked: fleet is on, so $REPLY runs as a fleet worker, not an in-process Agent call. $again Use: sl fleet spawn --role $frole --plan PLAN, then sl fleet send Wn --brief <abs brief> --plan PLAN (fleet.md). PLAN is the plan file, or $FSD for a build without a plan. sl fleet off goes back to in-process agents.$fread" >&2
        fi
        exit 2
      fi
    fi
  fi
  [ "$human" = 1 ] || exit 0
  case "$REPLY" in Explore|Plan|claude-code-guide) exit 0 ;; esac
  hit="Agent ${REPLY:-general-purpose}"
fi

norm "$proj"; projn="$NORM"; lower "$projn"; projl="$LOWER"

prot=0
tgt=""   # the path that made the guard block, as written; empty when a command was judged
# dotres PATH: absolute PATH with . and .. segments resolved lexically, into RES.
dotres() {
  local -a st=(); local s n IFS=/
  set -f
  for s in $1; do
    case "$s" in ''|.) ;; ..) n=${#st[@]}; [ "$n" -gt 0 ] && unset "st[$((n - 1))]" ;; *) st[${#st[@]}]="$s" ;; esac
  done
  set +f
  RES="/${st[*]}"
}
# cache_hit PATH: succeeds when PATH (absolute, or ~/...) lies in the folder of the Python cache find_py reads; a fake
# interpreter written there would pass every command later. The folder is judged in every state.
cache_hit() {
  local p="$1" c lc
  case "$p" in '~/'*) p="$HOME/${p#\~/}" ;; esac
  case "$p" in /*) ;; *) return 1 ;; esac
  case "$p/" in */../*|*/./*) dotres "$p"; p="$RES" ;; esac
  lower "$p"; lc="$LOWER"
  for c in "${SUPERLITE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/superlite}" "$HOME/.cache/superlite"; do
    norm "$c"; lower "$NORM"
    case "$lc" in "$LOWER"|"$LOWER"/*) return 0 ;; esac
  done
  return 1
}

# rel_ok REL: succeeds when the coordinator may write the canonical project-relative REL (also below a linked worktree
# in the project); sets prot=1 when REL is a protected file.
rel_ok() {
  lower "$1"
  case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) prot=1; return 1 ;; esac
  allowed_rel "$1" && return 0
  if wt_rel "$1"; then
    lower "$WREL"
    case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) prot=1; return 1 ;; esac
    allowed_rel "$WREL" && return 0
  fi
  return 1
}

# link_deny REL: for a REL the text rules allow, succeeds when the write still lands elsewhere: a path component that is
# a symlink whose real target lies outside the allowed set (or cannot be resolved), or an existing file with more than
# one hard link (its other names are unknown). Only symlink tests (builtins) on the common path; one resolve for a
# symlink, one stat for an existing file.
link_deny() {
  local r="$1" pre="" found=0 real rp rpl n target="$projn/$1"
  while :; do
    pre="${pre:+$pre/}${r%%/*}"
    [ -L "$projn/$pre" ] && { found=1; break; }
    [[ $r == */* ]] || break
    r="${r#*/}"
  done
  if [ "$found" = 1 ]; then
    real="$(readlink -f "$target" 2>/dev/null || realpath "$target" 2>/dev/null)"
    rp="$(cd -P "$projn" 2>/dev/null && pwd -P)"
    [ -n "$real" ] && [ -n "$rp" ] || return 0
    real="${real//\\//}"
    lower "$rp"; rpl="$LOWER"; lower "$real"
    case "$LOWER" in "$rpl"/*) real="${real:$((${#rp}+1))}" ;; *) return 0 ;; esac
    rel_ok "$real" || return 0
    target="$rp/$real"
  fi
  if [ -f "$target" ]; then
    n="$(stat -c %h "$target" 2>/dev/null || stat -f %l "$target" 2>/dev/null)"
    [ "${n:-1}" -gt 1 ] 2>/dev/null && return 0
  fi
  return 1
}

# prot_abs PATH: succeeds when absolute PATH names a protected file (orchestrator.json, human-replies.jsonl, backlog.json)
# in this session's state folder or in $SUPERLITE_FLEET_PARENT_DIR, wherever the folders lie (#190): compared as written
# (normalized, lower case), then, only when that does not match, both sides resolved with `cd -P` in a subshell.
prot_abs() {
  local p="$1" b d dl t tl rd rt
  case "$p" in /*) ;; *) return 1 ;; esac
  case "$p/" in */../*|*/./*) dotres "$p"; p="$RES" ;; esac
  b="${p##*/}"; d="${p%/*}"; lower "$b"
  case "$LOWER" in orchestrator.json|human-replies.jsonl|backlog.json|render-edits.json) ;; *) return 1 ;; esac
  norm "$d"; lower "$NORM"; dl="$LOWER"
  for t in "$sd" "${SUPERLITE_FLEET_PARENT_DIR:-}"; do
    [ -n "$t" ] || continue
    norm "$t"; lower "$NORM"; [ "$LOWER" = "$dl" ] && return 0
  done
  rd="$(cd -P "$d" 2>/dev/null && pwd -P)" || return 1
  [ -n "$rd" ] || return 1
  lower "$rd"; rd="$LOWER"
  for t in "$sd" "${SUPERLITE_FLEET_PARENT_DIR:-}"; do
    [ -n "$t" ] || continue
    rt="$(cd -P "$t" 2>/dev/null && pwd -P)" || continue
    lower "$rt"; [ "$LOWER" = "$rd" ] && return 0
  done
  return 1
}

# link_prot REL: for a project-relative REL with a symlinked component, succeeds when the write lands on a protected
# file: the resolved target is a protected name project-relative (also below a linked worktree), or prot_abs says so.
link_prot() {
  local r="$1" pre="" found=0 real rp rpl rel2
  while :; do
    pre="${pre:+$pre/}${r%%/*}"
    [ -L "$projn/$pre" ] && { found=1; break; }
    [[ $r == */* ]] || break
    r="${r#*/}"
  done
  [ "$found" = 1 ] || return 1
  real="$(readlink -f "$projn/$1" 2>/dev/null || realpath "$projn/$1" 2>/dev/null)"
  [ -n "$real" ] || return 1
  real="${real//\\//}"
  prot_abs "$real" && return 0
  rp="$(cd -P "$projn" 2>/dev/null && pwd -P)"
  [ -n "$rp" ] || return 1
  lower "$rp"; rpl="$LOWER"; lower "$real"
  case "$LOWER" in "$rpl"/*) rel2="${real:$((${#rp}+1))}" ;; *) return 1 ;; esac
  lower "$rel2"
  case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) return 0 ;; esac
  if wt_rel "$rel2"; then
    lower "$WREL"
    case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) return 0 ;; esac
  fi
  return 1
}

# project_code PATH: succeeds when writing PATH (the file_path or notebook_path of an Edit, Write or NotebookEdit call)
# is denied; sets prot=1 for the protected files. A relative path is the project's own.
project_code() {
  local p rel pl rl v1='$CLAUDE_PROJECT_DIR' v2='${CLAUDE_PROJECT_DIR}'
  norm "$1"; p="$NORM"; p="${p%\"}"; p="${p#\"}"; p="${p%\'}"; p="${p#\'}"
  p="${p//"$v2"/$projn}"; p="${p//"$v1"/$projn}"
  cache_hit "$p" && { prot=2; return 0; }
  prot_abs "$p" && { prot=1; return 0; }
  if [[ $p == /* && -L $p ]]; then   # an absolute link (also outside the project) to a protected run file
    rl="$(readlink -f "$p" 2>/dev/null || realpath "$p" 2>/dev/null)"
    [ -n "$rl" ] && prot_abs "${rl//\\//}" && { prot=1; return 0; }
  fi
  case "$p" in ''|*'$'*|'~'*|/dev/*|-*) return 1 ;; esac
  case "$p" in /*|[A-Za-z]:[/\\]*) ;; *) case "/$p/" in */../*|*/./*) p="$projn/${p#./}" ;; esac ;; esac
  case "$p" in   # any absolute path with . or .. segments is judged resolved
    /*) case "$p/" in */../*|*/./*) dotres "$p"; p="$RES" ;; esac ;;
  esac
  prot_abs "$p" && { prot=1; return 0; }   # a relative path with .. that leaves the project, now absolute
  case "$p" in
    /*) lower "$p"; pl="$LOWER"
        case "$pl" in "$projl"/*) rel="${p:$((${#projn}+1))}" ;; *) return 1 ;; esac ;;
    *) rel="${p#./}" ;;
  esac
  case "$rel" in ''|.|..|../*) return 1 ;; esac
  lower "$rel"; pl="$LOWER"
  case "$pl" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) prot=1; return 0 ;; esac
  if [ "$human" != 1 ] && [ "$active" != 1 ]; then   # idle: only the protected files, also in a worktree or through a link
    if wt_rel "$rel"; then
      lower "$WREL"
      case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) prot=1; return 0 ;; esac
    fi
    link_prot "$rel" && { prot=1; return 0; }
    return 1
  fi
  case "/$rel/" in */../*|*/./*) return 0 ;; esac   # docs/../src/a.py is not under docs/
  render_listed "$rel" && ! link_deny "$rel" && return 1   # a throwaway render edit recorded by `sl render_edit start`
  if allowed_rel "$rel"; then link_deny "$rel"; return; fi   # allowed by its text: still through a link?
  if wt_rel "$rel"; then   # a linked worktree inside the project: judged from its root
    lower "$WREL"
    case "$LOWER" in .superlite/human-replies.jsonl|.superlite/orchestrator.json|.superlite/backlog.json|.superlite/render-edits.json) prot=1; return 0 ;; esac
    if allowed_rel "$WREL"; then link_deny "$rel"; return; fi
  fi
  return 0
}

# render_listed REL: succeeds when an active run's .superlite/render-edits.json holds the quoted key "REL": {.
render_listed() {
  local rj=""
  [ "$active" = 1 ] && [ "$human" != 1 ] && [ -f "$sd/render-edits.json" ] || return 1
  IFS= read -r -d '' rj < "$sd/render-edits.json"
  [[ $rj == *"\"$1\": {"* ]]
}

# allowed_rel REL: succeeds when the coordinator may write the project-relative REL in the guard's state.
allowed_rel() {
  if [ "$human" = 1 ]; then
    case "$1" in docs/plans/*.review.md|docs/*/plans/*.review.md|.superlite/*|.git/info/exclude) return 0 ;; esac
    return 1
  fi
  case "$1" in docs/plans/*|docs/*/plans/*|docs/*.md|docs/*.png|docs/*.jpg|docs/*.jpeg|docs/*.gif|docs/*.svg|docs/*.webp|SPEC*.md|*/SPEC*.md|docs.md|*/docs.md|.superlite/*|.git/info/exclude) return 0 ;; esac
  return 1
}

# wt_rel REL: REL below the deepest linked worktree root it lies in (a folder whose .git file points into a
# .../worktrees/<name> folder; a submodule's points into .../modules/...) into WREL; fails when it lies in none.
wt_rel() {
  local r="$1" pre="" line ok=1
  WREL=""
  while [[ $r == */* ]]; do
    pre="${pre:+$pre/}${r%%/*}"; r="${r#*/}"
    [ -f "$projn/$pre/.git" ] || continue
    line=""; IFS= read -r line < "$projn/$pre/.git" || true
    line="${line//\\//}"; line="${line%/}"
    case "$line" in gitdir:*/worktrees/*/*) ;; gitdir:*/worktrees/*) WREL="$r"; ok=0 ;; esac
  done
  return $ok
}

# guard_error WHAT: appends a guard-error incident; the caller then fails open.
guard_error() {
  local w="${1:0:160}"
  w="${w//[[:cntrl:]]/ }"; w="${w//[\"\\]/}"
  printf '{"kind":"guard-error","agent":"coordinator","tool":"%s","target":"%s"}\n' "$tool" "$w" \
    >> "$sd/incidents.jsonl" 2>/dev/null
}

# find_py [nocache]: the Python 3.10+ that runs the judge, into PY (an array; empty when none is found), the way
# skills/subagent-driven-development/scripts/sl finds it: $SUPERLITE_PYTHON (no version check), else the interpreter
# sl cached for this PATH, working directory and VIRTUAL_ENV (the same file) and only while it is the file `command -v
# python3` or `command -v python` finds (a planted cache names another), else the first of python3, python,
# `py -3` and `uv run --no-project python` that is 3.10+, whose real path is cached for the next call. `nocache` skips
# the cached interpreter (it lies outside the project, so the model may have planted a fake there) and rewrites it.
find_py() {
  local cache_dir="${SUPERLITE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/superlite}" cache cached="" ckey="" key exe cand
  local -a c
  cache="$cache_dir/python"; key="${PATH}|${PWD}|${VIRTUAL_ENV:-}"
  PY=()
  if [ -n "${SUPERLITE_PYTHON:-}" ]; then
    if [ -f "$SUPERLITE_PYTHON" ]; then PY=("$SUPERLITE_PYTHON"); else read -r -a PY <<< "$SUPERLITE_PYTHON"; fi
    { [ -x "${PY[0]:-}" ] || command -v "${PY[0]:-}" >/dev/null 2>&1; } && return 0
    PY=()
  fi
  if [ "${1:-}" != nocache ] && [ -f "$cache" ]; then
    { IFS= read -r cached; IFS= read -r ckey; } < "$cache" 2>/dev/null || true
    if [ -n "$cached" ] && [ "$ckey" = "$key" ] && [ -x "$cached" ]; then
      for cand in python3 python; do   # trusted only when it is the interpreter this PATH finds (same file, links followed)
        exe="$(command -v "$cand" 2>/dev/null)" && [ -n "$exe" ] && [ "$cached" -ef "$exe" ] && { PY=("$cached"); return 0; }
      done
    fi
  fi
  for cand in python3 python "py -3" "uv run --no-project python"; do
    read -r -a c <<< "$cand"
    command -v "${c[0]}" >/dev/null 2>&1 || continue
    exe="$("${c[@]}" -c 'import sys; sys.exit(1) if sys.version_info < (3, 10) else print(sys.executable.replace("\\", "/"))' 2>/dev/null)" || continue
    [ -n "$exe" ] || continue
    if [ -x "$exe" ]; then
      if mkdir -p "$cache_dir" 2>/dev/null; then
        printf '%s\n%s\n' "$exe" "$key" > "$cache.$$" 2>/dev/null && mv -f "$cache.$$" "$cache" 2>/dev/null
      fi
      PY=("$exe")
    else PY=("${c[@]}")
    fi
    return 0
  done
  return 1
}

# scratch_hint: the message line that names the coordinator's throwaway-script folder (#690): project-relative when the
# state folder lies under the project, else absolute. Builtins only.
scratch_hint() {
  local S="$sd/scratch"
  case "$sd" in "$proj"/*) S="${sd#"$proj"/}/scratch" ;; esac
  printf '%s\n' "- A throwaway script (count lines, compare outputs, time a command): write it under $S/ and run it from there. The folder is git-ignored and \`sl orchestrator end\` removes it; a run of a script there is judged like a heredoc script, so it may read the project but not write project code. A subprocess call whose program is not a string literal (\`[prog, ...]\`) is judged unknown; a list name bound once to a literal list (used only as the call's argument or a \`*\` splat) counts as that list, \`sys.executable\` as python3, and a later argument that is not a literal is judged like an unknown shell variable."
}

# scratch_esc S: S as JSON string content into ESC (backslash, quote, tab and CR escaped); fails when another control
# character is left. Builtins only.
scratch_esc() {
  local s="$1" bs='\' dq='"' tab=$'\t' cr=$'\r'
  s=${s//"$bs"/"$bs$bs"}; s=${s//"$dq"/"$bs$dq"}; s=${s//"$tab"/"${bs}t"}; s=${s//"$cr"/"${bs}r"}
  ESC="$s"
  [[ $s != *[[:cntrl:]]* ]]
}

# scratch_inline: sets jin, the hook JSON the judge reads. While the guard enforces, a Bash command that names a script in
# $sd/scratch (or one folder below) gets that script's text in front of it as a heredoc, so the judge sees what the run
# executes (#690). Skipped: symlinks, files over 65536 characters or with a NUL byte, non-script data files, and every
# file past the 64th examined. Builtins only; nullglob is restored.
scratch_inline() {
  jin="$input"
  [ "$tool" = Bash ] && [ "$enforce" = 1 ] || return 0
  local had=0 f b n=0 seen=0 pre="" body D t ok re m rest ln k c
  local bs='\' sq="'" nl=$'\n'
  shopt -q nullglob && had=1
  shopt -s nullglob
  for f in "$sd"/scratch/* "$sd"/scratch/*/*; do
    seen=$((seen + 1))
    [ "$seen" -le 64 ] || break
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    b="${f##*/}"
    [[ $cmd == *"$b"* ]] || continue
    ok=0
    case "$b" in *.py|*.sh|*.bash|*.zsh|*.js|*.mjs|*.cjs|*.ts|*.pl|*.rb|*.php) ok=1 ;; esac
    { [ "$ok" = 1 ] || [ -x "$f" ]; } || continue
    body=""
    IFS= read -r -d '' -n 65537 body < "$f"
    [ $? = 1 ] || continue
    D="SL_SCRATCH_$((n + 1))"
    while [[ "$nl$body$nl" == *"$nl$D$nl"* ]]; do D="SL_SCRATCH_$((n + 1))_$RANDOM"; done
    t=${f//"$sq"/"$sq$bs$sq$sq"}   # an assignment: bash 3.2 keeps the inner quotes literal in a double-quoted ${//}
    scratch_esc "cat > '$t' <<'$D'" || continue
    t="$ESC${bs}n"
    ok=1; k=0; c=""
    # line by line: bash 3.2 rescans a 60 KB string for every replacement and copies it for every append, so the escaping
    # runs on short lines and a chunk of 64 lines is appended to the long string (linear)
    while IFS= read -r ln || [ -n "$ln" ]; do
      scratch_esc "$ln" || { ok=0; break; }
      c="$c$ESC${bs}n"
      k=$((k + 1))
      [ $((k % 64)) = 0 ] && { t="$t$c"; c=""; }
    done < "$f"
    [ "$ok" = 1 ] || continue
    scratch_esc "$D" || continue
    t="$t$c$ESC${bs}n"
    pre="$pre$t"
    n=$((n + 1))
  done
  [ "$had" = 1 ] || shopt -u nullglob
  re='"command"[[:space:]]*:[[:space:]]*"'
  if [ -n "$pre" ] && [[ $input =~ $re ]]; then
    m="${BASH_REMATCH[0]}"
    rest="${input#*"$m"}"
    jin="${input:0:$(( ${#input} - ${#rest} ))}$pre$rest"
  fi
}

# run_judge MODE: runs guard_judge.py on the hook input. Exit 2 is its block (its output is the message, passed on);
# 0 allows only with the judge's `guard: ok NONCE` line: an exit 0 without it (a fake interpreter in the cache) re-probes
# Python without the cache and runs the judge once more. Any other outcome fails open after a guard-error incident.
# Never returns.
run_judge() {
  local judge="${BASH_SOURCE[0]%/*}/../skills/subagent-driven-development/scripts/guard_judge.py" out rc try
  local nonce="$RANDOM$RANDOM$$$RANDOM" nlh=$'\n' fc bc tail
  [ -f "$judge" ] || { guard_error "guard_judge.py not found"; exit 0; }
  find_py || { guard_error "no Python 3.10+ found"; exit 0; }
  for try in 1 2; do
    out="$(printf '%s' "$jin" | SUPERLITE_GUARD_NONCE="$nonce" "${PY[@]}" -I -X utf8 -W ignore "$judge" --mode "$1" --project "$proj" --sd "$sd" 2>&1)"   # -W ignore: one SyntaxWarning per invalid escape of an inlined script would fill the message
    rc=$?
    case "$rc" in
      2) if [ "$jin" != "$input" ] && [[ $out == *"${nlh}Blocked command: "* ]]; then   # the judge read the inlined heredocs: name the typed command
           fc="${cmd:0:4096}"; fc="${fc//$'\r'/ }"; fc="${fc//$'\n'/ }"; fc="${fc//$'\t'/ }"; fc="${fc//[[:cntrl:]]/}"; fc="${fc:0:120}"
           fc="${fc#"${fc%%[! ]*}"}"; fc="${fc%"${fc##*[! ]}"}"
           bc="${out##*"${nlh}Blocked command: "}"; tail=""
           [[ $bc == *"$nlh"* ]] && tail="$nlh${bc#*"$nlh"}"
           out="${out%"${nlh}Blocked command: "*}${nlh}Blocked command: $fc$tail"
         fi
         printf '%s\n' "$out" >&2; exit 2 ;;
      0) [[ $out == *"guard: ok $nonce"* ]] && exit 0
         [ "$try" = 1 ] || break
         find_py nocache || { guard_error "no Python 3.10+ found"; exit 0; } ;;
      *) guard_error "guard_judge.py exited $rc: ${out##*$'\n'}"; exit 0 ;;
    esac
  done
  guard_error "guard_judge.py exited 0 without its ok line"
  exit 0
}

if [ -z "$hit" ] && [ "$tool" != Bash ] && [ "$tool" != PowerShell ]; then
  jstr file_path; f="$REPLY"
  if [ -z "$f" ]; then jstr notebook_path; f="$REPLY"; fi
  [ -n "$f" ] || exit 0
  project_code "$f" && { hit="$f"; tgt="$f"; }
elif [ -z "$hit" ]; then
  jstr command; cmd="$REPLY"
  [ -n "$cmd" ] || exit 0
  cmd="${cmd//\\\\/$'\x01'}"   # JSON \\ first, so \\" and \\n keep their shell meaning
  cmd="${cmd//\\\"/\"}"; cmd="${cmd//\\t/ }"; cmd="${cmd//\\r/}"; cmd="${cmd//\\n/$'\n'}"
  cmd="${cmd//$'\x01'/\\}"
  lower "$cmd"; lc="$LOWER"
  bare=${lc//\'/}; bare=${bare//\"/}; bare=${bare//\\/}   # orchestrator.js''on and orchestrator.j\son name it too
  mentions=0
  [[ $bare == *human-replies.jsonl* || $bare == *orchestrator.json* || $bare == *backlog.json* || $bare == *render-edits.json* || $bare == *.superlite* ]] && mentions=1
  [[ $bare == *superlite* && $bare == *python* ]] && mentions=1   # the Python cache folder: ~/.cache/superlite/python
  if [ "$enforce" = 0 ] && [ "$mentions" = 0 ]; then
    # $'\x6f...' may spell a protected name, and a glob or brace near .superlite may reach one (.superlite/orch*)
    re_g='[][*?{]'; re_w='[^[:space:];&|<>()]*'
    re_near="(superl|\\.s)${re_w}${re_g}|${re_g}${re_w}(superl|\\.s)|(^|[[:space:]/=,{])\\.${re_g}"
    nob=${bare//\$\{/}   # ${VAR} is no brace
    if [[ $cmd == *"\$'"* ]]; then
      mentions=1
    elif [[ $nob =~ $re_g ]]; then
      jstr cwd
      { [[ $nob =~ $re_near ]] || [[ $REPLY == *.superlite* ]]; } && mentions=1
    fi
  fi
  # sl tools that start a build are denied until the plan is approved.
  re_sl='(sl|\$SL|\$\{SL\}|scripts/sl)"?[[:space:]]+(dispatch|assign|wave0|commit_task|finish|build_prime|run_tests)([[:space:]]|$)'
  if [ "$human" = 1 ] && [[ $cmd =~ $re_sl ]]; then
    hit="sl ${BASH_REMATCH[2]}"
  elif [ "$enforce" = 1 ] || [ "$mentions" = 1 ]; then   # a command that names a protected file is judged in every state
    mode=idle
    [ "$active" = 1 ] && mode=active
    [ "$human" = 1 ] && mode=human
    scratch_inline
    run_judge "$mode"
  fi
fi

[ -n "$hit" ] || exit 0

# #599: an Edit/Write the rules block in an active run still passes when it names a file the run's inline (one-task) plan
# owns; the judge decides (`--owns`), and any doubt, error or missing ack keeps the block.
if [ "$active" = 1 ] && [ "$human" = 0 ] && [ "$prot" = 0 ] && [ -n "$tgt" ] && { [ "$tool" = Edit ] || [ "$tool" = Write ]; }; then
  judge="${BASH_SOURCE[0]%/*}/../skills/subagent-driven-development/scripts/guard_judge.py"
  if [ -f "$judge" ] && find_py; then
    nonce="$RANDOM$RANDOM$$$RANDOM"
    out="$(SUPERLITE_GUARD_NONCE="$nonce" "${PY[@]}" -I -X utf8 "$judge" --mode active --project "$proj" --sd "$sd" --owns "$tgt" </dev/null 2>/dev/null)"
    [ $? = 0 ] && [[ $out == *"guard: ok $nonce"* ]] && exit 0
  fi
fi

hit="${hit:0:120}"; hit="${hit//[\"\\$'\n\r\t']/}"
rule=code
[ "$human" = 1 ] && rule=human
[ "$prot" = 1 ] && rule=protected
[ "$prot" = 2 ] && rule=cache
printf '{"kind":"rule-block","agent":"coordinator","tool":"%s","target":"%s","rule":"%s","cwd":"%s"}\n' "$tool" "$hit" "$rule" "$cwdv" \
  >> "$sd/incidents.jsonl" 2>/dev/null

if [ "$prot" = 2 ]; then
  printf '%s\n' 'Blocked: the Python interpreter cache of superlite (~/.cache/superlite) is never written by the coordinator.' >&2
elif [ "$prot" = 1 ]; then
  printf '%s\n' \
    'Blocked: .superlite/orchestrator.json and .superlite/human-replies.jsonl are never written directly. Change the orchestrator state only with `sl orchestrator ...` (for example `sl orchestrator approve --review <path>`); human-replies.jsonl is written only by the hook that records the human'"'"'s replies. .superlite/backlog.json is changed only by `sl backlog ...`.' >&2
elif [ "$human" = 1 ]; then
  printf '%s\n' \
    'Human orchestrator: no build starts until the human approves the plan. Write the review plan docs/plans/<date>-<topic>.review.md (see skills/writing-plans/review-plan.md), show its path with a five-line summary, ask the human to reply approve, end your turn, then run sl orchestrator approve --review <path>.' >&2
else
  printf '%s\n' \
    'Blocked: the superlite coordinator must not write project code. Dispatch it instead:' \
    '- Fix: give a fixer a finding id F-<Tn>-<n>, tiered per skills/subagent-driven-development/fixing.md: known cause, one module -> fixer-sonnet; cross-module -> fixer-sonnet-high; unknown cause -> fixer-opus. A brief you write by hand goes to .superlite/briefs/fix-<id>.md (`sl findings route` writes them for you); .superlite/fixes/<id>.md holds only the note the fixer writes itself.' \
    '- Wave 0 skeleton/stub/config files belong to an implementer-haiku task.' \
    '- New code belongs to an implementer task. You may write only docs/plans/**, docs/*/plans/**, SPEC*.md, docs/**/*.md, docs/** images (png, jpg, jpeg, gif, svg, webp), any docs.md and .superlite/**, rm a file or folder git does not track and no task Owns, and write or rm a git-ignored path no task Owns.' \
    "- An inline build (the run's plan holds exactly one task): you may write that task's Owns yourself." \
    '- A throwaway edit to check a render: `sl render_edit start <file>` records it and allows the edit; `sl render_edit restore` undoes it.' \
    "$(scratch_hint)" \
    '- After the run, `sl orchestrator end` archives the run markers and the guard stops; never delete .superlite by hand.' >&2
fi
if [ "$prot" != 1 ]; then   # (prot 2, the cache, names its target too)   name what was judged: a path as "target", a command as "command"
  tgt="${tgt//[[:cntrl:]]/}"
  tgt="${tgt%\"}"; tgt="${tgt#\"}"; tgt="${tgt%\'}"; tgt="${tgt#\'}"
  lower "$tgt"
  case "$LOWER" in "$projl"/*) tgt="${tgt:$((${#projn}+1))}" ;; esac   # project-relative
  case "$tgt" in ./*) tgt="${tgt#./}" ;; esac
  hit="${hit//[[:cntrl:]]/}"
  if [ -n "$tgt" ]; then printf 'Blocked target: %s\n' "$tgt" >&2
  else printf 'Blocked command: %s\n' "$hit" >&2
  fi
fi
exit 2
