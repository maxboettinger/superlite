#!/usr/bin/env bash
# UserPromptSubmit hook: while a human-orchestrator run is unapproved (.superlite/orchestrator.json
# has mode human and approved false), append one line per human prompt to
# <project>/.superlite/human-replies.jsonl:
#   {"t":<epoch ms>,"approves":true|false,"text":"<first 160 chars of the prompt>"}
# approves is true when no veto word appears (case-insensitive, whole words: not, don't, dont, no,
# wait, stop, but, change, instead; nein, nicht, kein, keine, aber, warte, warten, moment, stopp,
# ändere, ändern, änderung, aendere, aendern, statt, stattdessen) and either a strong phrase appears
# anywhere (approve, approved, yes, go ahead, go for it, looks good, lgtm, proceed, ship it, do it,
# genehmigt, freigegeben, leg los, sieht gut aus) or the reply is short (<= 80 chars, no ?) and made
# only of yes-words (ok, sure, ja, passt, mach, ...) and fillers (so, bitte, thanks, ...), one at least
# a yes-word. JSON \uXXXX umlaut escapes and curly apostrophes are decoded first so a veto cannot hide.
# Only this hook writes the file.
# Bash builtins only (each external process costs ~250 ms on Windows). Never blocks: exit 0 always.
# stdin is bounded three ways: a terminal exits at once, the read gives up after 5 s, input is cut at 1 MiB.

[ -t 0 ] && exit 0   # a terminal is never hook input
IFS= read -r -d '' -t 5 input   # builtin; status ignored (1 at EOF, >128 on timeout)
[ ${#input} -le 1048576 ] || input="${input:0:1048576}"
[ -n "$input" ] || exit 0   # nothing arrived (silent pipe): no reply to record
[ -n "${SUPERLITE_FLEET_WORKER:-}" ] && exit 0   # a fleet pane prompt is never a human reply

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' s
  REPLY=""
  [[ $input =~ $re ]] || return 0
  s="${BASH_REMATCH[1]}"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"
[ -f "$sd/orchestrator.json" ] || exit 0
IFS= read -r -d '' oj < "$sd/orchestrator.json"
re_human='"mode"[[:space:]]*:[[:space:]]*"human"'
re_unappr='"approved"[[:space:]]*:[[:space:]]*false'
[[ $oj =~ $re_human && $oj =~ $re_unappr ]] || exit 0

jstr prompt; text="$REPLY"
# bash 3.2 (stock macOS) has no ${var,,}: use tr (C locale: umlauts and curly quotes are folded below).
lc="$(printf '%s' "$text" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
lc="${lc//Ä/ä}"; lc="${lc//Ö/ö}"; lc="${lc//Ü/ü}"
lc="${lc//\\u00e4/ä}"; lc="${lc//\\u00c4/ä}"; lc="${lc//\\u00f6/ö}"; lc="${lc//\\u00d6/ö}"
lc="${lc//\\u00fc/ü}"; lc="${lc//\\u00dc/ü}"
q="'"; lc="${lc//\\u2019/$q}"; lc="${lc//’/$q}"
b='(^|[^[:alnum:]_])'; e='([^[:alnum:]_]|$)'
re_yes="$b(approve|approved|yes|go[[:space:]]+ahead|go[[:space:]]+for[[:space:]]+it|looks[[:space:]]+good|lgtm|proceed|ship[[:space:]]+it|do[[:space:]]+it|genehmigt|freigegeben|leg[[:space:]]+los|sieht[[:space:]]+gut[[:space:]]+aus)$e"
re_no="$b(not|don't|dont|no|wait|stop|but|change|instead|nein|nicht|kein|keine|aber|warte|warten|moment|stopp|ändere|ändern|änderung|aendere|aendern|statt|stattdessen)$e"
yw='ok|okay|sure|yep|yeah|fine|good|great|perfect|alright|go|ja|jo|jep|passt|mach|machs|los|klar|gut|genau|gerne|gern|perfekt|super|prima|weiter|einverstanden'
fw='so|das|es|s|it|that|let|lets|bitte|please|danke|thanks|dann|then|mal|doch|sounds|klingt|for|me|für|mich|mir|sehr|very|yes|approve'
s='[[:space:][:punct:]]'
re_short="^$s*(($yw|$fw)$s+)*($yw)($s+($yw|$fw))*$s*\$"
approves=false
if ! [[ $lc =~ $re_no ]]; then
  [[ $lc =~ $re_yes ]] && approves=true
  [ "$approves" = true ] || { [ ${#lc} -le 80 ] && [[ $lc != *\?* ]] && [[ $lc =~ $re_short ]] && approves=true; }
fi

text="${text:0:160}"
text="${text//\\/\\\\}"; text="${text//\"/\\\"}"
now="${EPOCHREALTIME//[.,]/}"; now="${now%???}"   # epoch ms
# bash 3.2 (stock macOS) has no EPOCHREALTIME: date's %N (GNU, newer macOS), else perl, else whole seconds.
[[ $now =~ ^[0-9]{13,}$ ]] || { now="$(date +%s%N)"; now="${now%??????}"; }
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000' 2>/dev/null)"
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(date +%s)000"
printf '{"t":%s,"approves":%s,"text":"%s"}\n' "$now" "$approves" "$text" >> "$sd/human-replies.jsonl" 2>/dev/null
exit 0
