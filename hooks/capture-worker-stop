#!/usr/bin/env bash
# Stop hook for fleet workers: when SUPERLITE_FLEET_WORKER is set, append one stop record to <state dir>/metrics.jsonl:
#   {"ev":"stop","t":<epoch ms>,"agent_id":<worker id>,"type":"fleet:<agent>","transcript":<path>,"last":<max 160 chars>}
# Writes nothing outside a worker or when stop_hook_active is true.
# Bash builtins only. Never blocks: always exits 0.

[ -n "${SUPERLITE_FLEET_WORKER:-}" ] || exit 0
IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' s
  REPLY=""
  [[ $input =~ $re ]] || return 0
  s="${BASH_REMATCH[1]}"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}
# esc VAR: JSON-escape the string in VAR.
esc() {
  local s="${!1}"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/ }"; s="${s//$'\r'/}"; s="${s//$'\t'/ }"
  printf -v "$1" '%s' "$s"
}

re_active='"stop_hook_active"[[:space:]]*:[[:space:]]*true'
[[ $input =~ $re_active ]] && exit 0

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"
[ -d "$sd" ] || exit 0

id="$SUPERLITE_FLEET_WORKER"; type="fleet:${SUPERLITE_FLEET_AGENT:-unknown}"
jstr transcript_path; tr="${REPLY//\\//}"
jstr last_assistant_message; last="${REPLY:0:160}"
esc id; esc type; esc tr; esc last

now="${EPOCHREALTIME//[.,]/}"; now="${now%???}"   # epoch ms
# bash 3.2 (stock macOS) has no EPOCHREALTIME: date's %N (GNU, newer macOS), else perl, else whole seconds.
[[ $now =~ ^[0-9]{13,}$ ]] || { now="$(date +%s%N)"; now="${now%??????}"; }
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000' 2>/dev/null)"
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(date +%s)000"
printf '{"ev":"stop","t":%s,"agent_id":"%s","type":"%s","transcript":"%s","last":"%s"}\n' \
  "$now" "$id" "$type" "$tr" "$last" >> "$sd/metrics.jsonl" 2>/dev/null
exit 0
