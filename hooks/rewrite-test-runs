#!/usr/bin/env bash
# PreToolUse hook (Bash): during an active superlite run, rewrite the COORDINATOR's raw test runs
# (pytest, npm test, npx vitest|jest, go test, cargo test, dotnet test, ...) into a background
# `sl run_tests --full`, or `sl run_tests --fast <files>` when the raw command names test/source paths.
# Subagents (agent_id) and fleet workers (SUPERLITE_FLEET_WORKER): bare full-suite runners are DENIED (exit 2), and so is a
# run of the project's own test command (.superlite/test-cmd.json) on an isolate stack (language swift, go, rust or
# csharp: a sibling's half-edit breaks a shared build); the message gives `sl run_tests --fast <files> --task <Tn>`,
# the task read from pool.json. A collect-only run (--collect-only, --co) lists tests without running them and passes for
# everyone, unrewritten. Other subagent calls are untouched.
# Commands that already contain run_tests, and sessions without a run marker (stable.json,
# prime.md or pool.json in the state folder) are untouched. Chained commands keep their other work: only the test segment
# is replaced, separators stay, and the whole command then runs in the background. Anything ambiguous
# (odd quotes, heredocs, \u escapes) passes unchanged. A pytest -m EXPR (a word or one quoted string) stays on the rewritten command. Each rewrite is logged to
# $SL_SD/incidents.jsonl (rule-rewrite: target "<original> -> <rewritten>", rule, cwd, command, rewritten). DENIED instead (exit 2, rule-block incident): a known test
# runner inside an until/while loop, or a test run with stdout sent to /dev/null; also a subagent bare
# full suite. Only known runners match, so `until curl ...` and `until [ -f x ]` pass.
# A test run outside the plan root (the payload cwd, then each cd/pushd; a cwd above the plan root, such as the main
# checkout of a linked worktree, counts as inside), in a directory the hook cannot read (a variable, cd -, popd), or
# naming an absolute or .. path outside it, is left as written with no rewrite and no denial; a redirect target is
# never a test path.
# Bash builtins only (each external process costs ~250 ms on Windows). Exit 0 (fail open), except a denial (exit 2).

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine
shopt -u patsub_replacement 2>/dev/null   # bash 5.2+: `&` in a ${x//a/&} replacement must stay literal

fleet_worker=""
[ "${SUPERLITE_FLEET_ROLE:-}" = lead ] || fleet_worker="${SUPERLITE_FLEET_WORKER:-}"  # a lead is a coordinator
re_agent='"agent_id"[[:space:]]*:[[:space:]]*"'
has_agent=0
[[ $input =~ $re_agent ]] && has_agent=1
re_tool='"tool_name"[[:space:]]*:[[:space:]]*"Bash"'
[[ $input =~ $re_tool ]] || exit 0

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' s
  REPLY=""
  [[ $input =~ $re ]] || return 0
  s="${BASH_REMATCH[1]}"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/$'\n'}"; s="${s//\\r/}"; s="${s//\\t/	}"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}
# Working directory of the call (the payload's cwd), once, for the incident rows: no quote, backslash or control character, 300 characters at most.
jstr cwd
rawcwd="$REPLY"   # raw, for the directory walk (cwdv below drops backslashes)
cwdv="${REPLY//[[:cntrl:]]/}"; cwdv="${cwdv//[\"\\]/}"; cwdv="${cwdv:0:300}"
re_co='(^|[[:space:]])--(collect-only|co)([[:space:]]|$)'
# esc VAR: JSON-escape the string in VAR.
esc() {
  local s="${!1}"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/}"; s="${s//$'\t'/\\t}"
  printf -v "$1" '%s' "$s"
}

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"
[ -f "$sd/stable.json" ] || [ -f "$sd/prime.md" ] || [ -f "$sd/pool.json" ] || exit 0

# Directory walk: where each segment runs. here = normalized absolute directory ("" = unknown), here_in = 1 when a run
# there counts as inside the plan root (the root or below, or a directory above it such as the main checkout).
# norm_path P: absolute P with \ to /, // collapsed, . dropped, .. resolved, no trailing /, into REPLY.
norm_path() {
  local p="${1//\\//}" pre="" parts=() x out=() n=0 i
  if [[ $p =~ ^[A-Za-z]: ]]; then pre="${p:0:2}"; p="${p:2}"; fi
  IFS=/ read -r -a parts <<< "$p"
  for x in "${parts[@]}"; do
    case "$x" in
      ""|.) ;;
      ..) [ "$n" -gt 0 ] && { n=$((n-1)); unset 'out[n]'; } ;;
      *) out[n]="$x"; n=$((n+1)) ;;
    esac
  done
  REPLY=""
  for ((i=0; i<n; i++)); do REPLY="$REPLY/${out[i]}"; done
  REPLY="$pre${REPLY:-/}"
}
# real_of P: the physical path of P (nearest existing folder's real path plus the rest) into REPLY; 1 when unreadable.
real_of() {
  local d="$1" rest="" saved="$PWD"
  while [ -n "$d" ] && [ "$d" != / ] && [ ! -d "$d" ]; do rest="/${d##*/}$rest"; d="${d%/*}"; done
  [ -n "$d" ] || d=/
  builtin cd -P -- "$d" >/dev/null 2>&1 || return 1
  REPLY="${PWD%/}$rest"
  builtin cd -- "$saved" >/dev/null 2>&1
  return 0
}
# under_root P: 0 when the normalized absolute P is the plan root or below it.
under_root() {
  local p="$1" pr
  [ "$root_n" = / ] && return 0
  [[ $p == "$root_n" || $p == "$root_n"/* ]] && return 0
  if [ -z "${root_real+x}" ]; then
    root_real=""
    real_of "$root_n" && root_real="$REPLY"
  fi
  [ -n "$root_real" ] || return 1
  real_of "$p" || return 1
  pr="$REPLY"
  [[ $pr == "$root_real" || $pr == "$root_real"/* ]]
}
dir_start() {
  local c="${rawcwd//\\//}"
  here=""; here_in=0
  if [ -z "$c" ]; then here="$root_n"; here_in=1; return 0; fi
  case "$c" in /*|?:/*) ;; *) c="$root_n/$c" ;; esac
  norm_path "$c"; here="$REPLY"
  if [ "$here" = / ] || [[ $root_n == "$here"/* ]] || under_root "$here"; then here_in=1; return 0; fi
  # a cwd spelled through a symlink that holds the plan root: compare physical paths
  if [ -z "${root_real+x}" ]; then root_real=""; real_of "$root_n" && root_real="$REPLY"; fi
  if [ -n "$root_real" ] && real_of "$here" && { [ "$REPLY" = / ] || [[ $root_real == "$REPLY"/* ]]; }; then here_in=1; fi
}
re_lead='^[[:space:](){!]*(.*)$'
re_sq="^'([^']*)'([[:space:]]|\$)"
re_dq='^"([^"$`\\]*)"([[:space:]]|$)'
# dir_step SEG: a cd / pushd segment moves here; popd, cd -, ~user, or an operand with a variable or glob makes it unknown.
dir_step() {
  local s="$1" w op rest lit=0 tp='[![:space:])}]'
  [[ $s =~ $re_lead ]] && s="${BASH_REMATCH[1]}"
  s="${s%"${s##*$tp}"}"
  w="${s%%[[:space:]]*}"
  case "$w" in
    cd|pushd) ;;
    popd) here=""; here_in=0; return 0 ;;
    *) return 0 ;;
  esac
  rest="${s#"$w"}"
  while :; do
    rest="${rest#"${rest%%[![:space:]]*}"}"
    w="${rest%%[[:space:]]*}"
    case "$w" in -L|-P|-e|-@|--) rest="${rest#"$w"}"; continue ;; esac
    break
  done
  if [[ $rest =~ $re_sq ]]; then op="${BASH_REMATCH[1]}"; lit=1
  elif [[ $rest =~ $re_dq ]]; then op="${BASH_REMATCH[1]}"; lit=1
  else
    op="${rest%%[[:space:]]*}"
    case "$op" in *'$'*|*'`'*|*'\'*|*'*'*|*'?'*|*'['*|*'{'*|*'"'*|*"'"*) here=""; here_in=0; return 0 ;; esac
    case "$op" in -|"~"[!/]*) here=""; here_in=0; return 0 ;; esac
    case "$op" in
      "") op="${HOME//\\//}"; [ -n "$op" ] || { here=""; here_in=0; return 0; } ;;
      "~") op="${HOME//\\//}"; [ -n "$op" ] || { here=""; here_in=0; return 0; } ;;
      "~/"*) [ -n "$HOME" ] || { here=""; here_in=0; return 0; }; op="${HOME//\\//}/${op:2}" ;;
    esac
  fi
  op="${op//\\//}"
  case "$op" in
    /*|?:/*) norm_path "$op"; here="$REPLY" ;;
    *) if [ -n "$here" ]; then norm_path "$here/$op"; here="$REPLY"; else here_in=0; return 0; fi ;;
  esac
  here_in=0
  under_root "$here" && here_in=1
  return 0
}
# seg_out SEG: 0 when the segment runs outside the plan root, or a test run names an absolute or .. path outside it.
seg_out() {
  local w
  [ "$here_in" = 0 ] && return 0
  [[ $1 =~ $re_test ]] || return 1
  files_from_seg "$1"
  for w in $REPLY; do
    w="${w//\\//}"
    case "$w" in
      "~/"*) [ -n "$HOME" ] || continue; w="${HOME//\\//}/${w:2}" ;;
      /*|?:/*|..|../*|*/../*|*/..) ;;
      *) continue ;;
    esac
    case "$w" in /*|?:/*) ;; *) w="$here/$w" ;; esac
    norm_path "$w"
    under_root "$REPLY" || return 0
  done
  return 1
}
norm_path "$SL_PROJ"; root_n="$REPLY"
here=""; here_in=0

jstr command; cmd="$REPLY"
[ -n "$cmd" ] || exit 0
case "$cmd" in *run_tests*|*'<<'*|*'\u'*) exit 0 ;; esac

# Plugin root: CLAUDE_PLUGIN_ROOT, else the root of the plugin this hook file lives in.
root="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "$root" ]; then
  self="${BASH_SOURCE[0]//\\//}"
  case "$self" in /*|?:/*) ;; *) self="${PWD//\\//}/$self" ;; esac
  root="${self%/hooks/*}"
fi
root="${root//\\//}"
sl_base="bash \"$root/skills/subagent-driven-development/scripts/sl\" run_tests"
sl="$sl_base --full"

# A test segment: optional env assignments and runner prefix, then a known runner.
re_test='^[[:space:]]*([A-Za-z_][A-Za-z_0-9]*=[^[:space:]]*[[:space:]]+)*((uv|poetry|pipenv|pdm|hatch)[[:space:]]+run[[:space:]]+)?(((python[0-9.]*|py)([[:space:]]+-[0-9]+)?[[:space:]]+-m[[:space:]]+)?(pytest|py\.test|unittest)|((npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?test)|((npx|pnpm[[:space:]]+(exec|dlx)|bunx|yarn)[[:space:]]+(--no-install[[:space:]]+)?(vitest|jest))|(vitest|jest)|(go|cargo|dotnet)[[:space:]]+test)([[:space:]]|$)'
re_seg='^([^&|;'$'\n'']*)(&&|\|\||;|\||'$'\n''|&)(.*)$'

# files_from_seg SEG: path-like args after the runner into REPLY (empty = bare / full suite).
# A redirect operator (and the word after it) or a redirect glued to its target (>/tmp/x.log, 2>err.txt) is no test path.
ph1=$'\x02'; ph2=$'\x03'
re_redir_op='^[0-9]*(>>?|>\||<>?|<<<|'"$ph1|$ph2"'>?)$'
re_redir_glued='^[0-9]*(>|<|'"$ph1|$ph2"')'
files_from_seg() {
  local rest w skip=0
  REPLY=""
  [[ $1 =~ $re_test ]] || return 0
  rest="${1#"${BASH_REMATCH[0]}"}"
  for w in $rest; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    if [[ $w =~ $re_redir_op ]]; then skip=1; continue; fi
    [[ $w =~ $re_redir_glued ]] && continue
    case "$w" in
      -*|--[[:alnum:]-]*) continue ;;
      /dev/null|[Nn][Uu][Ll]|*/null) continue ;;  # redirects, not test paths
      */*|*\\*|*.py|*.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.go|*.rs|*.rb|*.cs) REPLY="${REPLY:+$REPLY }$w" ;;
    esac
  done
}

# A pytest marker after the runner: -m, then a double-quoted string, a single-quoted string or a bare word (group 3), or -m glued to a bare word (group 4).
re_marker="(^|[[:space:]])-m([[:space:]]+(\"[^\"]*\"|'[^']*'|[^[:space:]\"']+)|([^[:space:]\"'-][^[:space:]\"']*))"
cmd="${cmd//>&/$ph1}"; cmd="${cmd//&>/$ph2}"   # keep 2>&1 and &> out of the separator split

# Hidden test waits are denied, not rewritten: a known runner inside an until/while loop, or a test run
# whose stdout goes to /dev/null, makes a hung run look like a slow one. The way is `sl run_tests --wait`.
# Known runners only, at command position, so `until curl ...` or `until [ -f .../vitest ]` pass.
sp='[[:space:]]'
re_env="([A-Za-z_][A-Za-z_0-9]*=[^[:space:]]*$sp+)*"
re_uv="((uv|poetry|pipenv|pdm|hatch)${sp}+run${sp}+)?"
re_core="(((python[0-9.]*|py)(${sp}+-[0-9]+)?${sp}+-m${sp}+)?(pytest|py\.test|unittest)|((npx|pnpx|bunx|yarn|pnpm(${sp}+(exec|dlx))?|npm${sp}+exec|bun${sp}+x)${sp}+(-[-A-Za-z]+${sp}+)*)?(vitest|jest|mocha)|(npm|pnpm|yarn|bun)${sp}+(run${sp}+)?test|(go|cargo|dotnet)${sp}+test|(bundle${sp}+exec${sp}+)?rspec|(mvn|mvnw|\./mvnw|gradle|gradlew|\./gradlew)${sp}+(-[^[:space:]]+${sp}+)*(clean${sp}+)?test)"
re_known="^$sp*(![[:space:]]*)?$re_env$re_uv$re_core($sp|\$|[;&|)])"
re_loop="(^|[^[:alnum:]_.-])(until|while)$sp"
re_in_loop="(^|[;&|({]|(^|$sp)(until|while|do|then|elif|if))$sp*(!$sp*)?$re_env$re_uv$re_core($sp|\$|[;&|)])"
re_null="(^|[^0-9])(>>?|$ph2>?)$sp*(/dev/null|[Nn][Uu][Ll])([^[:alnum:]_./]|\$)|(^|$sp)1>>?$sp*(/dev/null|[Nn][Uu][Ll])([^[:alnum:]_./]|\$)"

# The project's own test command (.superlite/test-cmd.json "test", "test_file"): its leading words up to the
# first flag, placeholder or quote (two words or a path, no glob characters) count as a known runner. In a linked
# worktree without its own file, the main checkout's is used (as testcmd.py does): the worktree's `.git` file names
# `<main>/.git/worktrees/<name>`.
pp=(); tcj=""
test_cmd_file() {
  local g
  REPLY="$sd/test-cmd.json"
  [ -f "$REPLY" ] && return 0
  REPLY=""
  [ -n "${SL_PROJ:-}" ] || return 0
  _sl_line "$SL_PROJ/.git"
  g="${SL_LINE#gitdir: }"
  case "$g" in *"/.git/worktrees/"*) ;; *) return 0 ;; esac
  g="${g//\\//}"
  case "$g" in /*|?:/*) ;; *) g="$SL_PROJ/$g" ;; esac
  [ -f "${g%/.git/worktrees/*}/.superlite/test-cmd.json" ] && REPLY="${g%/.git/worktrees/*}/.superlite/test-cmd.json"
  return 0
}
load_project_runner() {
  local w words key re f n p
  test_cmd_file; f="$REPLY"
  [ -n "$f" ] || return 0
  read -r -d '' tcj < "$f"
  for key in test test_file; do
    re='"'"$key"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
    [[ $tcj =~ $re ]] || continue
    read -r -a words <<< "${BASH_REMATCH[1]}"
    p=""; n=0
    for w in "${words[@]}"; do
      case "$w" in -*|*"{"*|*=*|*'"'*|*"'"*|*'$'*|*'\'*|*'*'*|*'?'*|*'['*) break ;; esac
      p="${p:+$p }$w"; n=$((n+1))
    done
    if [ "$n" -ge 2 ] || { [ "$n" = 1 ] && [[ $p == */* ]]; }; then pp+=("$p"); fi
  done
}
# isolate_stack: 0 when test-cmd.json names a compiled stack whose runs need their own tree (an explicit
# "isolate": true|false wins over "language" swift, go, rust, csharp, as in testcmd.py).
isolate_stack() {
  local re='"isolate"[[:space:]]*:[[:space:]]*(true|false)'
  if [[ $tcj =~ $re ]]; then [ "${BASH_REMATCH[1]}" = true ]; return; fi
  re='"language"[[:space:]]*:[[:space:]]*"(swift|go|rust|csharp)"'
  [[ $tcj =~ $re ]]
}
# current_task ID: the first task of pool.json agent ID's `current` ("T3", "T5,T6" or a list) into REPLY (empty if unknown).
current_task() {
  local pool re rest
  REPLY=""
  [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]] && [ -f "$sd/pool.json" ] || return 0
  read -r -d '' pool < "$sd/pool.json"
  re='"id"[[:space:]]*:[[:space:]]*"'"$1"'"'
  [[ $pool =~ $re ]] || return 0
  rest="${pool#*"${BASH_REMATCH[0]}"}"
  rest="${rest%%\}*}"   # this agent's fields only: the object has no nested braces
  re='"current"[[:space:]]*:[[:space:]]*\[?[[:space:]]*"([^",]*)'
  [[ $rest =~ $re ]] || return 0
  rest="${BASH_REMATCH[1]}"   # a second match would overwrite BASH_REMATCH
  [[ $rest =~ ^[A-Za-z0-9_.-]+$ ]] && REPLY="$rest"
  return 0
}
# project_hit TEXT MODE: 0 when TEXT holds a project runner (MODE seg: at its start; loop: at any command position).
project_hit() {
  local p t pat
  for p in "${pp[@]}"; do
    if [ "$2" = seg ]; then
      t="${1#"${1%%[![:space:]]*}"}"
      [[ "$t " == "$p "* ]] && return 0
    else
      pat=$'*[[:space:];&|(!]'"$p"$'[[:space:];&|)]*'
      [[ " $1 " == $pat ]] && return 0
    fi
  done
  return 1
}
deny() {
  local t="${cmd:0:400}"; t="${t//[\"\\$'\n\r\t']/ }"
  t="${t//$ph1/>&}"; t="${t//$ph2/&>}"
  printf '{"kind":"rule-block","agent":"coordinator","tool":"Bash","target":"hidden test wait: %s","rule":"hidden-test-wait","cwd":"%s"}\n' "$t" "$cwdv" \
    >> "$sd/incidents.jsonl" 2>/dev/null
  printf '%s\n' \
    'Blocked: never wait on tests through a loop, and never hide a test run'"'"'s output (an until/while around a test runner, or a test run sent to /dev/null): a hung run then looks like a slow one, and the loop bypasses the test wrapper.' \
    'Start the run with `sl run_tests --full --background` (focused: `sl run_tests --fast <file>`), then wait with `sl run_tests --wait`.' >&2
  exit 2
}
deny_subagent_full() {
  local t="${cmd:0:400}"; t="${t//[\"\\$'\n\r\t']/ }"
  printf '{"kind":"rule-block","agent":"subagent","tool":"Bash","target":"full suite: %s","rule":"subagent-full-suite","cwd":"%s"}\n' "$t" "$cwdv" \
    >> "$sd/incidents.jsonl" 2>/dev/null
  printf '%s\n' \
    'Blocked: subagents must not run the full test suite during a superlite run.' \
    'Use `sl run_tests --fast <files>` for focused tests; the whole suite runs only as `sl run_tests --full`.' >&2
  exit 2
}

deny_isolate() {
  local t="${cmd:0:400}" task="$1"; t="${t//[\"\\$'\n\r\t']/ }"
  t="${t//$ph1/>&}"; t="${t//$ph2/&>}"
  printf '{"kind":"rule-block","agent":"subagent","tool":"Bash","target":"isolated test run: %s","rule":"isolated-test-run","cwd":"%s"}\n' "$t" "$cwdv" \
    >> "$sd/incidents.jsonl" 2>/dev/null
  printf '%s\n' \
    'Blocked: this project'"'"'s tests build one shared tree, where another agent'"'"'s half-edit breaks the run, so a raw run of its test command is not allowed here.' \
    "Run only your own test files in your task's tree: use $sl_base --fast <test files> --task ${task:-<Tn>} --background"', then `sl run_tests --wait`.' >&2
  exit 2
}

# Subagents and fleet workers (top-level sessions with SUPERLITE_FLEET_WORKER): on an isolate stack deny the project's
# test command; deny a bare full-suite runner; leave everything else untouched.
if [ "$has_agent" = 1 ] || [ -n "$fleet_worker" ]; then
  iso=0
  load_project_runner
  if [ "${#pp[@]}" -gt 0 ] && isolate_stack; then
    iso=1
    if [ "$has_agent" = 1 ]; then jstr agent_id; else REPLY="$fleet_worker"; fi
    current_task "$REPLY"; iso_task="$REPLY"
  fi
  _dq='"'; _sq="'"
  _rest="$cmd"; _last=0
  dir_start
  while :; do
    if [[ $_rest =~ $re_seg ]]; then _seg="${BASH_REMATCH[1]}"; _rest="${BASH_REMATCH[3]}"; _last=0
    else _seg="$_rest"; _last=1; fi
    _q="${_seg//[^\"]/}"; _q2="${_seg//[^\']/}"
    if [ $(( ${#_q} % 2 )) = 1 ] || [ $(( ${#_q2} % 2 )) = 1 ]; then exit 0; fi   # quote spans a separator
    dir_step "$_seg"
    if ! seg_out "$_seg"; then   # a run outside the plan root is not ours to judge
      [ "$iso" = 1 ] && project_hit "$_seg" seg && deny_isolate "$iso_task"
      if [[ $_seg =~ $re_test ]]; then
        files_from_seg "$_seg"
        if [ -z "$REPLY" ]; then   # a quoted path ("my test.py") is a path; a quoted flag value (-m "not slow") is not
          _nq=${_seg//[$_dq$_sq]/}
          files_from_seg "$_nq"
        fi
        [ -z "$REPLY" ] && ! [[ $_seg =~ $re_co ]] && deny_subagent_full
      fi
    fi
    [ "$_last" = 1 ] && break
  done
  exit 0
fi

case "$cmd" in *until*|*while*|*null*|*[Nn][Uu][Ll]*) hid=1 ;; *) hid=0 ;; esac
if [ "$hid" = 1 ]; then
  load_project_runner
  # Quoted text (commit messages, echo arguments) is not a command: blank it before the loop scan.
  scan="$cmd"; unq=""; re_quoted='^([^"'"'"']*)("[^"]*"|'"'"'[^'"'"']*'"'"')(.*)$'
  while [[ $scan =~ $re_quoted ]]; do unq="$unq${BASH_REMATCH[1]}Q"; scan="${BASH_REMATCH[3]}"; done
  unq="$unq$scan"
  if [[ $unq =~ $re_loop ]]; then
    any_out=0; dir_start; _rest="$cmd"
    while :; do   # does any segment run outside the plan root?
      if [[ $_rest =~ $re_seg ]]; then _seg="${BASH_REMATCH[1]}"; _rest="${BASH_REMATCH[3]}"; _last=0
      else _seg="$_rest"; _last=1; fi
      dir_step "$_seg"
      seg_out "$_seg" && any_out=1
      [ "$_last" = 1 ] && break
    done
    if [ "$any_out" = 0 ]; then
      [[ $unq =~ $re_in_loop ]] && deny
      [ "${#pp[@]}" -gt 0 ] && project_hit "$unq" loop && deny
    fi
  fi
fi

out=""; rest="$cmd"; changed=0; used_fast=0
dir_start
while :; do
  if [[ $rest =~ $re_seg ]]; then seg="${BASH_REMATCH[1]}"; sep="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"; last=0
  else seg="$rest"; sep=""; last=1; fi
  q="${seg//[^\"]/}"; q2="${seg//[^\']/}"
  dir_step "$seg"
  if seg_out "$seg"; then   # outside the plan root: copied as written, never denied
    if [ $(( ${#q} % 2 )) = 1 ] || [ $(( ${#q2} % 2 )) = 1 ]; then exit 0; fi   # quote spans a separator
    out="$out$seg"
  else
    if [ "$hid" = 1 ] && [[ $seg =~ $re_null ]]; then   # a known runner with stdout sent to /dev/null
      if [[ $seg =~ $re_known ]]; then deny; fi
      if [ "${#pp[@]}" -gt 0 ] && project_hit "$seg" seg; then deny; fi
    fi
    if [ $(( ${#q} % 2 )) = 1 ] || [ $(( ${#q2} % 2 )) = 1 ]; then exit 0; fi   # quote spans a separator
    if [[ $seg =~ $re_test ]] && ! [[ $seg =~ $re_co ]]; then
      mk=""; work="$seg"
      [[ $seg =~ $re_test ]]   # the re_co test above replaced BASH_REMATCH
      pre="${BASH_REMATCH[0]}"
      if [[ $pre =~ (pytest|py\.test)[[:space:]]*$ ]]; then   # a pytest segment: lift -m EXPR out of the text after the runner
        post="${seg#"$pre"}"
        if [[ $post =~ $re_marker ]]; then
          mfull="${BASH_REMATCH[0]}"
          if [ -n "${BASH_REMATCH[3]}" ]; then mk="${BASH_REMATCH[3]}"; else mk="${BASH_REMATCH[4]}"; fi
          work="$pre${post%%"$mfull"*} ${post#*"$mfull"}"
        fi
      fi
      case "$work" in *'"'*|*"'"*) exit 0 ;; esac   # quoted test arguments: leave the command unchanged
      files_from_seg "$work"
      if [ -n "$REPLY" ]; then out="$out $sl_base --fast $REPLY${mk:+ -m $mk} "; used_fast=1
      else out="$out $sl${mk:+ -m $mk} "; fi
      changed=1
    else out="$out$seg"; fi
  fi
  out="$out$sep"
  [ "$last" = 1 ] && break
done
[ "$changed" = 1 ] || exit 0

out="${out//$ph1/>&}"; out="${out//$ph2/&>}"
# The rule-rewrite row: original and rewritten command (control characters become spaces, 200 characters at most), rule, cwd.
orig="${cmd//$ph1/>&}"; orig="${orig//$ph2/&>}"; orig="${orig//[[:cntrl:]]/ }"; orig="${orig:0:200}"
short="${out//"bash \"$root/skills/subagent-driven-development/scripts/sl\""/sl}"
short="${short//[[:cntrl:]]/ }"; short="${short#"${short%%[![:space:]]*}"}"; short="${short%"${short##*[![:space:]]}"}"; short="${short:0:200}"
esc orig; esc short
printf '{"kind":"rule-rewrite","agent":"coordinator","tool":"Bash","target":"%s -> %s","rule":"raw-test-run","cwd":"%s","command":"%s","rewritten":"%s"}\n' \
  "$orig" "$short" "$cwdv" "$orig" "$short" >> "$sd/incidents.jsonl" 2>/dev/null

esc out
if [ "$used_fast" = 1 ]; then mode=fast; else mode=full; fi
printf '%s' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":"'"$out"'","run_in_background":true,"description":"sl run_tests --'"$mode"' (rewritten from a raw test run)"},"additionalContext":"raw test run rewritten to a background sl run_tests --'"$mode"'; its result arrives as a notification and in .superlite/test-summary.json; use `sl run_tests --wait` only at the final gate"}}'
printf '\n'
exit 0
