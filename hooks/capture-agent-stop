#!/usr/bin/env bash
# SubagentStop hook: during an active superlite run, append one stop record to
# <project>/.superlite/metrics.jsonl:
#   {"ev":"stop","t":<epoch ms>,"agent_id":..,"type":..,"transcript":<path, forward slashes>,"last":<max 160 chars>}
# Active when .superlite/stable.json, prime.md or pool.json exists under the project dir; a superlite:final-reviewer stop is
# recorded even without a run (the folder is created).
# Bash builtins only (each external process costs ~250 ms on Windows). Never blocks: always exits 0.

IFS= read -r -d '' input   # builtin; returns 1 at EOF, which is fine

# jstr KEY: first JSON string value for KEY, decoded, into REPLY (empty if absent).
jstr() {
  local re='"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' s
  REPLY=""
  [[ $input =~ $re ]] || return 0
  s="${BASH_REMATCH[1]}"
  s="${s//\\\\/$'\x01'}"; s="${s//\\\"/\"}"; s="${s//\\n/ }"; s="${s//\\r/}"; s="${s//\\t/ }"; s="${s//\\\//\/}"
  REPLY="${s//$'\x01'/\\}"
}
# esc VAR: JSON-escape the string in VAR.
esc() {
  local s="${!1}"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/ }"; s="${s//$'\r'/}"; s="${s//$'\t'/ }"
  printf -v "$1" '%s' "$s"
}

. "${BASH_SOURCE[0]%/*}/superlite-state.sh" 2>/dev/null || exit 0
superlite_state || exit 0
sd="$SL_SD"
jstr agent_type; type="$REPLY"
if [ -f "$sd/stable.json" ] || [ -f "$sd/prime.md" ] || [ -f "$sd/pool.json" ]; then :
elif [ "$type" = "superlite:final-reviewer" ]; then [ -d "$sd" ] || { mkdir -p "$sd" 2>/dev/null || exit 0; [ -n "$SL_PROJ" ] && [ "$sd" = "$SL_PROJ/.superlite" ] && _sl_exclude "$SL_PROJ"; }   # recorded outside a run too (final-review-check)
else exit 0; fi

jstr agent_id; id="$REPLY"
jstr agent_transcript_path; tr="${REPLY//\\//}"
jstr last_assistant_message; last="${REPLY:0:160}"
esc id; esc type; esc tr; esc last

now="${EPOCHREALTIME//[.,]/}"; now="${now%???}"   # epoch ms
# bash 3.2 (stock macOS) has no EPOCHREALTIME: date's %N (GNU, newer macOS), else perl, else whole seconds.
[[ $now =~ ^[0-9]{13,}$ ]] || { now="$(date +%s%N)"; now="${now%??????}"; }
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000' 2>/dev/null)"
[[ $now =~ ^[0-9]{13,}$ ]] || now="$(date +%s)000"
printf '{"ev":"stop","t":%s,"agent_id":"%s","type":"%s","transcript":"%s","last":"%s"}\n' \
  "$now" "$id" "$type" "$tr" "$last" >> "$sd/metrics.jsonl" 2>/dev/null
exit 0
