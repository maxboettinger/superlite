#!/usr/bin/env python3
"""Fake `remote_room` command for tests: prints $FAKE_ROOM_JSON, exits $FAKE_ROOM_EXIT (default 0), logs each run to $FAKE_ROOM_LOG."""
import os, sys

log = os.environ.get("FAKE_ROOM_LOG")
if log:
    with open(log, "a") as f:
        f.write("run\n")
print(os.environ.get("FAKE_ROOM_JSON", ""))
sys.exit(int(os.environ.get("FAKE_ROOM_EXIT", "0")))
