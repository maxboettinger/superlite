#!/usr/bin/env python3
"""Fake herdr CLI for tests: logs argv, prints canned JSON (or $FAKE_HERDR_REPLY).

Mirrors herdr 0.9.5: errors are JSON on stderr with a non-zero exit, agent names must match NAME,
`agent list` carries no `name` for an agent nobody named, and `agent prompt --timeout` needs `--wait`.
$FAKE_HERDR_FAIL="agent wait" (a two-word command) makes that command fail with an error JSON."""
import json, os, re, sys

NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")

a = sys.argv[1:]
log = os.environ.get("FAKE_HERDR_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(a) + "\n")
if a[:2] == ["agent", "prompt"] and "--timeout" in a and "--wait" not in a:
    sys.stderr.write("--timeout requires --wait\n")
    sys.exit(2)
if os.environ.get("FAKE_HERDR_FAIL") == " ".join(a[:2]):
    sys.stderr.write(json.dumps({"error": {"code": "agent_not_found", "message": "agent target not found"}}))
    sys.exit(1)
reply = os.environ.get("FAKE_HERDR_REPLY")
if reply is not None:
    if reply.startswith("EXIT "):
        parts = reply.split(" ", 2)
        rest = parts[2] if len(parts) > 2 else ""
        sys.stderr.write(rest)
        sys.exit(int(parts[1]))
    print(reply)
    sys.exit(0)
key = " ".join(a[:2])
if key == "workspace create":
    out = {"id": "x", "result": {"type": "workspace_created", "workspace": {"workspace_id": "w6"}, "root_pane": {"pane_id": "w6:p1"}}}
elif key == "tab create":
    out = {"result": {"type": "tab_created", "tab": {"tab_id": "w6:t2", "workspace_id": "w6"}, "root_pane": {"pane_id": "w6:p5"}}}
elif key == "pane layout":
    out = {"result": {"type": "pane_layout", "layout": {"area": {"height": 64, "width": 147, "x": 0, "y": 0}, "panes": [
        {"pane_id": "w6:p1", "focused": False, "rect": {"height": 64, "width": 73, "x": 0, "y": 0}},
        {"pane_id": "w6:p2", "focused": False, "rect": {"height": 64, "width": 73, "x": 74, "y": 0}}], "splits": [], "tab_id": "w6:t1", "workspace_id": "w6", "zoomed": False}}}
elif key == "pane rename":
    out = {"id": "cli:pane:rename", "result": {"pane": {"pane_id": a[2], "label": a[3]}}}
elif key == "pane split":
    out = {"result": {"pane": {"pane_id": "w6:p2"}}}
elif key == "agent start" and not NAME.fullmatch(a[2]):
    sys.stderr.write(json.dumps({"error": {"code": "invalid_agent_name", "message": "agent name must start with a lowercase letter"}, "id": "cli:agent:start"}))
    sys.exit(1)
elif key == "agent start":
    out = {"result": {"agent": {"agent_status": "idle"}}}
elif key == "agent get":
    out = {"result": {"agent": {"agent_status": "idle", "name": a[2]}}}
elif key == "agent list":
    out = {"result": {"agents": [{"agent_status": "working", "pane_id": "w5:p1"}, {"name": "sl-proj-w1", "agent_status": "done", "pane_id": "w6:p1", "cwd": "/u/proj"}, {"name": "sl-proj-w2", "agent_status": "working", "pane_id": "w6:p2", "cwd": "/u/proj"}]}}
elif key == "agent read":
    print("line one\nline two\nYes, I trust this folder\nREADY")
    sys.exit(0)
elif key in ("agent prompt", "agent wait"):
    st = a[a.index("--until") + 1] if "--until" in a else "idle"
    out = {"result": {"agent": {"agent_status": st}}}
else:
    out = {"result": {"type": "ok"}}
print(json.dumps(out))
